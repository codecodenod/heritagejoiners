---
/**
 * ServiceLayout - wrapper for service pages
 */
import BaseLayout from './BaseLayout.astro';
import BreadcrumbSchema from '../components/schema/Breadcrumb.astro';
import ServiceSchema from '../components/schema/Service.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  serviceName: string;
  breadcrumbs: Array<{ name: string; url: string }>;
  schemaProps?: {
    description: string;
    url: string;
    image?: string;
    priceRange?: string;
  };
}

const props = Astro.props;
const { title, description, serviceName, breadcrumbs, schemaProps } = props;
const { url } = siteConfig;

const breadcrumbItems = [
  { name: 'Home', url: `${url}/` },
  { name: 'Services', url: `${url}/services` },
  ...breadcrumbs,
];
---

<BaseLayout title={title} description={description}>
  <slot name="schema">
    {schemaProps && <ServiceSchema name={serviceName} {...schemaProps} />}
  </slot>
  <BreadcrumbSchema items={breadcrumbItems} />
  <slot />
</BaseLayout>
