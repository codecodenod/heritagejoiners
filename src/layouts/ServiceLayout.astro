---
/**
 * ServiceLayout - wrapper for service pages
 */
import BaseLayout from './BaseLayout.astro';
import BreadcrumbSchema from '../components/schema/Breadcrumb.astro';
import ServiceSchema from '../components/schema/Service.astro';
import AreaLinks from '../components/sections/AreaLinks.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  serviceName: string;
  breadcrumbs: Array<{ name: string; url: string }>;
  schemaProps?: {
    description: string;
    url: string;
    image?: string;
    priceRange?: string;
    serviceType?: string;
    category?: string;
    areaServed?: Array<string | { '@type': string; name: string }>;
  };
  canonical?: string;
  ogImage?: string;
}

const props = Astro.props;
const { title, description, serviceName, breadcrumbs, schemaProps, canonical, ogImage } = props;
const { url } = siteConfig;

const breadcrumbItems = [
  { name: 'Home', url: `${url}/` },
  { name: 'Services', url: `${url}/services` },
  ...breadcrumbs,
];
---

<BaseLayout title={title} description={description} canonical={canonical || schemaProps?.url} ogImage={ogImage || schemaProps?.image}>
  {schemaProps && <ServiceSchema name={serviceName} {...schemaProps} />}
  <slot name="schema" />
  <BreadcrumbSchema items={breadcrumbItems} />
  <slot />
  <AreaLinks />
</BaseLayout>
