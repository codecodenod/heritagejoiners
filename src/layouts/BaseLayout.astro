---
/**
 * BaseLayout - foundation for all pages
 */
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/components.css';
import { siteConfig } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import OrganizationSchema from '../components/schema/Organization.astro';
import LocalBusinessSchema from '../components/schema/LocalBusiness.astro';
import WebSiteSchema from '../components/schema/WebSite.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: 'organization' | 'localbusiness' | 'none';
}

const props = Astro.props;

const {
  title,
  description = 'Joiner and carpenter in Pontefract, Wakefield and West Yorkshire — kitchens, doors, windows, stairs, flooring and heritage timber repair by Heritage Joiners.',
  canonical,
  ogImage: pageOgImage,
  noindex = false,
  schema = 'localbusiness',
} = props;

const { url, plausible } = siteConfig;
const cleanTitle = title
  ?.replace(/\s*\|\s*Heritage Joiners(?:\s+(?:Pontefract|Yorkshire))?\s*$/i, '')
  .trim();
const siteTitle = cleanTitle ? `${cleanTitle} | Heritage Joiners` : 'Heritage Joiners';

const routePath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');

const canonicalUrl = canonical
  ? new URL(canonical, url)
  : new URL(routePath || '/', url);
canonicalUrl.search = '';
canonicalUrl.hash = '';
const fullCanonical = canonicalUrl.toString().replace(/\/$/, canonicalUrl.pathname === '/' ? '/' : '');

// OG image
const ogImage = pageOgImage ? new URL(pageOgImage, url).toString() : `${url}/images/heritage-joiners-social-card-v2.jpg`;
const twitterCard = 'summary_large_image';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) — GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G5BC6EPE36"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-G5BC6EPE36');
    </script>

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1a1a" />


    <!-- Canonical -->
    <link rel="canonical" href={fullCanonical} />

    <!-- Title -->
    <title>{siteTitle}</title>

    <!-- Description -->
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Heritage Joiners" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Plausible analytics -->
    {plausible.domain && (
      <script
        defer
        data-domain={plausible.domain}
        src={`https://plausible.io/js/script.js`}
      ></script>
    )}

    <!-- Schema -->
    <WebSiteSchema />
    {schema === 'organization' && <OrganizationSchema />}
    {schema === 'localbusiness' && <LocalBusinessSchema />}
  </head>
  <body class="min-h-screen flex flex-col bg-bone text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal (site-wide): fade section content in as it enters the
      // viewport. Progressive enhancement — the classes are added here, so
      // without JS nothing is ever hidden. The first section on each page
      // (the hero / LCP) is left static so paint metrics are unaffected, and
      // we fade each section's inner container rather than the section itself
      // so background colours stay put and fixed-attachment parallax
      // backgrounds aren't broken by transforms.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        document.querySelectorAll('main section').forEach((s, i) => {
          if (i === 0 || s.classList.contains('hero-carousel')) return;
          const target = s.querySelector(':scope > div.relative') || s.firstElementChild;
          if (target) target.classList.add('reveal');
        });
        const revealIo = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              revealIo.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -80px 0px' });
        document.querySelectorAll('.reveal').forEach((el) => revealIo.observe(el));
      }
    </script>
  </body>
</html>
