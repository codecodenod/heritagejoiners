---
/**
 * BaseLayout - foundation for all pages
 */
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/components.css';
import { siteConfig } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import OrganizationSchema from '../components/schema/Organization.astro';
import LocalBusinessSchema from '../components/schema/LocalBusiness.astro';
import WebSiteSchema from '../components/schema/WebSite.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: 'organization' | 'localbusiness' | 'none';
}

const props = Astro.props;

const {
  title,
  description = 'Heritage Joiners — specialist timber window and door repair for listed and period properties across Yorkshire. 35+ years listed-building expertise. Repair-first approach.',
  canonical,
  ogImage: pageOgImage,
  noindex = false,
  schema = 'localbusiness',
} = props;

const { url, plausible } = siteConfig;
const cleanTitle = title
  ?.replace(/\s*\|\s*Heritage Joiners(?:\s+(?:Pontefract|Yorkshire))?\s*$/i, '')
  .trim();
const siteTitle = cleanTitle ? `${cleanTitle} | Heritage Joiners` : 'Heritage Joiners';

const routePath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');

const canonicalUrl = canonical
  ? new URL(canonical, url)
  : new URL(routePath || '/', url);
canonicalUrl.search = '';
canonicalUrl.hash = '';
const fullCanonical = canonicalUrl.toString().replace(/\/$/, canonicalUrl.pathname === '/' ? '/' : '');

// OG image
const ogImage = pageOgImage ? new URL(pageOgImage, url).toString() : `${url}/images/homepage/hero.webp`;
const twitterCard = 'summary_large_image';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />


    <!-- Canonical -->
    <link rel="canonical" href={fullCanonical} />

    <!-- Title -->
    <title>{siteTitle}</title>

    <!-- Description -->
    <meta name="description" content={description} />

    <!-- Robots: site-wide noindex while in test/staging -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Heritage Joiners" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Plausible analytics -->
    {plausible.domain && (
      <script
        defer
        data-domain={plausible.domain}
        src={`https://plausible.io/js/script.js`}
      ></script>
    )}

    <!-- Schema -->
    <WebSiteSchema />
    {schema === 'organization' && <OrganizationSchema />}
    {schema === 'localbusiness' && <LocalBusinessSchema />}
  </head>
  <body class="min-h-screen flex flex-col bg-bone text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
