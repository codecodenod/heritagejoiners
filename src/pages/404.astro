---
/**
 * 404 page
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

const { pathname } = Astro.url;
---

<BaseLayout title="Page Not Found" noindex>
  <section class="py-20 lg:py-32 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-6xl lg:text-8xl text-ink mb-4">404</h1>
      <p class="text-xl text-ink/70 mb-8">
        The page "{pathname}" wasn't found.
      </p>
      <p class="text-bone/60 mb-12">
        It may have been moved or doesn't exist.
      </p>
      <Button href="/" variant="primary">Return home</Button>
    </div>
  </section>
</BaseLayout>