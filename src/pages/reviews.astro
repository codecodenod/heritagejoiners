---
/**
 * Reviews - leave a review (Google first, then Facebook)
 * Real customer reviews will be added below the buttons as they arrive.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const { url, social } = siteConfig;

// Direct review link from Rob's Google Business Profile — opens the review box immediately
const googleReviewUrl = 'https://g.page/r/CfrLE3bpw7zmEBM/review';
const googleReviewsUrl = 'https://www.google.com/maps/place/?q=place_id:ChIJpQJcXBn4m4kR-ssTdunDvOY';
const facebookReviewUrl = `${social.facebook}reviews`;

// Genuine Google reviews, reproduced verbatim. Add new ones here as they arrive.
const reviews = [
  {
    name: 'Julie Marshall',
    rating: 5,
    source: 'Google',
    job: 'Kitchen strip-out and refit',
    text: 'I can personally recommend Rob todo a good quality job. He removed a full kitchen to enable an essential damp course be completed. Rob then refitted the kitchen replacing all worktops to give the kitchen a fresh new look. Rob also replaced skirting boards to all rooms. Reliable tradesman turned up on time.',
  },
  {
    name: 'Claire Marsh',
    rating: 5,
    source: 'Google',
    job: 'Side gate',
    text: 'Rob did my gate at the side of my house excellent work man ship . Excellent quality gate I will be using him again for woodwork on my house .',
  },
  {
    name: 'David Arundel',
    rating: 5,
    source: 'Google',
    job: 'Garden gate, driveway repair and summerhouse window',
    // Paragraph breaks are the reviewer's own; wording is untouched.
    text: [
      'Have used Rob on several occasions. Always been pleased with his work.',
      'Rob is always prompt, professional, communicates well, goes beyond the call of duty and is competitively priced.',
      'Project 1: I needed a new garden gate. Rob uplifted the existing flagstones, made the gate from scratch, installed the gate and concrete pillars, re-set the flagstones and filled in the mortar. Very pleased with the result.',
      'Project 2: Had two annoying potholes in the drive. Rob removed all loose debris, cut out the shape to be filled, filled the potholes, smoothed them over and sealed them tight. Potholes have never come back!',
      'Project 3: Had a rotting window frame on my summerhouse. Other joiners had let me down. Rob removed the window frame, fitted a new window complete with safety glass panels, and ensured it matched the existing style of the other windows. Impressed beyond words & never been happier!',
      'Will be using him again in the future & can thoroughly recommend Rob for those jobs that need doing.',
    ].join('\n\n'),
  },
];

const reviewCount = reviews.length;
const averageRating = (reviews.reduce((sum, r) => sum + r.rating, 0) / reviewCount).toFixed(1);

const description =
  'Had joinery or carpentry work done by Heritage Joiners? Leave a review on Google or Facebook — honest feedback from real jobs in Pontefract and West Yorkshire.';
---

<BaseLayout title="Reviews" description={description} canonical={`${url}/reviews`}>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Reviews</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Leave Heritage Joiners a Review</h1>
        <p class="text-lg text-ink/70">
          If Rob has done a job for you, a short honest review takes a minute and helps a lot.
          Google is where reviews help most.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Where to leave your review</h2>
      <p class="text-ink/70 mb-8">
        A line or two is all it needs — say what the job was, where it was, and how it went.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={googleReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 bg-oak text-bone font-display rounded-md hover:bg-oak/90 transition-colors"
        >
          Review us on Google
        </a>
        <a
          href={facebookReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 bg-bone text-ink font-display border border-ink rounded-md hover:bg-paper transition-colors"
        >
          Review us on Facebook
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-3">What customers say</h2>
        <p class="text-ink/70">
          <span class="text-oak" aria-hidden="true">★★★★★</span>
          Rated {averageRating} from {reviewCount} reviews on Google
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {reviews.map((review) => (
          <article class="bg-bone rounded-lg border border-ink/10 p-6 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="text-lg" aria-label={`${review.rating} out of 5 stars`}>
                <span class="text-oak">{'★'.repeat(review.rating)}</span><span class="text-ink/20">{'★'.repeat(5 - review.rating)}</span>
              </span>
              <span class="text-xs text-ink/50 font-display uppercase tracking-wide">via {review.source}</span>
            </div>
            <div class="mb-4 space-y-3">
              {review.text.split('\n\n').map((paragraph) => (
                <p class="text-ink/80 leading-relaxed">{paragraph}</p>
              ))}
            </div>
            <div class="mt-auto pt-3 border-t border-ink/10">
              <p class="font-display text-ink">{review.name}</p>
              <p class="text-sm text-ink/60">{review.job}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="text-oak font-display">
          Read all our reviews on Google &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
