---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import PhoneLink from '../../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../../components/ui/WhatsAppCTA.astro';
import { siteConfig } from '../../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [
  { name: 'The Counting House', url: `${url}/case-studies/counting-house` },
  { name: 'Oak Frames, Boxing-ins & Interior Details', url: `${url}/case-studies/counting-house/oak-frames-and-joinery` },
];

const articleProps = {
  headline: 'The Counting House — Oak Frames, Boxing-ins & Interior Details',
  url: `${url}/case-studies/counting-house/oak-frames-and-joinery`,
  datePublished: '2024-01-01',
};

const base = '/images/case-studies/counting-house';

// Alternating text/image feature rows
const features = [
  {
    title: 'Frames, boxing-ins and reused timber',
    body: [
      'Oak was machined to size and worked around windows, frames, toilet areas, boxing-ins and other junctions, so the service spaces still felt part of the same heritage scheme. Each piece had to be practical, neat and in keeping with the old building around it.',
      'Where a piece of original timber could be reused, it was. A salvaged panelled door was repurposed as the front of a bespoke boxed-in cupboard — old character kept in the building rather than thrown away.',
    ],
    images: [
      { src: `${base}/the-counting-house-salvaged-panel-door-cupboard.webp`, alt: 'Salvaged Victorian panelled door repurposed as a bespoke boxed-in cupboard front at The Counting House', portrait: true, width: 563, height: 1000 },
    ],
  },
  {
    title: 'Old oak, new oak and rustic detail',
    body: [
      'A sawn, rustic finish was chosen for much of the oak, so new work sat naturally against the old fabric rather than looking too clean or too flat. New oak was machined accurately, then judged against reused oak and existing timber so the finished detail felt believable — colour, grain and edge sharpness all mattered.',
      'Where it suited the room, oak was also shaped and moulded: near the bar stair, a newel and post detail was fluted and given an ogee-style moulding, a small decorative lift that kept the piece in the building’s traditional language.',
    ],
    images: [
      { src: `${base}/the-counting-house-rustic-sawn-oak-boarding.webp`, alt: 'Rustic sawn-finish oak boarding used for boxing-ins and detailing at The Counting House', portrait: false, width: 1100, height: 930 },
    ],
  },
  {
    title: 'New oak against original fabric',
    body: [
      'The finished interior is a mix of new oak, reused oak and original fabric — stone-flagged floors, exposed brick and old timber all sitting together.',
      'Good interior joinery in a building like this is not about making everything shout. It is about line, fit, proportion and finish, so the oak looks considered and settled against centuries-old surroundings rather than added late.',
    ],
    images: [
      { src: `${base}/the-counting-house-original-stone-flagged-floor.webp`, alt: 'Original stone-flagged floor and exposed brick with oak detailing at The Counting House', portrait: true, width: 750, height: 1000 },
    ],
  },
];
---

<!-- TODO: Rob to confirm real project dates -->
<CaseStudyLayout
  title="Oak Frames & Joinery — The Counting House"
  description="Oak frames, boxing-ins and interior joinery at The Counting House in Pontefract, including reused timber, rustic sawn oak, and a fluted ogee-style newel detail."
  breadcrumbs={breadcrumbs}
  articleProps={articleProps}
  ogImage="/images/case-studies/counting-house/the-counting-house-oak-interior-boxing-in-window.webp"
>
  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div>
          <p class="text-oak uppercase tracking-wide mb-4">The Counting House — Pontefract</p>
          <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Oak Frames, Boxing-ins &amp; Interior Details</h1>
          <p class="text-xl text-ink/70">
            A large amount of visible oak joinery fitted into the everyday parts of the interior — machined and worked around windows, frames, toilet areas and boxing-ins, with new and old oak brought together by eye and hand.
          </p>
        </div>
        <img
          src={`${base}/the-counting-house-oak-interior-boxing-in-window.webp`}
          alt="Oak boxing-in and panelling around a window in the historic interior of The Counting House, Pontefract"
          width="1080"
          height="1619"
          fetchpriority="high"
          class="w-full h-auto rounded-2xl shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- Alternating rows -->
  <section class="py-16 lg:py-24 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-16 lg:space-y-24">
        {features.map((f, i) => (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">{f.title}</h2>
              {f.body.map((p) => <p class="text-ink/70 mb-3 leading-relaxed">{p}</p>)}
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              {f.images.length === 1 ? (
                f.images[0].portrait ? (
                  <div class="w-full aspect-[4/5] overflow-hidden rounded-xl shadow-lg">
                    <img src={f.images[0].src} alt={f.images[0].alt} width={f.images[0].width} height={f.images[0].height} loading="lazy" class="w-full h-full object-cover" />
                  </div>
                ) : (
                  <img src={f.images[0].src} alt={f.images[0].alt} width={f.images[0].width} height={f.images[0].height} loading="lazy" class="w-full h-auto rounded-xl shadow-lg" />
                )
              ) : (
                <div class="grid grid-cols-2 gap-4">
                  {f.images.map((img) => (
                    <div class="aspect-square overflow-hidden rounded-lg shadow-md">
                      <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" class="w-full h-full object-cover" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap gap-6 pt-16 mt-16 border-t border-ink/10">
        <a href="/case-studies/counting-house" class="text-oak font-display">← Back to Counting House</a>
        <a href="/services/bespoke-joinery" class="text-oak font-display">Bespoke Joinery →</a>
        <a href="/services/second-fix-carpentry" class="text-oak font-display">Second Fix Carpentry →</a>
        <a href="/services/finishing" class="text-oak font-display">Finishing →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need oak interior joinery?</h2>
      <p class="text-ink/70 mb-8 max-w-2xl mx-auto">For oak frames, boxing-ins, feature details or careful matching against older timber, send photos of the room and the junctions involved.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</CaseStudyLayout>
