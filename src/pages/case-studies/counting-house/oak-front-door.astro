---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import PhoneLink from '../../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../../components/ui/WhatsAppCTA.astro';
import { siteConfig } from '../../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [
  { name: 'The Counting House', url: `${url}/case-studies/counting-house` },
  { name: 'Solid Oak Front Door & Frame', url: `${url}/case-studies/counting-house/oak-front-door` },
];

const articleProps = {
  headline: 'The Counting House — Solid Oak Front Door & Frame',
  url: `${url}/case-studies/counting-house/oak-front-door`,
  datePublished: '2024-01-01',
};

const base = '/images/case-studies/counting-house';

// Alternating text/image feature rows
const features = [
  {
    title: 'Selecting the oak',
    body: [
      'The door started at the timber rack. Boards were picked for character, grain and the right thickness — solid oak with the substance to make a heavy, honest door rather than a thin, flat panel.',
      'On a building like The Counting House, the entrance could not feel thin or shopfront-like. Choosing the right stock at the outset is what lets the finished door carry the weight and presence the building deserved.',
    ],
    images: [
      { src: `${base}/the-counting-house-oak-door-timber-selection.webp`, alt: 'Solid oak boards selected for the front door at The Counting House, Pontefract', portrait: false, width: 1100, height: 495 },
    ],
  },
  {
    title: 'Ledged, braced and over 60mm thick',
    body: [
      'The door was made as a heavy ledged and braced oak door, finishing over 60mm thick. It had real weight — enough that lifting and handling it took several people.',
      'That mass was part of the character. The boards, ledges, braces and frame all needed to work together so the finished door felt honest to the building, not decorative for the sake of it.',
    ],
    images: [
      { src: `${base}/the-counting-house-oak-door-ledged-braced-workshop.webp`, alt: 'Solid oak ledged and braced door with live-edge plank, made in the workshop for The Counting House', portrait: true, width: 450, height: 1000 },
    ],
  },
  {
    title: 'Made on the bench, fitted to the building',
    body: [
      'The boards were cramped up and worked on the bench, then the door and its new oak frame were fitted into an old, out-of-square opening that had moved and settled over centuries.',
      'Once hung, it became one of the centrepieces of The Counting House — a strong oak entrance made to look as though it had always belonged, setting the tone before anyone stepped inside.',
    ],
    images: [
      { src: `${base}/the-counting-house-oak-door-boards-cramped-bench.webp`, alt: 'Oak door boards cramped up and set out on the bench for The Counting House', portrait: false, width: 1100, height: 495 },
    ],
  },
];
---

<!-- TODO: Rob to confirm real project dates -->
<CaseStudyLayout
  title="Oak Front Door — The Counting House"
  description="A full solid oak front door and frame replacement at The Counting House in Pontefract, made as a heavy ledged and braced door over 60mm thick."
  breadcrumbs={breadcrumbs}
  articleProps={articleProps}
  ogImage="/images/case-studies/counting-house/the-counting-house-oak-front-door-in-situ.webp"
>
  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-oak uppercase tracking-wide mb-4">The Counting House — Pontefract</p>
      <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Solid Oak Front Door &amp; Frame</h1>
      <p class="text-xl text-ink/70 max-w-2xl mb-10">
        A complete front entrance replacement in solid oak, made as a heavy ledged and braced door and fitted to look as though it had always belonged to the building.
      </p>
      <img
        src={`${base}/the-counting-house-oak-front-door-in-situ.webp`}
        alt="Finished solid oak front door in place at the entrance of The Counting House, Pontefract"
        width="1500"
        height="844"
        fetchpriority="high"
        class="w-full h-auto rounded-2xl shadow-lg"
      />
    </div>
  </section>

  <!-- Alternating rows -->
  <section class="py-16 lg:py-24 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-16 lg:space-y-24">
        {features.map((f, i) => (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">{f.title}</h2>
              {f.body.map((p) => <p class="text-ink/70 mb-3 leading-relaxed">{p}</p>)}
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              {f.images.length === 1 ? (
                f.images[0].portrait ? (
                  <div class="w-full aspect-[4/5] overflow-hidden rounded-xl shadow-lg">
                    <img src={f.images[0].src} alt={f.images[0].alt} width={f.images[0].width} height={f.images[0].height} loading="lazy" class="w-full h-full object-cover" />
                  </div>
                ) : (
                  <img src={f.images[0].src} alt={f.images[0].alt} width={f.images[0].width} height={f.images[0].height} loading="lazy" class="w-full h-auto rounded-xl shadow-lg" />
                )
              ) : (
                <div class="grid grid-cols-2 gap-4">
                  {f.images.map((img) => (
                    <div class="aspect-square overflow-hidden rounded-lg shadow-md">
                      <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" class="w-full h-full object-cover" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap gap-6 pt-16 mt-16 border-t border-ink/10">
        <a href="/case-studies/counting-house" class="text-oak font-display">← Back to Counting House</a>
        <a href="/services/doors" class="text-oak font-display">Doors service →</a>
        <a href="/services/bespoke-joinery" class="text-oak font-display">Bespoke Joinery →</a>
        <a href="/services/timber-hardwoods" class="text-oak font-display">Timber &amp; Hardwoods →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need a solid oak door made?</h2>
      <p class="text-ink/70 mb-8 max-w-2xl mx-auto">For a new oak door, frame or period entrance, send the opening details and photos of the building. Rob will advise on construction, proportion and fitting.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</CaseStudyLayout>
