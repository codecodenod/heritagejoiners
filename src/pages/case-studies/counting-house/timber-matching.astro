---
/**
 * The Counting House - Timber Matching
 */
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { siteConfig } from '../../../config/site';

const { url } = siteConfig;

const breadcrumbs = [
  { name: 'The Counting House', url: `${url}/case-studies/counting-house/` },
  { name: 'Timber Matching', url: `${url}/case-studies/counting-house/timber-matching/` },
];
---

<CaseStudyLayout
  title="Timber Matching - The Counting House"
  description="Period-accurate timber matching at The Counting House - Heritage Joiners case study."
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-oak uppercase tracking-wide mb-4">The Counting House</p>
      <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Timber Matching</h1>
      <p class="text-xl text-ink/70 max-w-2xl">
        Period-accurate timber matching at The Counting House.
      </p>
      <p class="text-ink/80 mt-8">
        Detailed timber matching notes are being prepared. This page will document profile matching, timber selection, and finishing detail.
      </p>
    </div>
  </section>
</CaseStudyLayout>
