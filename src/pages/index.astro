---
/**
 * Homepage
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import PhoneLink from '../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../components/ui/WhatsAppCTA';
import RepairVsReplacement from '../components/sections/RepairVsReplacement.astro';
import { siteConfig } from '../config/site';
import { Phone } from 'lucide-react';

const { phone } = siteConfig;

const icons = {
  craftsmanship: '35-years-hands-on-woodgrain-icon.png',
  repair: 'repair-first-period-building-icon.png',
  location: 'pontefract-based-yorkshire-icon.png',
};
---

<BaseLayout
  title="Joiner Near Me in Pontefract, Wakefield & West Yorkshire"
  description="Joiner and carpenter in Pontefract, Wakefield and West Yorkshire. Carpentry and joinery for kitchens, doors, windows, stairs, roofing, flooring, and heritage timber repair."
>
  <!-- Hero Carousel -->
  <section class="hero-carousel relative overflow-hidden bg-bone" aria-label="Heritage Joiners showcase">
    <!-- Slides -->
    <div class="absolute inset-0">
      <div class="hero-slide is-active" data-slide="0">
        <img
          src="/images/homepage/heritage-joiners-pontefract-logo.webp"
          alt="Heritage Joiners — listed timber repair, Pontefract"
          fetchpriority="high"
          loading="eager"
          width="1920"
          height="1080"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="hero-slide" data-slide="1">
        <img
          src="/images/homepage/listed-timber-splice-repair-yorkshire.webp"
          alt="Hand splice repair on weathered oak — Yorkshire timber joiner"
          loading="lazy"
          width="1920"
          height="1080"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="hero-slide" data-slide="2">
        <img
          src="/images/homepage/restored-sash-window-period-property-pontefract.webp"
          alt="Restored sash window in a Pontefract period property"
          loading="lazy"
          width="1920"
          height="1080"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="hero-slide" data-slide="3">
        <img
          src="/images/homepage/heritage-oak-door-restoration-yorkshire.webp"
          alt="Restored heritage oak door in Yorkshire stone arch"
          loading="lazy"
          width="1920"
          height="1080"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="hero-slide" data-slide="4">
        <img
          src="/images/homepage/timber-joinery-workshop-pontefract.webp"
          alt="Heritage Joiners workshop bench in Pontefract — hand tools and timber repair in progress"
          loading="lazy"
          width="1920"
          height="1080"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Gradient overlay for text legibility -->
    <div class="absolute inset-0 bg-gradient-to-r from-bone via-bone/80 to-transparent pointer-events-none"></div>

    <!-- Persistent content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl lg:text-6xl text-ink mb-6">
          Joiner Near Me in Pontefract, Wakefield &amp; Across West Yorkshire
        </h1>
        <p class="text-lg lg:text-xl text-ink mb-6 max-w-2xl">
          If you are searching for a joiner or carpenter in West Yorkshire, Heritage Joiners provides proper joinery services and carpentry services by Rob, a fully qualified apprentice trained bench hand joiner, time served. Doors, kitchens, stairs, roofs, floors, fitted work and repairs all sit here, with heritage timber work kept as a specialism.
        </p>
        <p class="text-sm lg:text-base text-oak mb-8 font-display uppercase tracking-wide">
          Over 35 years' experience | Workshop-trained and site-proven | No shortcut workmanship
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink
            phone={phone.tel}
            display={phone.display}
            variant="secondary"
          />
        </div>
      </div>
    </div>

    <!-- Pagination dots -->
    <div class="absolute bottom-6 right-6 lg:bottom-10 lg:right-12 z-20 flex gap-3" role="tablist" aria-label="Hero slides">
      <button type="button" class="hero-dot is-active" data-target="0" role="tab" aria-label="Slide 1: Heritage Joiners" aria-selected="true"></button>
      <button type="button" class="hero-dot" data-target="1" role="tab" aria-label="Slide 2: Splice repair" aria-selected="false"></button>
      <button type="button" class="hero-dot" data-target="2" role="tab" aria-label="Slide 3: Restored sash window" aria-selected="false"></button>
      <button type="button" class="hero-dot" data-target="3" role="tab" aria-label="Slide 4: Heritage oak door" aria-selected="false"></button>
      <button type="button" class="hero-dot" data-target="4" role="tab" aria-label="Slide 5: Workshop" aria-selected="false"></button>
    </div>
  </section>

  <style>
    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1.2s ease-in-out;
    }
    .hero-slide.is-active {
      opacity: 1;
    }
    .hero-dot {
      width: 10px;
      height: 10px;
      border-radius: 9999px;
      background: rgba(28, 25, 23, 0.3);
      border: 1px solid rgba(28, 25, 23, 0.5);
      cursor: pointer;
      transition: background 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
      padding: 0;
    }
    .hero-dot:hover {
      background: rgba(28, 25, 23, 0.6);
    }
    .hero-dot.is-active {
      background: #b46e38;
      border-color: #b46e38;
      transform: scale(1.25);
    }
    .hero-dot:focus-visible {
      outline: 2px solid #b46e38;
      outline-offset: 3px;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slide {
        transition: none;
      }
    }
  </style>

  <script>
    function initHeroCarousel() {
      const section = document.querySelector('.hero-carousel');
      if (!section) return;

      const slides = section.querySelectorAll('.hero-slide');
      const dots = section.querySelectorAll('.hero-dot');
      if (slides.length === 0) return;

      let current = 0;
      let timer = null;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const INTERVAL_MS = 6000;

      function show(index) {
        slides[current].classList.remove('is-active');
        if (dots[current]) {
          dots[current].classList.remove('is-active');
          dots[current].setAttribute('aria-selected', 'false');
        }

        current = index;

        slides[current].classList.add('is-active');
        if (dots[current]) {
          dots[current].classList.add('is-active');
          dots[current].setAttribute('aria-selected', 'true');
        }
      }

      function next() {
        show((current + 1) % slides.length);
      }

      function start() {
        if (reducedMotion) return;
        stop();
        timer = window.setInterval(next, INTERVAL_MS);
      }

      function stop() {
        if (timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          if (i !== current) show(i);
          start();
        });
      });

      section.addEventListener('mouseenter', stop);
      section.addEventListener('mouseleave', start);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroCarousel);
    } else {
      initHeroCarousel();
    }
  </script>

  <!-- Trust strip -->
  <section class="py-14 lg:py-20 bg-ink">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center md:text-left">
        <div class="text-bone flex flex-col items-center md:items-start gap-4">
          <img
            src={`/images/icons/${icons.craftsmanship}`}
            alt=""
            width="56"
            height="56"
            class="w-14 h-14"
            loading="lazy"
          />
          <div>
            <p class="font-display text-2xl lg:text-3xl mb-2">35+ years hands-on</p>
            <p class="text-bone/60 text-sm">joinery & site carpentry</p>
          </div>
        </div>
        <div class="text-bone flex flex-col items-center md:items-start gap-4">
          <img
            src={`/images/icons/${icons.repair}`}
            alt=""
            width="56"
            height="56"
            class="w-14 h-14"
            loading="lazy"
          />
          <div>
            <p class="font-display text-2xl lg:text-3xl mb-2">General joinery</p>
            <p class="text-bone/60 text-sm">with heritage repair as a specialism</p>
          </div>
        </div>
        <div class="text-bone flex flex-col items-center md:items-start gap-4">
          <img
            src={`/images/icons/${icons.location}`}
            alt=""
            width="56"
            height="56"
            class="w-14 h-14"
            loading="lazy"
          />
          <div>
            <p class="font-display text-2xl lg:text-3xl mb-2">Pontefract-based</p>
            <p class="text-bone/60 text-sm">serving Yorkshire</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Repair vs Replace Decision Framework -->
  <section class="py-14 lg:py-28 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16 max-w-2xl mx-auto text-center lg:text-left">
        <div class="accent-line mx-auto lg:mx-0 mb-6"></div>
        <h2 class="font-display text-4xl lg:text-5xl text-ink mb-6">
          Heritage Repair Specialism
        </h2>
        <p class="text-lg text-ink/70">
          Good joinery is problem-solving. Alongside general carpentry and joinery, Rob brings decades of bench and site experience to older timber, awkward openings, bad angles and previous repairs. Where original fabric can be soundly retained, he will say so. Where it cannot, he will explain the replacement route clearly.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- We repair when -->
        <div>
          <h3 class="font-display text-2xl text-ink mb-6 pb-3 border-b-2 border-oak">
            Rob repairs when:
          </h3>
          <ul class="space-y-4">
            <li class="flex gap-4">
              <span class="text-oak font-display text-xl flex-shrink-0">✓</span>
              <span class="text-ink/80">Timber is still structurally sound in core sections</span>
            </li>
            <li class="flex gap-4">
              <span class="text-oak font-display text-xl flex-shrink-0">✓</span>
              <span class="text-ink/80">Decay is localised and can be cut out/spliced</span>
            </li>
            <li class="flex gap-4">
              <span class="text-oak font-display text-xl flex-shrink-0">✓</span>
              <span class="text-ink/80">Joints can be consolidated without compromising performance</span>
            </li>
            <li class="flex gap-4">
              <span class="text-oak font-display text-xl flex-shrink-0">✓</span>
              <span class="text-ink/80">Original character can be preserved effectively</span>
            </li>
          </ul>
        </div>

        <!-- We recommend replacement when -->
        <div>
          <h3 class="font-display text-2xl text-ink mb-6 pb-3 border-b-2 border-rust">
            Rob recommends replacement when:
          </h3>
          <ul class="space-y-4">
            <li class="flex gap-4">
              <span class="text-rust font-display text-xl flex-shrink-0">→</span>
              <span class="text-ink/80">Remaining sound timber is too low for a durable repair</span>
            </li>
            <li class="flex gap-4">
              <span class="text-rust font-display text-xl flex-shrink-0">→</span>
              <span class="text-ink/80">Decay is extensive through critical load-bearing zones</span>
            </li>
            <li class="flex gap-4">
              <span class="text-rust font-display text-xl flex-shrink-0">→</span>
              <span class="text-ink/80">Previous failed repairs make another repair unreliable</span>
            </li>
            <li class="flex gap-4">
              <span class="text-rust font-display text-xl flex-shrink-0">→</span>
              <span class="text-ink/80">A repair would be short-lived and poor value for you</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 p-8 lg:p-10 bg-paper rounded-lg border border-ink/10 text-center">
        <p class="text-lg lg:text-xl text-ink font-display leading-relaxed max-w-2xl mx-auto">
          You get a straight recommendation: preserve original where viable, replace only where necessary, and solve the practical problem in front of the building.
        </p>
        <a href="/repair-or-replace" class="inline-block mt-6 text-oak font-display text-sm hover:text-ink transition-colors">
          Read the full framework &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Services snapshot -->
  <section class="py-14 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 max-w-2xl mx-auto">
        <div class="accent-line mx-auto mb-6"></div>
        <h2 class="font-display text-4xl lg:text-5xl text-ink mb-6">What we do</h2>
        <p class="text-lg text-ink/70">
          Practical joinery and carpentry, done properly — from everyday work to heritage timber repair.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <a href="/services/kitchens" class="service-card group block relative">
          <div class="service-card-image" style="background-image: url('/images/homepage/workshop.webp')"></div>
          <div class="service-card-content">
            <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">
              Kitchens
            </h3>
            <p class="text-ink/70 text-sm mb-4 leading-relaxed">
              Kitchen fitting, timber worktops, cabinetry, pantry joinery, and careful set-out for homes across West Yorkshire.
            </p>
            <span class="text-oak font-display text-xs">Learn more &rarr;</span>
          </div>
        </a>
        <a href="/services/staircases" class="service-card group block relative">
          <div class="service-card-image" style="background-image: url('/images/homepage/service-windows.webp')"></div>
          <div class="service-card-content">
            <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">
              Staircases
            </h3>
            <p class="text-ink/70 text-sm mb-4 leading-relaxed">
              New staircases, loft stairs, handrails, spindles, repairs, and renovation work where the geometry has to be right.
            </p>
            <span class="text-oak font-display text-xs">Learn more &rarr;</span>
          </div>
        </a>
        <a href="/services/windows" class="service-card group block relative">
          <div class="service-card-image" style="background-image: url('/images/homepage/service-doors.webp')"></div>
          <div class="service-card-content">
