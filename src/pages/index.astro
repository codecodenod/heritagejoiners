            </p>
            <span class="text-oak font-display text-xs">Learn more &rarr;</span>
          </div>
        </a>
        <a href="/services/maintenance-repairs" class="service-card group block relative">
          <div class="service-card-image" style="background-image: url('/images/homepage/workshop.webp')"></div>
          <div class="service-card-content">
            <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">
              Maintenance &amp; Repairs
            </h3>
            <p class="text-ink/70 text-sm mb-4 leading-relaxed">
              Small joinery jobs, adjustments, snagging, and practical repairs when the fix needs a joiner.
            </p>
            <span class="text-oak font-display text-xs">Learn more &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Parallax: heritage timber band -->
  <section
    class="relative bg-ink overflow-hidden"
    aria-labelledby="parallax-original-timber"
  >
    <div
