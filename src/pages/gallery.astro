// A line of context per section, and the page the work belongs to. Keeps the
// gallery linked into the rest of the site instead of being a dead end.
const categoryMeta: Record<(typeof categories)[number], { blurb: string; href: string; linkText: string }> = {
  'Doors': {
    blurb: 'Door hanging and fitting, from bespoke solid oak entrance doors made on the bench to internal doors, linings and the ironmongery that goes with them.',
    href: '/services/doors', linkText: 'Door hanging and fitting',
  },
  'Windows': {
    blurb: 'Sash and casement window repair on period and listed buildings — rotten bottom rails and sills cut back and spliced, sashes released, then prepared and refinished.',
    href: '/services/windows', linkText: 'Sash and timber window repair',
  },
  'Staircases': {
    blurb: 'Solid oak staircases, landings, newels, handrails and spindles, set out and cut so the geometry works before anything is fixed.',
    href: '/services/staircases', linkText: 'Staircase fitting and repair',
  },
  'Kitchens': {
    blurb: 'Kitchen fitting and worktops, from bespoke oak cabinetry to a cost-effective refit set out around an existing splashback.',
    href: '/services/kitchens', linkText: 'Kitchen fitting',
  },
  'Timber Repair': {
    blurb: 'Wet rot and dry rot repair, splice and let-in repairs, beam repairs and decayed sills — cutting back to firm timber and letting new timber in to match.',
    href: '/services/timber-repair', linkText: 'Timber repair and restoration',
  },
  'Wall Panelling & Cladding': {
    blurb: 'Wall panelling, tongue and groove, and external timber cladding over treated battens, set out so the boards run true across the elevation.',
    href: '/services/cladding-panelling', linkText: 'Wall panelling and cladding',
  },
  'Skirting, Architrave & Mouldings': {
    blurb: 'Skirting board fitting, architrave and profile-matched mouldings, scribed to rooms that are rarely square.',
    href: '/services/skirting-architrave', linkText: 'Skirting and architrave fitting',
  },
  'Gates & Outdoor Carpentry': {
    blurb: 'Wooden garden gates made to measure, ledged and braced, hung to openings that are almost never the size they are supposed to be.',
    href: '/services/outdoor-carpentry', linkText: 'Gates and outdoor carpentry',
  },
  'Roofing Carpentry': {
    blurb: 'Roof carpentry and timber roof repairs — rafters, joists, firrings and decks, including flat roofs stripped back to sound timber and rebuilt.',
    href: '/services/roofing-carpentry', linkText: 'Roof carpentry',
  },
  'Stud Partitions & First Fix': {
    blurb: 'Timber stud partition walls set out at proper centres, with noggins, insulation and door openings formed before boarding.',
    href: '/services/first-fix-carpentry', linkText: 'First fix carpentry',
  },
  'Lofts & Storage': {
    blurb: 'Loft boarding on a new timber floor structure over the ceiling joists, with insulation kept at full depth and a ladder and hatch fitted.',
    href: '/services/extensions-conversions', linkText: 'Lofts and conversions',
  },
  'Flooring': {
    blurb: 'Timber and laminate flooring, including herringbone laid over a levelled subfloor and run under undercut door linings with no beading.',
    href: '/services/flooring', linkText: 'Flooring and floor sanding',
  },
  'Workshop & Bench Joinery': {
    blurb: 'Bench work — hand-cut joints, doors and staircase components made in the workshop before they ever reach site.',
    href: '/services/bespoke-joinery', linkText: 'Bespoke and built-in joinery',
  },
  'The Counting House': {
    blurb: 'One of Pontefract’s oldest buildings. Heritage Joiners contributed oak joinery and restoration carpentry to a project later recognised with the Heritage Award at Pontefract Civic Society’s 2025 Design Awards.',
    href: '/case-studies/counting-house', linkText: 'The Counting House case study',
  },
  'Dunster Windows': {
    blurb: 'Eleven timber sash windows and the main entrance door on Micklegate in Pontefract, repaired, sealed and refinished rather than replaced.',
    href: '/case-studies/dunster-windows', linkText: 'Dunster Windows case study',
  },
};

// Sections, in the order above. Empty categories drop out on their own.
const groups = categories
  .map((category) => ({ category, items: galleryItems.filter((g) => g.category === category), meta: categoryMeta[category] }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Carpentry & Joinery Gallery in West Yorkshire"
  description="See carpentry, joinery, timber repair and heritage work from Heritage Joiners across Pontefract, Wakefield and West Yorkshire, including doors and windows."

  ogImage="/images/gallery/oak-door-counting-house.webp"
>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <p class="text-oak uppercase tracking-wide mb-4">Recent work</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Carpentry &amp; Joinery Work Across West Yorkshire</h1>
        <p class="text-lg text-ink/70">
          Doors, windows, staircases, timber repairs, panelling, gates, roofs and bench joinery from jobs across Pontefract, Wakefield and the wider West Yorkshire area. Click any photo to see it full size.
        </p>
      </div>

      <div id="gallery-grid">
        {groups.map((group) => (
          <section class="mb-14 last:mb-0">
            <h2 class="font-display text-2xl text-ink mb-2 pb-2 border-b border-ink/10">{group.category}</h2>
            <p class="text-ink/70 mb-6 max-w-3xl">
              {group.meta.blurb}{' '}
              <a href={group.meta.href} class="text-oak underline">{group.meta.linkText}&nbsp;&rarr;</a>
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              {group.items.map((item) => (
                <article class="group block bg-bone rounded-lg overflow-hidden border border-ink/10 hover:border-oak transition-colors">
                  <a
                    href={item.image}
                    class="block gallery-open focus:outline-none focus-visible:ring-2 focus-visible:ring-oak"
                    data-index={galleryItems.indexOf(item)}
                    aria-label={`Enlarge: ${item.title}`}
                  >
                    <div class="aspect-[4/3] overflow-hidden">
                      <img src={item.image} alt={item.alt} width={item.width} height={item.height} class="w-full h-full object-cover" loading="lazy" />
                    </div>
                  </a>
                  <div class="p-5">
                    <h3 class="font-display text-lg text-ink group-hover:text-oak transition-colors">{item.title}</h3>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Lightbox: native <dialog>, no library. Tiles stay plain links if JS never runs. -->
      <dialog id="lightbox" aria-label="Gallery image" class="lightbox">
        <button type="button" class="lb-close" data-lb="close" aria-label="Close">&times;</button>
        <button type="button" class="lb-nav lb-prev" data-lb="prev" aria-label="Previous image">&#8249;</button>
        <button type="button" class="lb-nav lb-next" data-lb="next" aria-label="Next image">&#8250;</button>
        <figure>
          <img id="lb-img" src="" alt="" />
          <figcaption><span id="lb-title"></span> <span id="lb-count"></span></figcaption>
        </figure>
      </dialog>
    </div>
  </section>

  <section class="py-16 bg-ink text-bone">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl mb-4">Have a job you want us to look at?</h2>
      <p class="text-bone/70 mb-8 mx-auto">Send photos of the work area and Rob will tell you whether it fits the kind of joinery and carpentry Heritage Joiners takes on.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>

<script is:inline define:vars={{ items: galleryItems.map((g) => ({ src: g.image, title: g.title, alt: g.alt })) }}>
  const dlg = document.getElementById('lightbox');
  if (dlg && typeof dlg.showModal === 'function') {
    const img = document.getElementById('lb-img');
    const title = document.getElementById('lb-title');
    const count = document.getElementById('lb-count');
    let i = 0;
    const show = (n) => {
      i = (n + items.length) % items.length;
      img.src = items[i].src;
      img.alt = items[i].alt;
      title.textContent = items[i].title;
      count.textContent = `(${i + 1} of ${items.length})`;
    };
    document.getElementById('gallery-grid').addEventListener('click', (e) => {
      const a = e.target.closest('.gallery-open');
      if (!a) return;
      e.preventDefault();
      show(Number(a.dataset.index));
      dlg.showModal();
    });
    dlg.addEventListener('click', (e) => {
      const act = e.target.dataset ? e.target.dataset.lb : null;
      if (act === 'next') show(i + 1);
      else if (act === 'prev') show(i - 1);
      else if (act === 'close') dlg.close();
      // anything that is not the photo itself closes: dialog box, figure, caption
      else if (e.target.id !== 'lb-img') dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
    });
    dlg.addEventListener('close', () => { img.src = ''; });
  }
</script>

<style>
  /* Dark ground is on the dialog itself, not ::backdrop — Astro scopes ::backdrop
     out and the page shows through behind the photo. Dialog fills the viewport. */
  .lightbox { border: 0; padding: 0; background: rgb(28 22 17 / 0.975); max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; overflow: hidden; }
  .lightbox::backdrop { background: rgb(28 22 17 / 0.975); }
  .lightbox figure { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 3.5rem 1rem 1.5rem; }
  .lightbox img { max-width: 100%; max-height: calc(100vh - 8rem); width: auto; height: auto; object-fit: contain; border-radius: .5rem; }
  .lightbox figcaption { color: #f4efe6; font-size: .95rem; text-align: center; }
  .lightbox figcaption span + span { opacity: .6; margin-left: .4rem; }
  .lb-close, .lb-nav { position: absolute; background: rgb(244 239 230 / 0.1); color: #f4efe6; border: 0; cursor: pointer; line-height: 1; border-radius: .4rem; }
  .lb-close:hover, .lb-nav:hover { background: rgb(244 239 230 / 0.22); }
  .lb-close:focus-visible, .lb-nav:focus-visible { outline: 2px solid #b5854b; outline-offset: 2px; }
  .lb-close { top: .75rem; right: .75rem; width: 2.75rem; height: 2.75rem; font-size: 1.9rem; }
  .lb-nav { top: 50%; transform: translateY(-50%); width: 2.75rem; height: 4rem; font-size: 2.2rem; }
  .lb-prev { left: .75rem; }
  .lb-next { right: .75rem; }
  @media (prefers-reduced-motion: no-preference) { .lightbox[open] { animation: lb-in .18s ease-out; } }
  @keyframes lb-in { from { opacity: 0 } to { opacity: 1 } }
</style>
</BaseLayout>
