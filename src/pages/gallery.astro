---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneLink from '../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../components/ui/WhatsAppCTA.astro';
import { siteConfig } from '../config/site';

const { phone } = siteConfig;

const galleryItems = [
  {
    title: 'Timber Doors',
    category: 'Doors',
    image: '/images/gallery/oak-door-counting-house.webp',
    alt: 'Solid oak boarded door with stained-glass detail in a stone surround',
    width: 619,
    height: 1100,
  },
  {
    title: 'Timber Windows',
    category: 'Windows',
    image: '/images/gallery/sash-window-repair-pontefract.webp',
    alt: 'Sash bay window with glazing bars on a brick period property',
    width: 608,
    height: 800,
  },
  {
    title: 'Splice Repairs',
    category: 'Timber Repair',
    image: '/images/gallery/wood-splice-repair.webp',
    alt: 'New timber section spliced into the corner of an original door frame',
    width: 1269,
    height: 1044,
  },
  {
    title: 'Timber Joist Repair',
    category: 'Timber Repair',
    image: '/images/gallery/timber-joist-repair.webp',
    alt: 'New timber floor joists installed across a living room during floor repair',
    width: 1200,
    height: 675,
  },
  {
    title: 'Engineered Oak Flooring',
    category: 'Flooring',
    image: '/images/gallery/engineered-oak-wood-flooring.webp',
    alt: 'Engineered oak wood flooring being fitted over underlay in a living room',
    width: 1200,
    height: 966,
  },
  {
    title: 'Workshop Joinery',
    category: 'Joinery',
    image: '/images/gallery/workshop-bench-hand-joinery.webp',
    alt: 'Framed oak panel being made on the bench in the Heritage Joiners workshop',
    width: 1200,
    height: 794,
  },
  {
    title: 'The Counting House',
    category: 'Case Study',
    image: '/images/case-studies/counting-house/counting-house-hero.webp',
    alt: 'The Counting House case study building',
    width: 900,
    height: 640,
  },
  {
    title: 'Counting House Award',
    category: 'Case Study',
    image: '/images/case-studies/counting-house/heritage-award-counting-house.webp',
    alt: 'The Counting House and the Pontefract Civic Society 2025 Design Awards presentation',
    width: 1479,
    height: 602,
  },
  {
    title: 'Period Door Detail',
    category: 'Heritage',
    image: '/images/homepage/heritage-oak-door-restoration-yorkshire.webp',
    alt: 'Restored oak door detail',
    width: 2560,
    height: 1441,
  },
];
---

<BaseLayout
  title="Gallery | Heritage Joiners"
  description="See carpentry, joinery, timber repair and heritage work from Heritage Joiners across Pontefract, Wakefield and West Yorkshire, including doors and windows."

  ogImage="/images/gallery/oak-door-counting-house.webp"
>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <p class="text-oak uppercase tracking-wide mb-4">Recent work</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Carpentry &amp; Joinery Work Across West Yorkshire</h1>
        <p class="text-lg text-ink/70">
          A working gallery of carpentry, joinery, heritage repair, and timber details across West Yorkshire. The point is simple: let the timber, the repairs, and the fitting details speak for the work while the gallery grows with more doors, kitchens, stairs, roofs, and built-in joinery.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {galleryItems.map((item) => (
          <article class="group block bg-bone rounded-lg overflow-hidden border border-ink/10 hover:border-oak transition-colors">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={item.image} alt={item.alt} width={item.width} height={item.height} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs text-oak uppercase tracking-wide">{item.category}</span>
              </div>
              <h2 class="font-display text-xl text-ink mb-2 group-hover:text-oak transition-colors">{item.title}</h2>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-ink text-bone">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl mb-4">Have a job you want us to look at?</h2>
      <p class="text-bone/70 mb-8 mx-auto">Send photos of the work area and Rob will tell you whether it fits the kind of joinery and carpentry Heritage Joiners takes on.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
