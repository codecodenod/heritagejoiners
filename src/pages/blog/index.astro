---
/**
 * Blog index
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog — Carpentry & Joinery Advice"
  description="Practical carpentry and joinery advice from Heritage Joiners — what good workmanship looks like, what jobs cost, and how things should be done properly."
>
  <!-- Hero: workshop bench with fade for text legibility -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/blog/heritage-joiners-pontefract-blog.webp"
      alt="A traditional hand plane and fresh wood shavings on a bench in the Heritage Joiners workshop"
      width="1200"
      height="541"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
        <p class="text-oak uppercase tracking-wide mb-4">Blog</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Carpentry &amp; joinery, explained</h1>
        <p class="text-lg text-ink/80">
          Plain, practical advice on joinery and carpentry — what jobs involve, what good workmanship
          looks like, and how things should be done properly. Written from the bench and the site, not the brochure.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-ink/60">Posts are on the way — check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="service-card group relative">
              {post.data.ogImage && (
                /* alt="" is deliberate: the post title sits directly beneath and
                   is the accessible name for this link, so describing the photo
                   again would just repeat it for screen reader users. */
                <img src={post.data.ogImage} alt="" loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
              )}
              <div class="service-card-content">
                <p class="text-xs text-ink/40 mb-3">{fmt(post.data.pubDate)}</p>
                <h2 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-ink/70 text-sm mb-4 leading-relaxed">{post.data.description}</p>
                <span class="mt-auto text-oak font-display text-xs">Read more &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
