---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas/featherstone` },
  { name: 'Featherstone', url: `${url}/areas/featherstone` },
];
---

<BaseLayout title="Timber Repairs in Featherstone" description="Repair-first timber window, door, frame, rot, and splice repairs for period properties in Featherstone and WF7.">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Featherstone WF7</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Timber repairs for period properties in Featherstone</h1>
        <p class="text-lg text-ink/70 mb-8">
          Repair-first timber window, door, frame, and rot repair for Featherstone homes where retaining original timber is often better than premature replacement.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Local building stock</h2>
        <p class="text-ink/70">
          Featherstone's mining-era terraced streets are mostly brick-built with original sash windows still in place on older fronts. The frames are often solid but the cill ends and lower rails have taken 100 years of weather without much intervention. Many properties around Station Lane and North Featherstone carry original joinery that repays careful repair.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Areas we cover in Featherstone</h2>
        <ul class="space-y-1 text-ink/70 list-disc list-inside">
          <li>Purston</li>
          <li>Ackton</li>
          <li>North Featherstone</li>
          <li>South Featherstone</li>
          <li>Station Lane area</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-6">Common timber issues we see in Featherstone</h2>
        <ul class="space-y-3 text-ink/70 list-disc list-inside">
          <li>Cill noses split with decay tracking back into the body of the cill</li>
          <li>Door frame feet softened by constant splashback from hard surfaces</li>
          <li>Sash lower rails swollen and cracked after repeated wet-dry cycles</li>
          <li>Subframe junctions holding damp in shaded or north-facing spots</li>
          <li>Previous resin patches breaking out and exposing untreated rot beneath</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Featherstone</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/sash-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Sash Window Repair</a>
        <a href="/services/timber-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Window Repair</a>
        <a href="/services/doors-and-frames" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors &amp; Frames</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/services/timber-frame-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Frame Repair</a>
        <a href="/services/structural-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/timber-colour-matching-and-finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need timber repair in Featherstone?</h2>
      <p class="text-ink/70 mb-8 mx-auto">WhatsApp photos and postcode. Images of cills, thresholds, and any visible decay help assess scope before a site visit.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
