---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas/featherstone/` },
  { name: 'Featherstone', url: `${url}/areas/featherstone/` },
];
---

<BaseLayout title="Timber Repairs in Featherstone" description="Repair-first timber window, door, frame, rot, and splice repairs for period properties in Featherstone and WF7.">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Featherstone WF7</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Timber repairs for period properties in Featherstone</h1>
        <p class="text-lg text-ink/70 mb-8">
          Repair-first timber window, door, frame, and rot repair for Featherstone homes where retaining original timber is often better than premature replacement.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Local repair focus</h2>
        <p class="text-ink/70">
          Featherstone sits inside Heritage Joiners' priority WF patch. We focus on original timber, not sales-led replacement, and advise honestly when repair is or is not viable.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">What we assess</h2>
        <p class="text-ink/70">
          Sills, lower rails, frames, door thresholds, glazing beds, and previous repairs are checked before we recommend splice repair, partial replacement, or full replacement.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Featherstone</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <a href="/services/listed-and-period-property-repairs/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink">Listed & period repairs</a>
        <a href="/services/timber-window-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink">Timber window repair</a>
        <a href="/services/doors-and-frames/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink">Doors & frames</a>
        <a href="/services/rot-and-splice/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink">Rot & splice repair</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need timber repair in Featherstone?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos first for an initial repair viability view.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
