---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas/wakefield` },
  { name: 'Wakefield', url: `${url}/areas/wakefield` },
];
---

<BaseLayout title="Timber Repairs in Wakefield" description="Repair-first timber window, door, frame, rot, and splice repairs for listed and period properties in Wakefield, WF1, WF2, WF3, and WF4.">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Wakefield WF1-WF4</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Timber repairs for listed and period properties in Wakefield</h1>
        <p class="text-lg text-ink/70 mb-8">
          Repair-first timber work for Wakefield period homes, conservation-area properties, and historic buildings, covering windows, doors, frames, rot, and splice repairs.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Local building stock</h2>
        <p class="text-ink/70">
          Wakefield has dense Victorian terraces, larger period homes in Sandal, and Georgian townhouses around the cathedral quarter. West-facing joinery across WF1 and WF2 takes weather hard — exposed cills and door bottoms on those elevations are the most common starting point for rot. The conservation areas around Westgate and the cathedral precinct contain listed buildings where repair is the only appropriate route.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Areas we cover in Wakefield</h2>
        <ul class="space-y-1 text-ink/70 list-disc list-inside">
          <li>Sandal</li>
          <li>Crigglestone</li>
          <li>Horbury</li>
          <li>Ossett</li>
          <li>Agbrigg</li>
          <li>Lupset</li>
          <li>Outwood</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-6">Common timber issues we see in Wakefield</h2>
        <ul class="space-y-3 text-ink/70 list-disc list-inside">
          <li>Door bottom rails decayed behind thick paint edges</li>
          <li>Sash cills split at corners with rot tracking inward</li>
          <li>Casement frame corners opening after repeated seasonal movement</li>
          <li>Porch supports soft at the base from long-term splashback</li>
          <li>Joist-end decay where historic damp has been left untreated</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Wakefield</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/sash-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Sash Window Repair</a>
        <a href="/services/timber-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Window Repair</a>
        <a href="/services/doors-and-frames" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors &amp; Frames</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/services/structural-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/roof-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roof Timber Repair</a>
        <a href="/services/floor-joist-and-floorboard-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Floor Joist Repair</a>
        <a href="/services/timber-colour-matching-and-finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need timber repair in Wakefield?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos on WhatsApp — postcode, approximate property age, and one wide shot plus close-up per defect. You'll get a straight answer on repair scope from the first contact.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
