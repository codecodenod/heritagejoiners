---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import AreaLinks from '../../components/sections/AreaLinks.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas` },
  { name: 'Normanton', url: `${url}/areas/normanton` },
];
---

<BaseLayout
  title="Timber Repair in Normanton (WF6)"
  description="Repair-first timber specialists for listed and period properties in Normanton and WF6. Windows, doors, beams, rot and structural timber repairs."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Normanton WF6</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Heritage Timber Repair in Normanton</h1>
        <p class="text-lg text-ink/70 mb-8">
          Heritage Joiners works in Normanton and across WF6 for repair-first timber window, door, frame, and structural work on period and listed properties. We are Pontefract-based and cover Normanton as part of our local WF postcode territory.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Period stock in Normanton</h2>
        <p class="text-ink/70 mb-3">
          Normanton's Victorian and Edwardian terraces, miners' housing, and older commercial buildings include properties with original sash windows, timber doors, and period joinery. This is the working stock that benefits most from a repair-first approach rather than replacement.
        </p>
        <p class="text-ink/70">
          We assess repair viability on each element before recommending any work. Door frames, rafter tails, floor joists, and window cills are the most common areas where decay is found on this age of building.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">WF6 coverage</h2>
        <p class="text-ink/70">
          We cover Normanton (WF6) and surrounding areas. For significant structural timber or listed building work, we travel across the wider West Yorkshire and Yorkshire area.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-6">Common timber issues we see in Normanton</h2>
        <ul class="space-y-3 text-ink/70 list-disc list-inside">
          <li>Cill ends rotten beneath surface paint that still looks intact</li>
          <li>Door stile bases softened where water keeps finding the same path in</li>
          <li>Meeting rail gaps causing draught and water entry through the sash</li>
          <li>Frame twist in older openings with historic structural movement</li>
          <li>Mismatched timber patch repairs failing sooner than the original sections around them</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Normanton</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/sash-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Sash Window Repair</a>
        <a href="/services/timber-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Window Repair</a>
        <a href="/services/doors-and-frames" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors &amp; Frames</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/services/roof-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roof Timber Repair</a>
        <a href="/services/structural-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/timber-colour-matching-and-finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-6">Our anchor project is The Counting House in Pontefract — a listed period building with comprehensive window, door, and timber matching work across multiple elements.</p>
      <a href="/case-studies/counting-house" class="text-oak font-display">View Counting House case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need timber repair in Normanton?</h2>
      <p class="text-ink/70 mb-8 mx-auto">WhatsApp photos (wide + close-up per defect) with postcode and approximate building age. You'll get an honest view on repair options from the first contact.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
  <AreaLinks heading="Nearby areas we cover" currentHref="/areas/normanton" />
</BaseLayout>
