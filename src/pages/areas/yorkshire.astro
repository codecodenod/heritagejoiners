---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas/` },
  { name: 'Yorkshire', url: `${url}/areas/yorkshire/` },
];
---

<BaseLayout
  title="Listed & Period Timber Repair Across Yorkshire | Heritage Joiners"
  description="Heritage Joiners — Pontefract-based specialist timber repair for listed and period buildings across West Yorkshire, North Yorkshire, and beyond."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Yorkshire-wide heritage timber</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Listed &amp; Period Timber Repair Across Yorkshire</h1>
        <p class="text-lg text-ink/70 mb-8">
          Heritage Joiners is based in Pontefract and covers the full West Yorkshire patch as primary territory. For listed building and period property timber work — structural repairs, oak frames, whole-property programmes, heritage panelling — we travel across the wider county, including North Yorkshire and South Yorkshire, where the scope justifies it.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Coverage by area</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">West Yorkshire — primary territory</h3>
          <ul class="space-y-1 text-ink/70 text-sm">
            <li><a href="/areas/pontefract/" class="text-oak hover:underline">Pontefract</a> (home base)</li>
            <li><a href="/areas/wakefield/" class="text-oak hover:underline">Wakefield</a></li>
            <li><a href="/areas/castleford/" class="text-oak hover:underline">Castleford</a></li>
            <li><a href="/areas/featherstone/" class="text-oak hover:underline">Featherstone</a></li>
            <li><a href="/areas/knottingley/" class="text-oak hover:underline">Knottingley</a></li>
            <li><a href="/areas/normanton/" class="text-oak hover:underline">Normanton</a></li>
            <li><a href="/areas/leeds/" class="text-oak hover:underline">Leeds</a></li>
          </ul>
        </div>
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">North Yorkshire</h3>
          <p class="text-ink/70 text-sm">York, Harrogate, Wetherby, and surrounding areas for listed and period work where the project scope justifies travel.</p>
        </div>
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">South Yorkshire</h3>
          <p class="text-ink/70 text-sm">Barnsley, Doncaster, and surrounding areas for significant structural or listed building timber programmes.</p>
        </div>
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">What justifies travel</h3>
          <p class="text-ink/70 text-sm">Listed building timber repairs, structural programmes, oak frame work, whole-property restoration. We do not travel for general joinery or single small-item repairs outside our local patch.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services across Yorkshire</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/sash-window-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Sash Window Repair</a>
        <a href="/services/structural-timber-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/oak-beam-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Oak Beam Repair</a>
        <a href="/services/roof-timber-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roof Timber Repair</a>
        <a href="/services/timber-frame-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Frame Repair</a>
        <a href="/services/listed-and-period-property-repairs/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
        <a href="/services/heritage-wall-panelling-repair/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Heritage Wall Panelling</a>
        <a href="/services/timber-colour-matching-and-finishing/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Colour Matching &amp; Finishing</a>
        <a href="/services/when-repair-is-not-viable/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">When Repair Is Not Viable</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-6">The Counting House in Pontefract is our anchor case study for listed and period timber work across the county.</p>
      <a href="/case-studies/counting-house/" class="text-oak font-display">View Counting House case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Heritage timber work across Yorkshire?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send details of the property and the timber in question. We will advise whether the project is within our travel scope.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
