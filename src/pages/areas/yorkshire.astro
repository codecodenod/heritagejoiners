---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import AreaLinks from '../../components/sections/AreaLinks.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas` },
  { name: 'Yorkshire', url: `${url}/areas/yorkshire` },
];
---

<BaseLayout title="Carpenter & Joiner Across Yorkshire" description="Carpentry and joinery across Yorkshire for timber-led projects, with West Yorkshire as the core service area and heritage repair kept as a specialism.">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Yorkshire-wide timber work</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Carpenter &amp; Joiner Across Yorkshire</h1>
        <p class="text-lg text-ink/70 mb-8">
          West Yorkshire is the core patch for the business, but Rob also travels wider across Yorkshire for the right timber-led work. That includes general joinery, structural carpentry, bespoke timber jobs, and heritage repair where experience with older fabric really matters.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Coverage by area</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">West Yorkshire</h3>
          <ul class="space-y-1 text-ink/70 text-sm">
            <li><a href="/areas/pontefract" class="text-oak hover:underline">Pontefract</a></li>
            <li><a href="/areas/wakefield" class="text-oak hover:underline">Wakefield</a></li>
            <li><a href="/areas/castleford" class="text-oak hover:underline">Castleford</a></li>
            <li><a href="/areas/featherstone" class="text-oak hover:underline">Featherstone</a></li>
            <li><a href="/areas/knottingley" class="text-oak hover:underline">Knottingley</a></li>
            <li><a href="/areas/normanton" class="text-oak hover:underline">Normanton</a></li>
            <li><a href="/areas/leeds" class="text-oak hover:underline">Leeds</a></li>
          </ul>
        </div>
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">North Yorkshire</h3>
          <p class="text-ink/70 text-sm">Selected timber-led work where the scope justifies travel, especially older buildings and specialist joinery.</p>
        </div>
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">South Yorkshire</h3>
          <p class="text-ink/70 text-sm">Larger carpentry, timber repair, and structural jobs where site location is workable from the Pontefract base.</p>
        </div>
        <div class="p-6 bg-paper rounded-lg">
          <h3 class="font-display text-lg text-ink mb-3">What tends to travel</h3>
          <p class="text-ink/70 text-sm">Heritage timber repair, structural carpentry, bespoke joinery, and timber-heavy jobs rather than very small domestic maintenance visits.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Representative services across Yorkshire</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/doors" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors</a>
        <a href="/services/windows" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Windows</a>
        <a href="/services/kitchens" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Kitchens</a>
        <a href="/services/staircases" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Staircases</a>
        <a href="/services/roofing-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roofing &amp; Roof Carpentry</a>
        <a href="/services/extensions-conversions" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Extensions &amp; Conversions</a>
        <a href="/services/bespoke-joinery" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Bespoke Joinery</a>
        <a href="/services/timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Repair &amp; Restoration</a>
        <a href="/services/finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Finishing</a>
        <a href="/services/cladding-panelling" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Cladding &amp; Panelling</a>
        <a href="/services/first-fix-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">First Fix Carpentry</a>
        <a href="/services/second-fix-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Second Fix Carpentry</a>
        <a href="/services/skirting-architrave" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Skirting &amp; Architrave</a>
        <a href="/services/outdoor-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Outdoor Carpentry</a>
        <a href="/services/woodworm-treatment" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Woodworm Treatment</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-6">Heritage Joiners contributed specialist joinery work to the restoration of The Counting House in Pontefract - a project later recognised with a Pontefract Civic Society restoration award.</p>
      <a href="/case-studies/counting-house" class="text-oak font-display">View Counting House case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Working further across Yorkshire?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send the location, photos, and the basic scope and Rob will advise whether the job fits the wider travel coverage.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
  <AreaLinks heading="Nearby areas we cover" currentHref="/areas/yorkshire" />
</BaseLayout>
