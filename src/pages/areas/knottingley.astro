---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas` },
  { name: 'Knottingley', url: `${url}/areas/knottingley` },
];
---

<BaseLayout
  title="Timber Repair in Knottingley (WF11) | Heritage Joiners"
  description="Repair-first timber specialists for listed and period properties in Knottingley and WF11. Windows, doors, beams, joists, rot and structural repairs."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Knottingley WF11</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Heritage Timber Repair in Knottingley</h1>
        <p class="text-lg text-ink/70 mb-8">
          Heritage Joiners is based in Pontefract, minutes from Knottingley. We work on timber windows, doors, frames, structural timbers, and rot repairs for period and listed properties across WF11 and the surrounding area.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Period property in Knottingley</h2>
        <p class="text-ink/70 mb-3">
          Knottingley's building stock includes Victorian terraces, older commercial buildings, and period properties that retain original timber joinery. Many of these properties have sash windows, panelled doors, and timber frames that are worth repairing rather than replacing.
        </p>
        <p class="text-ink/70">
          We are Pontefract-based and cover Knottingley as part of our local WF postcode territory — no travel surcharge, familiar with the local building stock.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">WF11 coverage</h2>
        <p class="text-ink/70">
          We cover Knottingley (WF11) and surrounding villages including Ferrybridge, Kellington, and Brotherton. For listed building and heritage timber projects we also travel further across the wider West Yorkshire area.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-6">Common timber issues we see in Knottingley</h2>
        <ul class="space-y-3 text-ink/70 list-disc list-inside">
          <li>Threshold timber failed at the weather edge while upper sections remain solid</li>
          <li>Lower sash rail decay where putty lines have gone and water has tracked in</li>
          <li>Frame bases softened by trapped moisture under old coating systems</li>
          <li>Bay junction movement opening cracks that pull in rain over time</li>
          <li>Isolated joist-end defects in older floors where historic damp has sat</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Knottingley</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/sash-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Sash Window Repair</a>
        <a href="/services/timber-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Window Repair</a>
        <a href="/services/doors-and-frames" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors &amp; Frames</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/services/structural-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/floor-joist-and-floorboard-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Floor Joist Repair</a>
        <a href="/services/timber-colour-matching-and-finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-6">Our anchor project is The Counting House in nearby Pontefract — a listed period building with sash windows, doors, and timber matching work across multiple elements.</p>
      <a href="/case-studies/counting-house" class="text-oak font-display">View Counting House case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Timber repair in Knottingley?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send postcode and photos on WhatsApp — wide shot for context, close-up for each defect. You'll get a clear response on what work is involved.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
