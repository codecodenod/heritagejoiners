---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import AreaLinks from '../../components/sections/AreaLinks.astro';
import RecentWorkInArea from '../../components/sections/RecentWorkInArea.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas` },
  { name: 'Pontefract', url: `${url}/areas/pontefract` },
];
---

<BaseLayout title="Carpenter & Joiner in Pontefract" description="Carpenter and joiner in Pontefract for kitchens, doors, windows, staircases, flooring, roofing carpentry, repairs, and heritage timber work."
  ogImage="/images/case-studies/counting-house/the-counting-house-pontefract-historic-building.webp">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/case-studies/counting-house/the-counting-house-pontefract-historic-building.webp"
      alt="Timber framed historic building in Pontefract with traditional oak framing and joinery"
      width="1450"
      height="816"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
        <p class="text-oak uppercase tracking-wide mb-4">Pontefract WF7, WF8 &amp; WF9</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Carpenter &amp; Joiner in Pontefract</h1>
        <p class="text-lg text-ink/80 mb-8">
          Heritage Joiners is based locally, so Pontefract is the heart of the patch for general carpentry and joinery. Rob covers kitchens, doors, windows, staircases, flooring, roof carpentry, maintenance repairs, and heritage timber work where older buildings need a more careful approach.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Local building stock</h2>
        <p class="text-ink/70">
          Pontefract has a mix of Victorian terraces, inter-war homes, newer estates, and older town-centre buildings. That means the local work ranges from straightforward kitchens and second-fix joinery through to timber windows, structural roof details, and repair-led work on period properties. The common thread is practical joinery and carpentry problem-solving.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Nearby areas we cover</h2>
        <ul class="space-y-1 text-ink/70 list-disc list-inside">
          <li>Ackworth</li>
          <li>Darrington</li>
          <li>East Hardwick</li>
          <li>Carleton</li>
          <li>Tanshelf</li>
          <li>Monkhill</li>
          <li>Baghill</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-6">Common work we take on in Pontefract</h2>
        <ul class="space-y-3 text-ink/70 list-disc list-inside">
          <li>Kitchen fitting and timber worktops</li>
          <li>Door hanging, locks, hinges, and frame adjustments</li>
          <li>Sash and timber window repairs</li>
          <li>Stair repairs, new handrails, and trim work</li>
          <li>Floorboard repairs, sanding, and refinishing</li>
          <li>Roof carpentry and timber repair on older buildings</li>
        </ul>
      </div>
    </div>
  </section>

  <RecentWorkInArea area="Pontefract" background="bg-bone" />

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Pontefract</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/doors" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors</a>
        <a href="/services/windows" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Windows</a>
        <a href="/services/kitchens" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Kitchens</a>
        <a href="/services/staircases" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Staircases</a>
        <a href="/services/flooring" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Flooring</a>
        <a href="/services/roofing-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roofing &amp; Roof Carpentry</a>
        <a href="/services/timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Repair &amp; Restoration</a>
        <a href="/services/maintenance-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Maintenance &amp; Repairs</a>
        <a href="/services/cladding-panelling" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Cladding &amp; Panelling</a>
        <a href="/services/first-fix-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">First Fix Carpentry</a>
        <a href="/services/second-fix-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Second Fix Carpentry</a>
        <a href="/services/skirting-architrave" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Skirting &amp; Architrave</a>
        <a href="/services/outdoor-carpentry" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Outdoor Carpentry</a>
        <a href="/services/woodworm-treatment" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Woodworm Treatment</a>
        <a href="/services/bespoke-joinery" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Fitted Wardrobes</a>
        <a href="/services/extensions-conversions" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Extensions &amp; Conversions</a>
        <a href="/services/finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Finishing &amp; Wood Staining</a>
        <a href="/services/timber-hardwoods" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Oak &amp; Hardwoods</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Pontefract proof</h2>
      <p class="text-ink/70 mb-6">Heritage Joiners contributed specialist oak joinery and restoration carpentry to The Counting House in Pontefract - a project later recognised with the Heritage Award at Pontefract Civic Society's 2025 Design Awards.</p>
      <a href="/case-studies/counting-house" class="text-oak font-display">View Counting House &rarr;</a>

      <p class="text-ink/70 mt-10 mb-6">On Micklegate, eleven timber sash windows and the main entrance door at the former Perfect&rsquo;s Hospital were repaired, sealed and refinished rather than replaced &mdash; a building Wakefield Council identifies as contributing to the Pontefract Castle Conservation Area.</p>
      <a href="/case-studies/dunster-windows" class="text-oak font-display">View Dunster Windows &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need a joiner in Pontefract?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos and a short note on the work you need and Rob will point you in the right direction.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
  <AreaLinks heading="Nearby areas we cover" currentHref="/areas/pontefract" />
</BaseLayout>
