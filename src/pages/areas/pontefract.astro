---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas/pontefract` },
  { name: 'Pontefract', url: `${url}/areas/pontefract` },
];
---

<BaseLayout title="Timber Repairs in Pontefract" description="Repair-first timber window, door, frame, rot, and splice repairs for listed and period properties in Pontefract, WF7, WF8, and WF9.">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Pontefract WF7, WF8 & WF9</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-6">Timber repairs for listed and period properties in Pontefract</h1>
        <p class="text-lg text-ink/70 mb-8">
          Heritage Joiners is Pontefract-based, repairing timber windows, doors, frames, sills, and rot damage for period homes and historic buildings across the local area.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Local building stock</h2>
        <p class="text-ink/70">
          Pontefract has Victorian terraces, inter-war semis, and older properties around the market core. Exposed fronts around Southgate and out toward Carleton often show decay first at cills, thresholds, and lower frame joints. The Georgian and Edwardian stock in the town centre and Tanshelf ward carries original sash windows that are worth repairing rather than replacing.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Villages we cover</h2>
        <ul class="space-y-1 text-ink/70 list-disc list-inside">
          <li>Ackworth</li>
          <li>Darrington</li>
          <li>East Hardwick</li>
          <li>Carleton</li>
          <li>Tanshelf</li>
          <li>Monkhill</li>
          <li>Baghill</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-6">Common timber issues we see in Pontefract</h2>
        <ul class="space-y-3 text-ink/70 list-disc list-inside">
          <li>Cill ends gone soft where water sits at masonry joints</li>
          <li>Lower sash rails opening at joints after long-term wetting</li>
          <li>Door thresholds decayed at the weather edge</li>
          <li>Frame bases holding moisture behind old paint films</li>
          <li>Bay window junctions split where old fillers have failed</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Services in Pontefract</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/sash-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Sash Window Repair</a>
        <a href="/services/timber-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Window Repair</a>
        <a href="/services/doors-and-frames" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors &amp; Frames</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/services/structural-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/oak-beam-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Oak Beam Repair</a>
        <a href="/services/roof-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roof Timber Repair</a>
        <a href="/services/floor-joist-and-floorboard-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Floor Joist Repair</a>
        <a href="/services/timber-frame-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Frame Repair</a>
        <a href="/services/heritage-wall-panelling-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Wall Panelling Repair</a>
        <a href="/services/timber-colour-matching-and-finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Pontefract proof</h2>
      <p class="text-ink/70 mb-6">The Counting House is a listed period building in Pontefract — the anchor case study showing the repair decisions made on sash windows, timber doors, and profile matching across the whole building.</p>
      <a href="/case-studies/counting-house" class="text-oak font-display">View Counting House &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need timber repair in Pontefract?</h2>
      <p class="text-ink/70 mb-8 mx-auto">WhatsApp photos of the affected areas — wide shot plus close-up per defect. You'll get a direct answer on what's repairable and what the options are.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
