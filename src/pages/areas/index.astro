---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import { siteConfig } from '../../config/site';

const { url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Areas', url: `${url}/areas` },
];

const localAreas = [
  { href: '/areas/pontefract', title: 'Pontefract', desc: 'Home base. WF7, WF8, WF9 and surrounding villages for general joinery and timber repair.' },
  { href: '/areas/wakefield', title: 'Wakefield', desc: 'WF1-WF4. Everyday carpentry, period housing, and timber-led repair work.' },
  { href: '/areas/castleford', title: 'Castleford', desc: 'WF10. Kitchens, doors, trim, flooring, and practical joinery in mixed housing stock.' },
  { href: '/areas/featherstone', title: 'Featherstone', desc: 'WF7. Local carpentry, joinery, maintenance, and repair-led timber work.' },
  { href: '/areas/knottingley', title: 'Knottingley', desc: 'WF11. General joinery, doors, kitchens, windows, and older timber details.' },
  { href: '/areas/normanton', title: 'Normanton', desc: 'WF6. Practical joinery for Victorian, Edwardian, and everyday family homes.' },
];

const travelAreas = [
  { href: '/areas/leeds', title: 'Leeds', desc: 'Selected timber-led joinery, built-ins, roof carpentry, and older-building repair work.' },
  { href: '/areas/yorkshire', title: 'Yorkshire (wider)', desc: 'Significant structural, timber-led, and heritage projects where the scope justifies travel.' },
];
---

<BaseLayout
  title="Areas We Cover from Pontefract"
  description="Heritage Joiners covers Pontefract, Wakefield, Castleford, Featherstone, Knottingley, Normanton, Leeds, and selected timber-led projects across Yorkshire."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Areas we cover</h1>
        <p class="text-lg text-ink/70">
          Heritage Joiners is Pontefract-based, with WF postcodes as the core patch for carpentry and joinery across West Yorkshire. Rob is a fully qualified apprentice trained bench hand joiner, time served, and travels wider for selected timber-led and heritage projects where that experience is the right fit.
        </p>
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Local — WF postcodes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {localAreas.map((area) => (
          <a href={area.href} class="block p-6 bg-bone rounded-lg border border-ink/10 hover:border-oak transition-colors">
            <h3 class="font-display text-xl text-ink mb-2">{area.title}</h3>
            <p class="text-ink/70">{area.desc}</p>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Travel — larger timber-led work</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {travelAreas.map((area) => (
          <a href={area.href} class="block p-6 bg-bone rounded-lg border border-ink/10 hover:border-oak transition-colors">
            <h3 class="font-display text-xl text-ink mb-2">{area.title}</h3>
            <p class="text-ink/70">{area.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
