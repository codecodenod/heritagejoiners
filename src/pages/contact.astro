---
/**
 * Contact page
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneLink from '../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../components/ui/WhatsAppCTA.astro';
import { siteConfig } from '../config/site';

const { name, phone, whatsapp, address, hours } = siteConfig;
---

<BaseLayout title="Contact a Joiner in Pontefract & Wakefield" description="Contact a joiner or carpenter in Pontefract, Wakefield, and West Yorkshire for carpentry, joinery, repairs, kitchens, doors, windows, stairs, and heritage timber work.">
  <!-- Hero: Yorkshire countryside background with fade for text legibility -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/heritage-joiners-pontefract-carpentry-and-timber-restoration.webp"
      alt="Yorkshire countryside with stone barns and dry stone walls"
      width="1619"
      height="982"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          Contact a Joiner in Pontefract, Wakefield &amp; West Yorkshire
        </h1>
        <p class="text-lg text-ink/80">
          Send photos first. If you are looking for a joiner or carpenter, it is the fastest way for Rob to tell whether your enquiry looks like general joinery, a larger carpentry project, or heritage timber repair.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="mb-12">
          <h2 class="font-display text-2xl text-ink mb-4">What to send</h2>
          <ul class="space-y-2 text-ink/70 list-disc list-inside">
            <li>Postcode and town</li>
            <li>A few words on the job - a new door, kitchen, staircase, flooring, fitted work, a repair, or anything else timber</li>
            <li>One wide photo of the room or area the work is in</li>
            <li>Rough sizes if you have them - nothing exact, a tape-measure guess is fine</li>
            <li>For repairs: a close-up of the damage, plus any leaks, damp, or movement you have noticed</li>
            <li>Property age and listed status, only if it applies</li>
          </ul>
        </div>

        <div class="mb-12">
          <h2 class="font-display text-2xl text-ink mb-4">What happens next</h2>
          <ol class="space-y-3 text-ink/70 list-decimal list-inside">
            <li><strong class="text-ink">Photo check</strong> - Rob looks at the photos and gives an initial view on likely scope.</li>
            <li><strong class="text-ink">Site visit</strong> - arranged if the job needs measuring up, structural inspection, or closer assessment.</li>
            <li><strong class="text-ink">Recommendation</strong> - a clear next step and price, whether that is new joinery, fitting, repair, or a wider carpentry package.</li>
          </ol>
        </div>

        <!-- Contact form -->
        <div id="contact-form" class="mb-12 p-6 lg:p-8 bg-bone rounded-lg scroll-mt-24">
          <h2 class="font-display text-2xl text-ink mb-2">Send a message</h2>
          <p class="text-ink/70 text-sm mb-6">Fill this in and it comes straight through to Rob. For photos, WhatsApp below is easiest.</p>

          <div data-form-banner="sent" hidden class="mb-6 p-4 rounded-md bg-patina/20 border border-patina text-ink">
            Thanks — your message has been sent. Rob will get back to you as soon as he can.
          </div>
          <div data-form-banner="error" hidden class="mb-6 p-4 rounded-md bg-rust/10 border border-rust text-ink">
            Sorry — something went wrong sending that. Please try again, or use phone or WhatsApp below.
          </div>

          <form method="POST" action="/api/contact" class="space-y-5">
            <div>
              <label for="name" class="block font-display text-sm text-ink mb-1">Name</label>
              <input type="text" id="name" name="name" required maxlength="200" autocomplete="name"
                class="w-full px-4 py-3 rounded-md border border-ink/20 bg-paper text-ink focus:outline-none focus:border-oak" />
            </div>
            <div>
              <label for="email" class="block font-display text-sm text-ink mb-1">Email</label>
              <input type="email" id="email" name="email" required maxlength="200" autocomplete="email"
                class="w-full px-4 py-3 rounded-md border border-ink/20 bg-paper text-ink focus:outline-none focus:border-oak" />
            </div>
            <div>
              <label for="message" class="block font-display text-sm text-ink mb-1">Message</label>
              <textarea id="message" name="message" required rows="6" maxlength="5000"
                class="w-full px-4 py-3 rounded-md border border-ink/20 bg-paper text-ink focus:outline-none focus:border-oak"></textarea>
            </div>

            <!-- Honeypot: hidden from humans, bots fill it in -->
            <div class="hidden" aria-hidden="true">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Cloudflare Turnstile bot check -->
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAD2hMGTTgLAaOgHC"></div>
            <p data-turnstile-hint hidden class="text-rust text-sm">
              Please complete the security check above before sending.
            </p>

            <button type="submit"
              class="inline-flex items-center justify-center bg-ink text-bone font-display px-8 py-4 text-base rounded-md hover:bg-oak transition-colors disabled:opacity-60">
              Send message
            </button>
          </form>
        </div>

        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <script is:inline>
          // Show success/error banner after redirect back (no-JS fallback path)
          var params = new URLSearchParams(window.location.search);
          var key = params.has('sent') ? 'sent' : params.has('error') ? 'error' : null;
          if (key) {
            var el = document.querySelector('[data-form-banner="' + key + '"]');
            if (el) el.hidden = false;
          }

          // Enhanced submit: never lose what the visitor has typed.
          // - Blocks submission until the Turnstile check is completed.
          // - Sends in the background; fields are only cleared on success.
          (function () {
            var form = document.querySelector('#contact-form form');
            if (!form || !window.fetch) return;
            var hint = document.querySelector('[data-turnstile-hint]');
            var sentBanner = document.querySelector('[data-form-banner="sent"]');
            var errorBanner = document.querySelector('[data-form-banner="error"]');
            var button = form.querySelector('button[type="submit"]');

            function show(banner) {
              if (sentBanner) sentBanner.hidden = banner !== sentBanner;
              if (errorBanner) errorBanner.hidden = banner !== errorBanner;
              if (banner) banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            function resetTurnstile() {
              try { if (window.turnstile) window.turnstile.reset(); } catch (e) {}
            }

            form.addEventListener('submit', function (e) {
              e.preventDefault();

              var tokenField = form.querySelector('[name="cf-turnstile-response"]');
              if (!tokenField || !tokenField.value) {
                if (hint) {
                  hint.hidden = false;
                  hint.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return; // nothing submitted, nothing lost
              }
              if (hint) hint.hidden = true;

              button.disabled = true;
              var label = button.textContent;
              button.textContent = 'Sending…';

              fetch(form.action, { method: 'POST', body: new FormData(form) })
                .then(function (res) {
                  if (res.url.indexOf('sent=1') !== -1) {
                    form.reset();
                    resetTurnstile();
                    show(sentBanner);
                  } else {
                    resetTurnstile();
                    show(errorBanner); // fields kept
                  }
                })
                .catch(function () {
                  resetTurnstile();
                  show(errorBanner); // fields kept
                })
                .finally(function () {
                  button.disabled = false;
                  button.textContent = label;
                });
            });
          })();
        </script>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Phone -->
          <div class="p-6 bg-bone rounded-lg">
            <h2 class="font-display text-lg text-ink mb-2">Phone</h2>
            <PhoneLink
              phone={phone.tel}
              display={phone.display}
              variant="primary"
              class="w-full justify-center"
            />
          </div>

          <!-- WhatsApp -->
          <div class="p-6 bg-bone rounded-lg">
            <h2 class="font-display text-lg text-ink mb-2">WhatsApp</h2>
            <WhatsAppCTA />
          </div>
        </div>

        <!-- Office hours -->
        <div class="p-6 bg-bone rounded-lg mb-12">
          <h2 class="font-display text-lg text-ink mb-4">Office hours</h2>
          <dl class="space-y-2">
            <div class="flex justify-between">
              <dt class="text-ink/70">Monday - Friday</dt>
              <dd class="text-ink">{hours.monday}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-ink/70">Saturday</dt>
              <dd class="text-ink">{hours.saturday}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-ink/70">Sunday</dt>
              <dd class="text-ink">{hours.sunday}</dd>
            </div>
          </dl>
        </div>

        <!-- Address -->
        <div class="p-6 bg-bone rounded-lg">
          <h2 class="font-display text-lg text-ink mb-2">Our workshop</h2>
          <p class="text-ink/70">
            {address.full || 'Address pending'}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
