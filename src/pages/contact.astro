---
/**
 * Contact page
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneLink from '../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../components/ui/WhatsAppCTA';
import { siteConfig } from '../config/site';

const { name, phone, whatsapp, address, email, hours } = siteConfig;
---

<BaseLayout title="Contact Us" description="Contact Heritage Joiners for repair-first timber window and door work across Yorkshire listed and period properties.">
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          Contact us
        </h1>
        <p class="text-lg text-ink/70 mb-8">
          Send photos first — it gets you a faster, more useful response than a phone call.
        </p>

        <div class="mb-12">
          <h2 class="font-display text-2xl text-ink mb-4">What to send</h2>
          <ul class="space-y-2 text-ink/70 list-disc list-inside">
            <li>Postcode and town</li>
            <li>Property type and approximate age</li>
            <li>Listed status if known</li>
            <li>One wide photo of each affected area</li>
            <li>One close-up photo of each defect</li>
            <li>Notes on any leaks, damp, or movement you have noticed</li>
          </ul>
        </div>

        <div class="mb-12">
          <h2 class="font-display text-2xl text-ink mb-4">What happens next</h2>
          <ol class="space-y-3 text-ink/70 list-decimal list-inside">
            <li><strong class="text-ink">Review</strong> — photos are checked and an initial view given on repair scope.</li>
            <li><strong class="text-ink">Survey</strong> — a site visit arranged if the scope needs it.</li>
            <li><strong class="text-ink">Recommendation</strong> — a clear repair or replacement option with honest reasoning.</li>
          </ol>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Phone -->
          <div class="p-6 bg-bone rounded-lg">
            <h2 class="font-display text-lg text-ink mb-2">Phone</h2>
            <PhoneLink
              phone={phone.tel}
              display={phone.display}
              variant="primary"
              class="w-full justify-center"
            />
          </div>

          <!-- WhatsApp -->
          <div class="p-6 bg-bone rounded-lg">
            <h2 class="font-display text-lg text-ink mb-2">WhatsApp</h2>
            <WhatsAppCTA client:load />
          </div>
        </div>

        <!-- Office hours -->
        <div class="p-6 bg-bone rounded-lg mb-12">
          <h2 class="font-display text-lg text-ink mb-4">Office hours</h2>
          <dl class="space-y-2">
            <div class="flex justify-between">
              <dt class="text-ink/70">Monday - Friday</dt>
              <dd class="text-ink">{hours.monday}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-ink/70">Saturday</dt>
              <dd class="text-ink">{hours.saturday}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-ink/70">Sunday</dt>
              <dd class="text-ink">{hours.sunday}</dd>
            </div>
          </dl>
        </div>

        <!-- Address -->
        <div class="p-6 bg-bone rounded-lg">
          <h2 class="font-display text-lg text-ink mb-2">Our workshop</h2>
          <p class="text-ink/70">
            {address.full || 'Address pending'}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
