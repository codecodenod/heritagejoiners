---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Windows', url: `${url}/services/windows` }];
const schemaProps = {
  description: 'Sash window repair, timber window repairs, draught proofing windows, and timber window restoration across Pontefract, Wakefield, and West Yorkshire.',
  url: `${url}/services/windows`,
  priceRange: '££',
};

const faqItems = [
  {
    question: 'How much does sash window repair cost?',
    answer:
      'Sash window repair cost, timber windows prices, wooden double glazed windows cost, and wooden window prices all vary by access, decay, glazing, and how much original fabric can stay.',
  },
  {
    question: 'What photos help with timber window repairs?',
    answer:
      'Clear photos of the full opening plus any damaged cills, rails, or boxes usually give enough information for Rob to give an honest first steer.',
  },
];

const windowServices = [
  'Timber window installation and bespoke timber windows',
  'Sash window installation and box sash windows',
  'Casement windows and period timber window work',
  'Bay window timber repairs and new sections',
  'Window sill and cill replacement',
  'Draught proofing windows and easing operation',
  'Secondary glazing in timber-led settings',
  'Period and sash window repair and restoration',
  'Internal timber shutters',
  'Timber window restoration for heritage properties',
];
---

<ServiceLayout
  title="Sash Window Repair in Pontefract & Wakefield"
  description="Sash window repair, timber window repairs, draught proofing windows, and timber window restoration across Pontefract, Wakefield and West Yorkshire."
  serviceName="Windows"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}

  ogImage="/images/homepage/timber-sash-window-stone-surround.webp"
>
  <FAQPageSchema slot="schema" faqs={faqItems} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Timber windows and sash work</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Sash Window Repair in Pontefract, Wakefield &amp; West Yorkshire</h1>
        <p class="text-lg text-ink/70 mb-8">
          Rob covers sash window repair, timber window repairs, wooden window repair, and full timber window restoration across West Yorkshire. The work starts with condition: cords, pulleys, staff beads, cills, rails, boxes, glazing beds and draughts all tell you what the window needs.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a timber window job" />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Timber window repairs and restoration</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {windowServices.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Wooden window repair before replacement</h2>
        <p class="text-ink/70 mb-3">
          The business carries a strong repair-first timber background. If the sash box, cill, rail, or frame still has enough sound timber, Rob will usually look for a repair route before replacing more than necessary.
        </p>
        <p class="text-ink/70 mb-3">
          If not, the answer is sympathetic timber replacement, set out and detailed properly for the building.
        </p>
        <p class="text-ink/70">
          Not sure whether your existing windows can be saved? Read our guide on <a href="/blog/can-timber-windows-be-repaired" class="text-oak underline">whether timber windows can be repaired, restored or replaced</a>.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Draught proofing windows and comfort</h2>
        <p class="text-ink/70 mb-3">
          Many people searching for timber window repairs are really trying to solve draughts, failed cords, rattles, or windows that no longer open cleanly. Draught-proofing, easing, correct setting out, and secondary glazing often solve that without changing the look of the building.
        </p>
        <p class="text-ink/70">
          Window work follows the same rule as every heritage joinery decision: keep what is sound, replace only what has genuinely failed, and make the new timber sit properly with the building.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Sash window repair questions</h2>
      {faqItems.map((faq) => (
        <div class="mb-6 last:mb-0">
          <h3 class="font-display text-xl lg:text-2xl text-ink mb-2">{faq.question}</h3>
          <p class="text-ink/70">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Timber window repairs across West Yorkshire</h2>
      <p class="text-ink/70">
        Window work is available across <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, <a href="/areas/normanton" class="text-oak underline">Normanton</a>, <a href="/areas/leeds" class="text-oak underline">Leeds</a>, and selected heritage jobs across wider <a href="/areas/yorkshire" class="text-oak underline">Yorkshire</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need a timber window assessed?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos of the full window, the sill, and any failed joints and Rob will tell you whether repair looks viable.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a timber window job" />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
