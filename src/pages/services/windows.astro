---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Windows', url: `${url}/services/windows` }];
const schemaProps = {
  description: 'Sash window repair, timber window repairs, draught proofing windows, and timber window restoration across Pontefract, Wakefield, and West Yorkshire.',
  url: `${url}/services/windows`,
  priceRange: '££',
};

const faqItems = [
  {
    question: 'How much does sash window repair cost?',
    answer:
      'Sash window repair cost, timber windows prices, wooden double glazed windows cost, and wooden window prices all vary by access, decay, glazing, and how much original fabric can stay.',
  },
  {
    question: 'What photos help with timber window repairs?',
    answer:
      'Clear photos of the full opening plus any damaged cills, rails, or boxes usually give enough information for Rob to give an honest first steer.',
  },
];

const windowServices = [
  'Timber window installation and bespoke timber windows',
  'Sash window installation and box sash windows',
  'Casement windows and period timber window work',
  'Bay window timber repairs and new sections',
  'Window sill and cill replacement',
  'Draught proofing windows and easing operation',
  'Secondary glazing in timber-led settings',
  'Period and sash window repair and restoration',
  'Internal timber shutters',
  'Timber window restoration for heritage properties',
];
---

<ServiceLayout
  title="Sash Window Repair in Pontefract & Wakefield"
  description="Sash window repair, timber window repairs, draught proofing windows, and timber window restoration across Pontefract, Wakefield and West Yorkshire."
  serviceName="Windows"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}

  ogImage="/images/services/windows/yorkshire-stone-building-timber-sash-windows.webp"
>
  <FAQPageSchema slot="schema" faqs={faqItems} />

  <!-- Hero: timber sash windows on a Yorkshire stone building, with fade for
       text legibility. Same pattern as the doors page. -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/services/windows/yorkshire-stone-building-timber-sash-windows.webp"
      alt="Timber sash windows in a Yorkshire gritstone building at golden hour, with open countryside beyond"
      width="2880"
      height="1440"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
        <p class="text-oak uppercase tracking-wide mb-4">Timber windows and sash work</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Sash Window Repair in Pontefract, Wakefield &amp; West Yorkshire</h1>
        <p class="text-lg text-ink/80 mb-8">
          Rob covers sash window repair, timber window repairs, wooden window repair, and full timber window restoration across West Yorkshire. The work starts with condition: cords, pulleys, staff beads, cills, rails, boxes, glazing beds and draughts all tell you what the window needs.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a timber window job" />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Timber window repairs and restoration</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {windowServices.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Wooden window repair before replacement</h2>
        <p class="text-ink/70 mb-3">
          The business carries a strong repair-first timber background. If the sash box, cill, rail, or frame still has enough sound timber, Rob will usually look for a repair route before replacing more than necessary.
        </p>
        <p class="text-ink/70 mb-3">
          If not, the answer is sympathetic timber replacement, set out and detailed properly for the building.
        </p>
        <p class="text-ink/70">
          Not sure whether your existing windows can be saved? Read our guide on <a href="/blog/can-timber-windows-be-repaired" class="text-oak underline">whether timber windows can be repaired, restored or replaced</a>.
        </p>

        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4 mt-10">Draught proofing windows and comfort</h2>
        <p class="text-ink/70 mb-3">
          Many people searching for timber window repairs are really trying to solve draughts, failed cords, rattles, or windows that no longer open cleanly. Draught-proofing, easing, correct setting out, and secondary glazing often solve that without changing the look of the building.
        </p>
        <p class="text-ink/70">
          Window work follows the same rule as every heritage joinery decision: keep what is sound, replace only what has genuinely failed, and make the new timber sit properly with the building. On a recent commercial job we kept all eleven windows on a Pontefract office rather than replacing any of them &mdash; see the <a href="/case-studies/dunster-windows" class="text-oak underline">timber window refurbishment case study</a>.
        </p>
      </div>
      <div class="space-y-8">
        <img
          src="/images/blog/timber-window-repair/damaged-wooden-window-sill-before-repair.webp"
          alt="Damaged wooden window sill showing decay before a timber repair"
          width="640"
          height="480"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <img
          src="/images/homepage/timber-sash-window-stone-surround.webp"
          alt="White-painted timber sash window set in a stone surround"
          width="800"
          height="533"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Casement window repair</h2>
        <p class="text-ink/70 mb-3">
          Casement windows &mdash; the ones hinged at the side or top that swing open &mdash; nearly always fail in the same place. Water sits along the bottom rail, the paint film breaks somewhere nobody notices, and the timber underneath goes soft while the stiles, the top rail and the glazing are all still perfectly sound.
        </p>
        <p class="text-ink/70 mb-3">
          That is a repair, not a replacement. The failed section is cut back to firm timber and new timber is let in to match, following the existing profile, with the glazing and the rest of the casement left alone. It is the same judgement as a <a href="/blog/rotten-timber-window-sill-repair-pontefract" class="text-oak underline">rotten window sill</a> &mdash; what matters is how much sound timber is left to join onto.
        </p>

        <h3 class="font-display text-xl lg:text-2xl text-ink mb-3 mt-8">The customer thought this listed window needed replacing</h3>
        <p class="text-ink/70 mb-3">
          A recent job on a Grade II listed cottage on Carr Bottom Road in Greengates, Bradford. The owner had already decided the window was past saving and was expecting to pay for a replacement.
        </p>
        <p class="text-ink/70 mb-3">
          Inspection said otherwise. The decay was confined to the bottom rail of the opening casement. Everything above it was sound, including the original leaded glazing.
        </p>
        <p class="text-ink/70 mb-3">
          So the casement came off its hinges and went flat. The rot was cut back to firm timber, new timber was cut to fit the gap it left and let in along the rail, and the profile was carried through so the repair reads as part of the window rather than a patch. The glazing never came out. The casement went back on its hinges, back on its stay and back into use, and once it was painted you cannot pick out where the repair is.
        </p>
        <p class="text-ink/70">
          The full job is written up in <a href="/blog/listed-casement-window-repair-bradford" class="text-oak underline">listed casement window repair in Bradford</a>, including what needs consent and what does not. On a listed building that distinction matters beyond the cost. Bradford Council's guidance states that &ldquo;the replacement of a door or window will always require Listed Building Consent, as this would be classed as an alteration rather than repair&rdquo;, and the council's stated approach is to &ldquo;repair rather than replace the original fabric of the building&rdquo;. What needs consent varies with the building and with what is proposed, so anything you are unsure about is worth confirming with the council's conservation team before work starts.
        </p>
      </div>
      <div class="space-y-8">
        <img
          src="/images/services/windows/rotten-timber-cut-out-of-casement-window-greengates.webp"
          alt="Rotten timber chiselled out of the bottom rail of a casement window during repair in Greengates, Bradford"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <img
          src="/images/services/windows/new-timber-splice-let-into-casement-bottom-rail.webp"
          alt="New timber let into the bottom rail of a casement window alongside the retained original timber"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <img
          src="/images/services/windows/repaired-casement-window-refitted-before-decoration.webp"
          alt="Repaired casement window refitted and opening on its stay, new timber visible before decoration"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Sash window repair questions</h2>
      {faqItems.map((faq) => (
        <div class="mb-6 last:mb-0">
          <h3 class="font-display text-xl lg:text-2xl text-ink mb-2">{faq.question}</h3>
          <p class="text-ink/70">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Timber window repairs across West Yorkshire</h2>
      <p class="text-ink/70">
        Window work is available across <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, <a href="/areas/normanton" class="text-oak underline">Normanton</a>, <a href="/areas/leeds" class="text-oak underline">Leeds</a>, and selected heritage jobs across wider <a href="/areas/yorkshire" class="text-oak underline">Yorkshire</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need a timber window assessed?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos of the full window, the sill, and any failed joints and Rob will tell you whether repair looks viable.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a timber window job" />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
