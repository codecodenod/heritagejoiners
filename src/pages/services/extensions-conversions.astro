---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Loft Conversions', url: `${url}/services/extensions-conversions` }];
const schemaProps = {
  description: 'Complete loft conversions across Pontefract, Wakefield and West Yorkshire — structure, roof, dormers, staircase, plastering, electrics, plumbing and finishing.',
  url: `${url}/services/extensions-conversions`,
  priceRange: '£££',
};

const faqItems = [
  {
    question: 'Do you carry out the whole loft conversion, or just the carpentry?',
    answer:
      'The whole conversion. Heritage Joiners takes the job from the first survey through to a finished room you can move into — the structural work and steels, the roof alterations, the dormer or rooflights, the new floor, the staircase, insulation, plasterboarding and plastering, the electrics, the plumbing if there is an ensuite, and all of the joinery and finishing. We have the full team of trades for it, so you deal with one person for the whole project rather than coordinating six.',
  },
  {
    question: 'Does a loft conversion need planning permission?',
    answer:
      'Often not. Many loft conversions are permitted development, where the Planning Portal sets a volume allowance of 40 cubic metres of additional roof space on a terraced house and 50 cubic metres on a detached or semi-detached house, including anything a previous owner added. The roof must not go above the existing ridge. There are important exceptions: permitted development does not apply on designated land such as conservation areas, it does not apply to flats or maisonettes, and an Article 4 Direction can remove the rights altogether. We check the position for your specific property before any design work starts, and apply for permission where it is needed.',
  },
  {
    question: 'Does a loft conversion need Building Regulations approval?',
    answer:
      'Yes, always, with no exceptions — that is separate from planning permission and it applies even when the conversion is permitted development. Building Control inspect the work at stages and issue a completion certificate at the end, which you will need when you come to sell. We deal with the application and the inspections as part of the job.',
  },
  {
    question: 'What stops a loft from being converted?',
    answer:
      'Head height is the usual one. You need enough height for a habitable room once the new floor and the insulated roof build-up have taken their share, and that gets measured before anything is promised. After that it is where the staircase can land, because the stairs have to come off a landing and meet the headroom rules, and a loft that works structurally can still be awkward if there is nowhere sensible to put the stairs. Modern trussed roofs need more structural work than older cut roofs, but they are converted all the time. We will tell you plainly if a loft is not worth converting.',
  },
  {
    question: 'Do I need an architect and a structural engineer?',
    answer:
      'A structural engineer, almost always — the new floor and any steels carrying the roof need calculating and signing off, and Building Control will expect those calculations. An architect is not always necessary for a straightforward conversion, though drawings are needed for the Building Regulations application and for planning if it is required. We arrange the design and engineering as part of the project, so it is not something you have to go and organise separately.',
  },
  {
    question: 'How long does a loft conversion take?',
    answer:
      'From first survey to finished room it is usually a matter of weeks rather than days, and the honest answer depends on the type of conversion, the design and approvals stage before anything starts on site, and whether an ensuite is going in. A rooflight conversion is quicker than a dormer, and a dormer is quicker than a hip-to-gable. We give you a programme at the quote stage and tell you where the waiting is, because most of the unpredictable time sits with approvals rather than the building work.',
  },
];

const loftServices = [
  'Complete loft conversions, managed from survey to finished room',
  'Dormer loft conversions, including rear and double dormers',
  'Velux and rooflight loft conversions',
  'Hip-to-gable loft conversions',
  'Mansard conversions and bungalow loft conversions',
  'Trussed roof conversions and structural alterations',
  'Steels, new floor structures and load-bearing work',
  'Staircases, landings and balustrades made and fitted',
  'Insulation, plasterboarding and plastering',
  'Electrics, lighting and plumbing for loft ensuites',
  'Rooflights, dormer windows and external finishes',
  'Building Regulations applications and Building Control sign-off',
];
---

<ServiceLayout
  title="Loft Conversions in Pontefract & Wakefield"
  description="Complete loft conversions across Pontefract, Wakefield and West Yorkshire. We handle the structure, roof, dormers, staircase, plastering, electrics and finishing."
  serviceName="Loft Conversions"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
  ogImage="/images/services/extensions-conversions/loft-conversion-large-dormer-window-exterior.webp"
>
  <FAQPageSchema slot="schema" faqs={faqItems} />

  <!-- Hero: same pattern as the doors page. -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/services/extensions-conversions/loft-conversion-large-dormer-window-exterior.webp"
      alt="Large rear dormer loft conversion seen from outside, tiled and finished into the existing roof"
      width="1672"
      height="941"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
          <p class="text-oak uppercase tracking-wide mb-4">Complete loft conversions</p>
          <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Loft Conversions in Pontefract, Wakefield &amp; West Yorkshire</h1>
          <p class="text-lg text-ink/80 mb-8">
            Heritage Joiners takes on complete loft conversions &mdash; the whole project, not one trade of it. Structure and steels, the roof and the dormer, the staircase, insulation and plastering, electrics and plumbing, through to the joinery and the finish. One team, one point of contact, and a room you can move into at the end of it.
          </p>
          <div class="flex flex-wrap gap-4">
            <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a loft conversion" />
            <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
          </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">What a complete loft conversion includes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {loftServices.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Loft conversion builders who do the whole job</h2>
        <p class="text-ink/70 mb-3">
          The thing that goes wrong with a loft conversion is rarely the carpentry. It is the gaps between trades &mdash; the electrician who turns up before the plasterboard is on, the plumber who needs a wall that nobody has built yet, the stair that was ordered before anyone checked where it lands.
        </p>
        <p class="text-ink/70 mb-3">
          We run the whole thing. Heritage Joiners has the full team for a loft conversion, so the structural work, the roofing, the plastering, the electrics, the plumbing and the joinery are all sequenced by one person who knows what has to happen next. You get one number to ring and one person answerable for the job.
        </p>
        <p class="text-ink/70">
          The joinery side of it is Rob's own trade. He is a fully qualified apprentice trained bench hand joiner, time served, with over 35 years in workshops and on site &mdash; which is why the staircase, the balustrade, the eaves storage and the trim in a Heritage Joiners loft are made to fit the room rather than bought in a size that nearly does.
        </p>
      </div>
      <div>
        <img
          src="/images/services/extensions-conversions/loft-conversion-staircase-and-landing-balustrade.webp"
          alt="Timber staircase and landing balustrade fitted in a finished loft conversion"
          width="1672"
          height="941"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <p class="text-ink/60 text-sm mt-3">
          The staircase and landing balustrade in a finished conversion &mdash; made and fitted rather than ordered in.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Types of loft conversion</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-ink/70 mb-3">
            <strong class="text-ink"><a href="/services/dormer-loft-conversions" class="text-oak underline">Dormer loft conversion</a>.</strong> A box built out from the roof slope, giving full head height and a flat ceiling across most of the new room. It is the conversion that adds the most usable space, and on a terraced or semi-detached house a rear dormer is usually the one that makes an unusable loft into a proper bedroom.
          </p>
          <p class="text-ink/70 mb-3">
            <strong class="text-ink"><a href="/services/velux-loft-conversions" class="text-oak underline">Velux or rooflight conversion</a>.</strong> No change to the shape of the roof &mdash; rooflights go into the existing slope and the work happens inside. It is the quickest and least disruptive option, and the one least likely to need planning permission, but it only works where the loft already has the head height.
          </p>
          <p class="text-ink/70 mb-3">
            <strong class="text-ink"><a href="/services/hip-to-gable-loft-conversions" class="text-oak underline">Hip-to-gable</a>.</strong> On a house with a hipped roof, the sloping end is built up square to form a gable, which turns a cramped triangular loft into a usable rectangular one. Often combined with a rear dormer on a 1930s semi.
          </p>
          <p class="text-ink/70">
            <strong class="text-ink">Mansard and bungalow conversions.</strong> A mansard reconstructs the roof with a steep near-vertical slope to maximise the space, and is the biggest structural option. Bungalow conversions are a different proposition again, because converting the loft makes it a two-storey house and the fire and escape requirements change with it.
          </p>
        </div>
        <div>
          <img
            src="/images/services/extensions-conversions/loft-conversion-large-dormer-window-interior.webp"
            alt="Inside a finished dormer loft conversion with a large dormer window and full head height"
            width="1672"
            height="941"
            loading="lazy"
            class="w-full h-auto rounded-xl shadow-lg mb-3"
          />
          <img
            src="/images/services/extensions-conversions/loft-conversion-timber-balustrade-and-eaves-storage.webp"
            alt="Timber balustrade and built-in eaves storage in a completed loft conversion"
            width="1672"
            height="941"
            loading="lazy"
            class="w-full h-auto rounded-xl shadow-lg"
          />
          <p class="text-ink/60 text-sm mt-3">
            Inside the same dormer conversion, and the eaves storage built into the low part of the room where the headroom runs out.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Design, structural engineer and Building Control</h2>
        <p class="text-ink/70 mb-3">
          A loft conversion is a structural job and it is approved as one. The new floor has to carry a room rather than a ceiling, and where the roof load is taken off the existing structure it usually needs steels, which have to be calculated and signed off by a structural engineer. We arrange the design and the engineering as part of the project rather than leaving you to organise it.
        </p>
        <p class="text-ink/70 mb-3">
          <strong class="text-ink">Building Regulations approval is always required</strong>, with no exceptions, and it is separate from planning permission. Building Control inspect at stages and issue a completion certificate at the end &mdash; the document you will be asked for when you sell the house. We handle the application and the inspections.
        </p>
        <p class="text-ink/70">
          <strong class="text-ink">Planning permission often is not required.</strong> Many conversions fall under permitted development, where the Planning Portal sets an allowance of 40 cubic metres of extra roof space on a terraced house and 50 cubic metres on a detached or semi-detached one, counting anything a previous owner added, with the new roof no higher than the existing ridge. It does not apply on designated land such as conservation areas, and an Article 4 Direction can remove the rights. Rules change and every property is different, so we confirm the position for yours before any design work begins rather than relying on a general answer.
        </p>
      </div>
      <div>
        <img
          src="/images/services/extensions-conversions/loft-conversion-interior-with-roof-window.webp"
          alt="Finished loft conversion interior lit by a roof window in the sloping ceiling"
          width="941"
          height="1672"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Stairs, fire and head height</h2>
        <p class="text-ink/70 mb-3">
          Three things shape the design of almost every loft conversion, and they are worth understanding before you fall in love with a layout.
        </p>
        <p class="text-ink/70 mb-3">
          <strong class="text-ink">Head height</strong> decides whether the loft is convertible at all. What matters is the height left once the new floor structure and the insulated roof build-up have taken their share, not what you can stand up in today.
        </p>
        <p class="text-ink/70 mb-3">
          <strong class="text-ink">The staircase</strong> has to come off an existing landing, meet the pitch and headroom rules in Approved Document K, and land somewhere that does not ruin the room below. Approved Document K allows a reduced headroom over a loft stair where space is tight, which is often what makes a difficult loft work. It is frequently the stair, not the roof, that sets the whole layout.
        </p>
        <p class="text-ink/70">
          <strong class="text-ink">Fire escape</strong> changes what the rest of the house needs. Converting the loft of a two-storey house normally means forming a protected stairway down to the front door, with fire doors to the rooms off it and mains-wired alarms, rather than relying on an escape window. A bungalow is treated differently again. These are the requirements as they are generally applied &mdash; the specification for your house is confirmed with Building Control as part of the application.
        </p>
      </div>
      <div>
        <img
          src="/images/services/extensions-conversions/loft-conversion-shaped-doorway-and-landing.webp"
          alt="Shaped doorway and landing formed at the top of a loft conversion staircase"
          width="1672"
          height="941"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <p class="text-ink/60 text-sm mt-3">
          The head of the stairs, with the doorway shaped to the roofline rather than squared off and boxed in.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Extensions, garage conversions and structural timber</h2>
      <p class="text-ink/70 mb-3">
        Loft conversions are the main part of this service, but the same team and the same structural carpentry take on extensions, garage conversions, timber frame construction and structural openings. Where a job is really a structural timber problem rather than a conversion, <a href="/services/loft-conversion-costs" class="text-oak underline">what drives the cost of a loft conversion</a> sets out what moves the price, and <a href="/services/first-fix-carpentry" class="text-oak underline">first fix carpentry</a> covers joists, partitions and floor structures, and <a href="/services/timber-repair" class="text-oak underline">timber repair</a> covers decayed beams and roof timbers.
      </p>
      <p class="text-ink/70">
        If it is storage you are after rather than a habitable room, that is a much smaller job &mdash; see <a href="/blog/loft-boarding-south-kirkby" class="text-oak underline">boarding a loft for storage in South Kirkby</a>, where a new timber floor went in over the ceiling joists without the loft becoming a conversion. A <a href="/services/staircases" class="text-oak underline">staircase</a> for a finished loft, and the <a href="/services/roofing-carpentry" class="text-oak underline">roof carpentry</a> behind a dormer, are both covered in more detail on their own pages.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Loft conversion questions</h2>
      {faqItems.map((faq) => (
        <div class="mb-6 last:mb-0">
          <h3 class="font-display text-xl lg:text-2xl text-ink mb-2">{faq.question}</h3>
          <p class="text-ink/70">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Loft conversion builders across West Yorkshire</h2>
      <p class="text-ink/70">
        Complete loft conversions, extensions and structural carpentry are available across <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, <a href="/areas/normanton" class="text-oak underline">Normanton</a>, and <a href="/areas/leeds" class="text-oak underline">Leeds</a>, with selected larger projects across wider <a href="/areas/yorkshire" class="text-oak underline">Yorkshire</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Thinking about converting your loft?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send a few photos of the loft, the landing below it and the outside of the house, and Rob will give you an honest first view on whether it converts and what it would involve.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a loft conversion" />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
