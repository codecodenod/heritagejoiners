---
/**
 * Doors and Frames service page
 */
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Doors & Frames', url: `${url}/services/doors-and-frames` }];
const schemaProps = {
  description: 'Repair-first timber door and frame repair across Pontefract, Wakefield, and Yorkshire for period and listed properties.',
  url: `${url}/services/doors-and-frames`,
  priceRange: '££',
};

const doorTypes = [
  'External Georgian, Victorian, and Edwardian doors',
  'Cottage doors and period ledged doors',
  'Door frame, lining, sill, and threshold repairs',
  'Lower rail, stile, and panel repairs',
  'Architraves and local trim repairs',
  'Door furniture, locks, hinges, and ironmongery',
  'Weatherstripping and fit adjustment',
  'Period-accurate replacement where repair is not sound',
];
---

<ServiceLayout
  title="Timber Door Repair in Pontefract"
  description="Repair-first timber door and frame work across Pontefract, Wakefield and Yorkshire. Period doors, external doors, frames and linings repaired first."
  serviceName="Doors & Frames"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Repair-first door work</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Doors &amp; Frames</h1>
        <p class="text-lg text-ink/70 mb-8">
          We repair timber doors and frames wherever the original timber can carry a sound repair. Where replacement is genuinely the right answer, we source or manufacture period-accurate alternatives.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">What we do</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {doorTypes.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">How we decide repair vs replacement</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="p-5 bg-paper rounded-lg"><h3 class="font-display text-xl text-ink">Retain</h3><p class="text-sm text-ink/70">Adjust, ease, refit, or renew hardware when the door and frame remain sound.</p></div>
        <div class="p-5 bg-paper rounded-lg"><h3 class="font-display text-xl text-ink">Splice</h3><p class="text-sm text-ink/70">Cut out local decay in lower rails, stiles, thresholds, or frame sections.</p></div>
        <div class="p-5 bg-paper rounded-lg"><h3 class="font-display text-xl text-ink">Partial</h3><p class="text-sm text-ink/70">Replace a component when one part has failed but the wider door set can stay.</p></div>
        <div class="p-5 bg-paper rounded-lg"><h3 class="font-display text-xl text-ink">Replace</h3><p class="text-sm text-ink/70">Make or source a sympathetic replacement when too little sound timber remains.</p></div>
      </div>
      <p class="text-ink/70 mt-8">
        Door stiles and lower rails fail differently from sash boxes. The same repair-first principle applies, but the trigger points are different. <a href="/repair-or-replace" class="text-oak underline">Read the full framework</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Typical cost bands</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£80-£150</p><p class="text-sm text-ink/70">Site assessment</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£180-£350</p><p class="text-sm text-ink/70">Small local repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£350-£900</p><p class="text-sm text-ink/70">Standard frame/door repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£900+</p><p class="text-sm text-ink/70">Complex or multiple sections</p></div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-ink text-bone">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl mb-4">Before replacing the whole frame</h2>
      <p class="text-bone/70 mx-auto">
        Full replacement can disturb thresholds, plaster, reveals, paint, stone, and ironmongery. A targeted door or frame repair often preserves more original character and avoids unnecessary making-good.
      </p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-6">The Counting House includes period door and frame work relevant to listed and historic buildings.</p>
      <a href="/case-studies/counting-house/timber-doors" class="text-oak font-display">View timber door case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Coverage</h2>
      <p class="text-ink/70">
        Pontefract-based, working first across WF postcodes: <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, Knottingley, and Normanton. We also travel further across Yorkshire for Leeds, York, and selected listed or period projects.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need a door or frame assessed?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos first and we will tell you whether repair looks viable.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
