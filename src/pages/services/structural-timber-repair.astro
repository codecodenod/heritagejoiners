---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Structural Timber Repair', url: `${url}/services/structural-timber-repair` }];
const schemaProps = {
  description: 'Structural timber repairs for listed and period buildings across Yorkshire: beams, joists, rafters, purlins, and timber frames.',
  url: `${url}/services/structural-timber-repair`,
  priceRange: '£££',
};

const repairItems = [
  'Oak and softwood beam repair and splicing',
  'Joist end repair at decayed bearing points',
  'Rafter and purlin repairs — localised and extended',
  'Wall plate repair and consolidation',
  'Timber frame member repair — posts, rails, braces',
  'Floor structure stabilisation and sister-joist work',
  'Epoxy consolidation where conditions allow',
  'Scarf and splice joints for load-bearing continuity',
  'Structural assessment in conjunction with engineers',
  'Liaison with conservation officers on consent matters',
];

const faqs = [
  {
    question: 'Do I need a structural engineer for timber beam repairs?',
    answer: 'It depends on the extent and location of the decay. For surface or localised rot on a supported beam, a structural engineer may not be needed. Where load-bearing continuity is in question — a heavily decayed purlin, a wall plate carrying rafters, or a major floor joist — we advise involving a structural engineer before proceeding. We can work alongside your engineer or recommend one if needed.',
  },
  {
    question: 'Can structural timber in a listed building be repaired rather than replaced?',
    answer: 'In most cases, yes. Scarf joints and splice repairs to sound parent timber have been used on historic structures for centuries. Conservation guidance supports minimal-intervention repair over unnecessary replacement. Full replacement is sometimes right — particularly where decay has progressed through critical load-bearing zones — but it is not the default.',
  },
  {
    question: 'How do you assess a structural timber for repair viability?',
    answer: 'We use a combination of probing (a sharp tool or bradawl to test surface hardness), a moisture meter to identify active wet conditions, and visual inspection of joints and end-grain. Where access is limited we recommend opening up to get an honest picture rather than guessing. A guessed assessment on structural timber is not safe.',
  },
  {
    question: 'What causes structural timber decay in period buildings?',
    answer: 'Almost always moisture. The route may be a failed roof covering, a blocked gutter or hopper, condensation in a poorly ventilated roof void, or rising damp at a wall plate or sole plate. We will not repair timber without identifying and addressing the moisture source — a repair on wet timber will fail.',
  },
];
---

<ServiceLayout
  title="Structural Timber Repair for Period Buildings"
  description="Structural timber repairs for listed and period properties: beams, joists, rafters and purlins. Repair-first with clear replacement thresholds."
  serviceName="Structural Timber Repair"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
>
  <FAQPageSchema slot="schema" faqs={faqs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Structural timber specialists</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          Structural Timber Repair for Listed &amp; Period Buildings
        </h1>
        <p class="text-lg text-ink/70 mb-8">
          Beams, joists, rafters, purlins, wall plates, timber frames. The structural timber in a period or listed building is often centuries old, denser than modern equivalents, and worth repairing rather than replacing. We assess what can be soundly retained, splice or scarf where repair is viable, and recommend replacement only when structural integrity demands it.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">What we repair</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {repairItems.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">When repair is viable</h2>
        <p class="text-ink/70 mb-3">
          Localised decay at beam ends, joist bearings, or rafter tails — the most common failure points — can usually be cut back to sound timber and scarfed with new material. The scarf joint transfers loads appropriately and, when sized and positioned correctly, restores full structural function.
        </p>
        <p class="text-ink/70">
          Epoxy consolidation is appropriate in selected cases where the timber is substantially sound but has lost surface integrity and where moisture causes have been permanently addressed.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">When we recommend replacement</h2>
        <p class="text-ink/70 mb-3">
          Where decay has run through the majority of a member, where load-bearing zones have failed across critical cross-sections, or where previous repair attempts have already been made and failed, replacement is the honest answer. We source period-appropriate timber where replacement is required — straight-grained, correct species, correct section dimensions.
        </p>
        <a href="/services/when-repair-is-not-viable" class="text-oak underline">When we recommend replacement &rarr;</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Diagnostic process</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="p-5 bg-paper rounded-lg">
          <p class="font-display text-oak text-lg mb-2">1. Photos</p>
          <p class="text-ink/70 text-sm">Send photos of the affected timber. We can usually form a preliminary view on severity and likely repair approach from clear images.</p>
        </div>
        <div class="p-5 bg-paper rounded-lg">
          <p class="font-display text-oak text-lg mb-2">2. Site inspection</p>
          <p class="text-ink/70 text-sm">On-site probing, moisture reading, and assessment of load paths. We assess what is accessible and advise where opening up is needed for a safe picture.</p>
        </div>
        <div class="p-5 bg-paper rounded-lg">
          <p class="font-display text-oak text-lg mb-2">3. Recommendation</p>
          <p class="text-ink/70 text-sm">Written repair-or-replace recommendation per element, with cost band indication and any structural-engineer or consent advice.</p>
        </div>
        <div class="p-5 bg-paper rounded-lg">
          <p class="font-display text-oak text-lg mb-2">4. Repair</p>
          <p class="text-ink/70 text-sm">Works carried out once moisture cause is addressed. Finish to blend with surrounding fabric where exposed timber is visible.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Listed building and consent notes</h2>
      <p class="text-ink/70 mb-4">
        Repair to existing structural fabric generally does not require listed building consent; replacement of a structural element may. Where we recommend replacement of a significant member, we advise the owner to confirm the consent position with the local conservation officer before work begins.
      </p>
      <p class="text-ink/70">
        Conservation guidance — Historic England's <em>Practical Building Conservation</em> series and BS 7913 — supports minimal-intervention, significance-led decision making. Our structural repair approach is consistent with that guidance.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Typical cost bands</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£80–£150</p><p class="text-sm text-ink/70">Site assessment</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£350–£900</p><p class="text-sm text-ink/70">Standard structural repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£900+</p><p class="text-sm text-ink/70">Complex or multi-member</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">Survey-led</p><p class="text-sm text-ink/70">Major structural programmes</p></div>
      </div>
      <p class="text-ink/70 text-sm">Structural repair costs vary considerably by accessibility, member size, and extent of decay. We give honest cost-band indications after the site assessment — we do not provide fixed prices before seeing the timber.</p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Frequently asked questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-ink/10 pb-6">
            <h3 class="font-display text-xl text-ink mb-2">{faq.question}</h3>
            <p class="text-ink/70">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Coverage</h2>
      <p class="text-ink/70">
        Pontefract-based, covering WF postcodes first: <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, <a href="/areas/normanton" class="text-oak underline">Normanton</a>. We travel for significant structural timber projects across <a href="/areas/yorkshire" class="text-oak underline">Yorkshire</a>, including <a href="/areas/leeds" class="text-oak underline">Leeds</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Related services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/oak-beam-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Oak Beam Repair</a>
        <a href="/services/roof-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Roof Timber Repair</a>
        <a href="/services/floor-joist-and-floorboard-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Floor Joist &amp; Floorboard Repair</a>
        <a href="/services/timber-frame-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Frame Repair</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/repair-or-replace" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Repair or Replace? Framework</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Concerned about a structural timber?</h2>
      <p class="text-ink/70 mb-8 max-w-2xl mx-auto">Send photos of the affected area — showing the timber, any visible decay, and the surrounding context. We will advise on whether an immediate site visit is needed.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
