---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Timber Repair & Restoration', url: `${url}/services/timber-repair` }];
const schemaProps = {
  description: 'Timber repair, wood rot repair, wet rot repair, dry rot repair, splice repair, and timber restoration across Pontefract, Wakefield, and West Yorkshire.',
  url: `${url}/services/timber-repair`,
  priceRange: '£££',
};

const faqItems = [
  {
    question: 'What does a timber repair job involve?',
    answer:
      'Four things, in order. Finding where the water is getting in, because a repair that leaves the cause in place will fail the same way. Establishing how far the decay has actually gone, by pressing the timber back to where it is firm. Deciding between a filled defect and a cut repair, which depends entirely on whether there is sound timber to key into. Then cutting the new timber in, matching the section and the grain direction, and protecting it. What changes the size of the job is how much has gone, whether the section is structural, and how much of the surrounding joinery has to come apart to reach it.',
  },
  {
    question: 'Can you repair rotting wood without replacing it?',
    answer:
      'Usually, yes, and more often than people are told. Decay tends to be local — a sill corner, a bottom rail, a beam end, the foot of a post — while the rest of the timber is still sound. If there is firm timber to join onto, the failed section is cut out and new timber is let in to replace exactly what was lost. It stops being viable when decay has gone through the structural cross-section, when a member has lost its strength along its whole length, or when previous poor repairs have left too little original material to work from.',
  },
  {
    question: 'What is the difference between wet rot and dry rot?',
    answer:
      'Both are fungal decay and both need water, but they behave differently. Wet rot stays where the moisture is — it rots the wet timber and goes no further, so it is usually confined to the obvious place, like a sill or a joist end near a leak. Dry rot can spread through masonry and travel into timber away from the original damp, which makes it the more serious of the two to find and the more important to identify properly. In both cases the first job is the same: stop the water. Treatment alone does not put strength back into timber that has already decayed.',
  },
  {
    question: 'What is a splice repair?',
    answer:
      'Cutting out the failed section of a timber back to firm material and letting a new piece in to replace it, so the repair becomes part of the member rather than something stuck onto it. Where the geometry suits it, a long angled joint — a scarf — gives more glue area and more bearing than a square butt, and keeps the join off a single line across the section. The new timber has to be at least as durable as what it is going into, has to follow the existing profile, and has to run with the grain the same way so old and new move together.',
  },
  {
    question: 'Can a rotten door frame or window sill be repaired?',
    answer:
      'Both are among the most common timber repairs there are, and both rot in predictable places — the bottom of the jamb where it meets the threshold, and the sill and the feet of the stiles. Because the decay is nearly always at the bottom, there is usually sound timber directly above it to splice onto, which is what makes these repairs practical. The alternative is taking out a frame that is sound for nine tenths of its length to deal with the last tenth.',
  },
  {
    question: 'Is timber repair resin as good as cutting in new timber?',
    answer:
      'They do different jobs and the honest answer is that resin is not a substitute for timber. A two-part exterior filler or repair resin is the right material for shallow, local defects where the wood underneath is still firm — it fills, it takes a finish and it holds its shape. What it cannot do is carry load, because it needs sound timber to key into. Put resin into decayed wood and it has nothing to hold on to; it hides the problem for a season or two and then pushes back out. Firm timber underneath, fill it. Nothing firm, cut it out.',
  },
];

const repairServices = [
  'Timber repair and timber restoration',
  'Wood rot repair, wet rot repair, and dry rot repair',
  'Rotten timber repair to windows, doors, and frames',
  'Splice repair and scarf joints',
  'Repair wooden door frame and repair wood window sill work',
  'Repairing rotted beams and timber beam repair',
  'Listed and period property timber repair',
  'Window and door restoration',
  'Floorboard repair and local structural timber repair',
  'Conservation-minded joinery and honest repair-or-replace advice',
];
---

<ServiceLayout
  title="Timber Repair in Pontefract & Wakefield"
  description="Timber repair, wood rot repair, wet rot repair, dry rot repair, splice repair, and timber restoration across Pontefract, Wakefield and West Yorkshire."
  serviceName="Timber Repair & Restoration"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}

  ogImage="/images/services/timber-repair/timber-splice-repair-yorkshire.webp"
>
  <FAQPageSchema slot="schema" faqs={faqItems} />

  <!-- Hero: same pattern as the doors page. -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/services/timber-repair/timber-splice-repair-yorkshire.webp"
      alt="Decayed column base cut back and spliced with new timber, then finished with a matching moulded plinth"
      width="1600"
      height="975"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
          <p class="text-oak uppercase tracking-wide mb-4">Repair and restoration specialism</p>
          <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Timber Repair in Pontefract, Wakefield &amp; West Yorkshire</h1>
          <p class="text-lg text-ink/80 mb-8">
            Timber repair is still one of Rob's strongest specialisms. Heritage Joiners carries out wood rot repair, wet rot repair, dry rot repair, splice repair, and wider timber restoration across West Yorkshire, always starting with what can be soundly kept rather than what can be quickly replaced.
          </p>
          <div class="flex flex-wrap gap-4">
            <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a timber repair" />
            <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
          </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Wood rot repair and timber restoration</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {repairServices.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Splice repair logic stays the same</h2>
        <p class="text-ink/70 mb-3">
          The judgement is always the same: identify the moisture cause, establish how much sound timber is left, and choose the least disruptive repair that is structurally honest. That may be a splice repair, a scarf joint, a sill repair, a beam-end repair, or a new section made to match.
        </p>
        <p class="text-ink/70 mb-6">
          Rob's bench joinery and site carpentry background matters here, because repair work needs clean cutting, good bearing, matching sections, and the judgement to stop where the sound timber starts.
        </p>
        <p class="text-ink/70 mb-6">
          How that works in practice &mdash; cutting back, choosing the replacement timber, matching the profile and protecting the joint &mdash; is set out at length in our guide to <a href="/blog/timber-window-repair-and-restoration-west-yorkshire" class="text-oak underline">timber window repair and restoration</a>.
        </p>
        <img
          src="/images/services/timber-repair/new-timber-let-into-casement-window-rail-greengates.webp"
          alt="New timber let into the bottom rail of a casement window, refitted and opening on its stay before decoration, Greengates"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <p class="text-ink/60 text-sm mt-3">
          A casement from a Grade II listed cottage in Greengates &mdash; decay cut back, new timber let into the rail, and the window back on its hinges before decoration. See the <a href="/services/windows" class="text-oak underline">window repair page</a>.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Rotten timber repair, not repair at any cost</h2>
        <p class="text-ink/70 mb-3">
          Rob still gives honest advice when repairing rotting wood without replacing is no longer sensible. If a structural cross-section has failed or too little sound timber remains, replacement is the better long-term answer.
        </p>
        <p class="text-ink/70">
          <a href="/repair-or-replace" class="text-oak underline">Read the full repair-or-replace framework</a> if you want to understand how that decision gets made, and the same logic applies when <a href="/services/windows" class="text-oak underline">timber window repairs</a> or <a href="/services/woodworm-treatment" class="text-oak underline">woodworm treatment</a> need to be judged alongside the repair.
         Two recent jobs show it in practice: the <a href="/case-studies/dunster-windows" class="text-oak underline">Dunster Windows case study</a> and <a href="/blog/rotten-timber-window-sill-repair-pontefract" class="text-oak underline">a rotten window sill repair in Pontefract</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Wet rot repair and dry rot repair</h2>
        <p class="text-ink/70 mb-3">
          Both are fungal decay and both need water to get going, but they do not behave the same way. Wet rot stays where the moisture is. It softens the wet timber and goes no further, which is why it turns up in the obvious places &mdash; a sill, a bottom rail, a joist end near a leak, the foot of a post sitting against damp masonry.
        </p>
        <p class="text-ink/70 mb-3">
          Dry rot is the more serious find, because it can spread through masonry and reach timber some way from the original damp. Identifying which one you are looking at changes how far you have to search before you start cutting.
        </p>
        <p class="text-ink/70">
          Either way the first job is the same: stop the water. A fungicidal treatment deals with residual activity and protects sound timber going forward, but it does not put strength back into wood that has already gone. That has to be restored with timber. Where the decay has brought beetle damage with it, <a href="/services/woodworm-treatment" class="text-oak underline">woodworm treatment</a> gets judged alongside the repair rather than after it.
        </p>
      </div>
      <div>
        <img
          src="/images/blog/listed-casement-window-repair-bradford/rotten-timber-cut-out-of-casement-window-bottom-rail.webp"
          alt="Rotten timber chiselled out of a casement window bottom rail back to firm timber, with wood chips and a chisel"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto rounded-xl shadow-lg"
        />
        <p class="text-ink/60 text-sm mt-3">
          Cutting back to where the timber is firm. The quantity that comes out is the answer to whether it was really rotten &mdash; the full job is in <a href="/blog/listed-casement-window-repair-bradford" class="text-oak underline">listed casement window repair in Bradford</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Timber beam repair and structural sections</h2>
        <p class="text-ink/70 mb-3">
          Old beams split and open up as they dry and move, and a split beam is not automatically a failed beam. At The Counting House in Pontefract several oak beams had opened over time. They were drilled, bolted and pulled back together with threaded bar and washer plates &mdash; direct, practical restoration carpentry that dealt with timber that had been creaking and moving, without stripping original fabric out of the building.
        </p>
        <p class="text-ink/70 mb-3">
          Where a beam has decayed rather than split, the usual answer is a beam-end repair: the rotten end cut back to sound timber and a new section let in, or new timber fixed alongside to carry the load where the original no longer can. A preservative does not restore strength, so the strength has to come back through the timber.
        </p>
        <p class="text-ink/70">
          The whole beam job is written up in <a href="/case-studies/counting-house/beam-repair-and-restoration" class="text-oak underline">beam repair and restoration carpentry</a>, part of the wider <a href="/case-studies/counting-house" class="text-oak underline">Counting House project</a>. Anything involving load paths is worth having specified properly &mdash; Rob will say plainly when a job needs a structural opinion rather than a joiner's.
        </p>
      </div>
      <div class="w-full aspect-[4/5] overflow-hidden rounded-xl shadow-lg">
        <img
          src="/images/case-studies/counting-house/the-counting-house-oak-beam-repair-threaded-bar.webp"
          alt="Split oak beam drilled and pulled back together with threaded bar at The Counting House, Pontefract"
          width="563"
          height="1000"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Sills, door frames and floor timber</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-ink/70 mb-3">
            <strong class="text-ink">Window sills and bottom rails.</strong> The most common timber repair there is, because a sill is the one part of a window that water runs onto and then sits on. Decay starts at the top face and the front edge and at the corners where the stiles land. On a commercial building on Micklegate in Pontefract, two sills and the feet of the stiles were past filling and were spliced in shaped sapele, cut to follow the existing profiles. All eleven windows on that building were kept.
          </p>
          <img
            src="/images/gallery/sapele-splice-repair-window-sill-pontefract.webp"
            alt="New sapele shaped and fitted into the decayed bottom of a timber window sill in Pontefract"
            width="1920"
            height="1080"
            loading="lazy"
            class="w-full h-auto rounded-xl shadow-lg mb-3"
          />
          <p class="text-ink/60 text-sm">
            Sapele let into a decayed sill &mdash; see <a href="/blog/rotten-timber-window-sill-repair-pontefract" class="text-oak underline">rotten window sill repair in Pontefract</a>.
          </p>
        </div>
        <div>
          <p class="text-ink/70 mb-3">
            <strong class="text-ink">Door frames and linings.</strong> Frames rot at the bottom of the jamb, where it meets the threshold and where water tracks down. Because the decay is nearly always low down, there is usually sound timber directly above it to splice onto, which is what makes the repair worth doing rather than taking out a frame that is sound for most of its length. Related work sits on the <a href="/services/doors" class="text-oak underline">door hanging and fitting</a> page.
          </p>
          <p class="text-ink/70 mb-3">
            <strong class="text-ink">Floorboards and floor timber.</strong> Joist ends built into damp walls, and boards that have taken a leak, both go the same way. A decayed joist end can be cut back and a new section joined on, or new full-length timber fixed alongside to carry the load. Boards are matched where they can be. Where a floor structure needs rebuilding rather than patching it moves into <a href="/services/first-fix-carpentry" class="text-oak underline">first fix carpentry</a>. A roof deck goes exactly the same way when water gets into it &mdash; see how a <a href="/blog/flat-roof-repair-wakefield" class="text-oak underline">rotten flat roof in Wakefield</a> was stripped back, the wet rot treated and the joists strengthened with full-length timbers.
          </p>
          <img
            src="/images/gallery/timber-joist-repair.webp"
            alt="New timber floor joists installed across a living room during floor repair"
            width="1200"
            height="675"
            loading="lazy"
            class="w-full h-auto rounded-xl shadow-lg"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Timber repair questions</h2>
      {faqItems.map((faq) => (
        <div class="mb-6 last:mb-0">
          <h3 class="font-display text-xl lg:text-2xl text-ink mb-2">{faq.question}</h3>
          <p class="text-ink/70">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Timber restoration across West Yorkshire</h2>
      <p class="text-ink/70">
        Timber repair work is available across <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, <a href="/areas/normanton" class="text-oak underline">Normanton</a>, and for selected heritage projects across wider <a href="/areas/yorkshire" class="text-oak underline">Yorkshire</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need decayed timber assessed?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send close photos of the affected timber and a wider shot showing the surrounding joinery or structure. Rob will give you an honest first view.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA message="Hi Heritage Joiners, I'd like to discuss a timber repair" />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
