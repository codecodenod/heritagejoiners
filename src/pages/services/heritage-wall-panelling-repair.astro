---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Heritage Wall Panelling Repair', url: `${url}/services/heritage-wall-panelling-repair/` }];
const schemaProps = {
  description: 'Repair and restoration of period timber wall panelling for listed and heritage interiors across Yorkshire.',
  url: `${url}/services/heritage-wall-panelling-repair/`,
  priceRange: '£££',
};

const repairItems = [
  'Raised-and-fielded panel repair — splits, shrinkage, damage',
  'Linenfold and carved panel consolidation',
  'Wainscot and dado rail repair and refixing',
  'Loose or detached panel refixing without visual damage',
  'Missing panel reproduction — profile matched and aged',
  'Rail and stile rot and decay at base of panelling',
  'Moulding repair and reproduction',
  'Period ironmongery — bolts, latches, hinges on panelled doors',
  'Colour matching and finish blending on repaired sections',
  'Cleaning and re-finishing without stripping original patina',
];

const panellingTypes = [
  { period: 'Tudor & Jacobean', desc: 'Linenfold, lozenge, and carved geometric panels. Often oak. Profile work and consolidation.' },
  { period: 'Georgian', desc: 'Raised-and-fielded pine or oak panels in formal rooms. Full-height or dado height.' },
  { period: 'Victorian', desc: 'Painted pine dado panelling, pitch pine in institutional and commercial settings.' },
  { period: 'Edwardian', desc: 'Lighter painted hardwood panelling, inglenook and hall panelling schemes.' },
];

const faqs = [
  {
    question: 'Can damaged timber panelling be repaired rather than replaced?',
    answer: 'In most cases, yes. Splits, missing sections, and loose panels can be repaired and reattached. Missing mouldings and panel sections can be reproduced to match the existing profile. The aim is always to retain original material and patina; reproduction inserts are matched in colour, grain direction, and finish so they do not read as new.',
  },
  {
    question: 'How do you clean and refinish old panelling without damaging it?',
    answer: 'We use methods appropriate to the existing finish — wax, oil, French polish, or paint. For polished surfaces, we clean carefully before any re-finishing to understand what is there. We do not strip and start again unless the existing finish is genuinely failed. Stripping original patina from old oak or pine panelling destroys something that cannot be restored.',
  },
  {
    question: 'Can you match the colour and patina of old panelling in a repair?',
    answer: 'We get close. New timber next to old timber always looks different at first — lighter in colour, cleaner in grain. We use stains, oils, and waxes to minimise the difference and the gap continues to close as the repair weathers. A sympathetic, well-matched repair is the realistic aim; an invisible repair on day one is not always achievable, and claims to the contrary should be treated with caution.',
  },
  {
    question: 'Does panelling repair work require listed building consent?',
    answer: 'Repair and like-for-like refixing of existing panelling generally does not. Removal or significant alteration of original panelling in a listed building may require consent. We advise on the consent position for any work that goes beyond straightforward repair.',
  },
];
---

<ServiceLayout
  title="Heritage Wall Panelling Repair & Restoration in Yorkshire"
  description="Repair and restoration of period timber wall panelling with sympathetic colour and finish matching for listed and heritage interiors across Yorkshire."
  serviceName="Heritage Wall Panelling Repair"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
>
  <FAQPageSchema slot="schema" faqs={faqs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Period interior joinery</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          Heritage Wall Panelling Repair &amp; Restoration
        </h1>
        <p class="text-lg text-ink/70 mb-8">
          Period timber wall panelling — from Tudor linenfold to Georgian raised-and-fielded to Victorian dado — is among the most historically significant joinery in listed buildings. It is also among the most vulnerable to damage, damp, and poorly judged interventions. We repair, refix, and restore original panelling with the same repair-first approach we apply to structural and window work: retain what is there, match what is missing, and leave the patina intact.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">What we repair</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {repairItems.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Panelling by period</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {panellingTypes.map((type) => (
          <div class="p-6 bg-paper rounded-lg border border-ink/10">
            <h3 class="font-display text-xl text-ink mb-2">{type.period}</h3>
            <p class="text-ink/70">{type.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Reproduction and matching</h2>
        <p class="text-ink/70 mb-3">
          Where a section of panelling is missing or too damaged to repair, we reproduce it to match the original — same profile, same species where possible, same moulding detail. Missing mouldings are matched by taking measurements or impressions from adjacent undamaged sections and machining a profile to match.
        </p>
        <p class="text-ink/70">
          New timber is treated with stains and finishing oils to bring it as close as possible to the surrounding patina before fitting. <a href="/services/timber-colour-matching-and-finishing/" class="text-oak underline">Read about our colour matching and finishing approach</a>.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Finishing and conservation</h2>
        <p class="text-ink/70 mb-3">
          We do not strip original finishes unless they are genuinely failed and stripping is the only viable path. Old wax, oil, and paint builds are part of the panelling's history and contribute to the patina.
        </p>
        <p class="text-ink/70">
          Where consolidation and cleaning are the right approach, we use compatible materials — wax-based cleaners, appropriate oils, reversible consolidants where necessary. Nothing that cannot be undone by a future conservator.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Frequently asked questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-ink/10 pb-6">
            <h3 class="font-display text-xl text-ink mb-2">{faq.question}</h3>
            <p class="text-ink/70">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Coverage</h2>
      <p class="text-ink/70">
        Pontefract-based, working on interior heritage joinery across <a href="/areas/yorkshire/" class="text-oak underline">Yorkshire</a>. We cover <a href="/areas/pontefract/" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield/" class="text-oak underline">Wakefield</a>, <a href="/areas/leeds/" class="text-oak underline">Leeds</a>, and travel for significant panelling projects in listed buildings across the county.
      </p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Related services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/timber-colour-matching-and-finishing/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
        <a href="/services/doors-and-frames/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Doors &amp; Frames</a>
        <a href="/repair-or-replace/" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Repair or Replace? Framework</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Heritage panelling that needs attention?</h2>
      <p class="text-ink/70 mb-8 max-w-2xl mx-auto">Photos of the affected panelling — showing the damage, the wider scheme, and any areas of missing or repaired sections — give us the context we need before a site visit.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
