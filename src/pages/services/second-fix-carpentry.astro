---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Second Fix Carpentry', url: `${url}/services/second-fix-carpentry` }];
const schemaProps = {
  description: 'Second fix carpenter services across Pontefract, Wakefield, and West Yorkshire, including door hanging, skirting, architrave, and finishing joinery.',
  url: `${url}/services/second-fix-carpentry`,
  priceRange: '££',
};

const faqItems = [
  {
    question: 'What counts as second-fix carpentry?',
    answer:
      'Rob regularly handles second-fix carpentry for refurbishments, late-stage snagging, and isolated finishing jobs. These jobs can look small on a list, but they still need proper setting out, careful preparation, and no shortcut workmanship.',
  },
  {
    question: 'What should I send before asking for second-fix work?',
    answer:
      'Send a short list of the items to be finished and a few photos and Rob can usually tell you quickly whether it is the right fit.',
  },
];

const secondFixServices = [
  'Second fix carpenter and finishing joiner work',
  'Door hanging and internal door hanging jobs',
  'Skirting, architrave, and window boards',
  'Stairs, trims, and finishing details',
  'Ironmongery, handles, hinges, and latches',
  'Boxing in pipes, boilers, and soil stacks',
  'Built-in furniture and final trim packages',
  '1st and 2nd fix joinery coordination where needed',
];
---

<ServiceLayout
  title="Second Fix Carpentry in Pontefract & Wakefield"
  description="Second fix carpenter services across Pontefract, Wakefield and West Yorkshire, including door hanging, skirting, architrave, boxing-in, and finishing joinery."
  serviceName="Second Fix Carpentry"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}

  ogImage="/images/services/second-fix-carpentry/second-fix-carpentry-door-lining-fitted-yorkshire.webp"
>
  <FAQPageSchema slot="schema" faqs={faqItems} />

  <!-- Hero: same pattern as the doors page. -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/services/second-fix-carpentry/second-fix-carpentry-door-lining-fitted-yorkshire.webp"
      alt="Timber door lining fitted in a plasterboarded stud partition wall"
      width="1600"
      height="900"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
          <p class="text-oak uppercase tracking-wide mb-4">Second fix and finishing joinery</p>
          <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Second Fix Carpenter in Pontefract, Wakefield &amp; West Yorkshire</h1>
          <p class="text-lg text-ink/80 mb-8">
            Rob covers second fix carpenter work across West Yorkshire, including door hanging, skirting and architrave, window boards, boxing in pipes, ironmongery, and the finishing joinery that takes a job from built to properly finished.
          </p>
          <div class="flex flex-wrap gap-4">
            <WhatsAppCTA />
            <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
          </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">2nd fix joinery and finishing work</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {secondFixServices.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Door hanging and finishing detail</h2>
        <p class="text-ink/70 mb-3">
          Second fix is where the visible work is won or lost. Door margins, hinge gains, latch positions, architrave returns, clean scribes, and tidy boxing-in all show whether the person fitting it understands the timber and the room.
        </p>
        <p class="text-ink/70">
          Rob takes the same care on one door as he does on a full finishing package.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Boxing in pipes and second-fix joinery</h2>
        <p class="text-ink/70 mb-3">
          A lot of second-fix work is practical problem-solving: <a href="/services/doors" class="text-oak underline">door hanging</a>, <a href="/services/skirting-architrave" class="text-oak underline">skirting board fitting</a>, or someone to box in awkward pipework cleanly without making the room look patched.
        </p>
        <p class="text-ink/70">
          If you are weighing up the cost to hang a door or interior door installation cost, the frame condition, hinge positions, flooring level, and ironmongery usually make the difference.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Second fix carpenter questions</h2>
      {faqItems.map((faq) => (
        <div class="mb-6 last:mb-0">
          <h3 class="font-display text-xl lg:text-2xl text-ink mb-2">{faq.question}</h3>
          <p class="text-ink/70">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Second fix joinery across West Yorkshire</h2>
      <p class="text-ink/70">
        Second fix work is available across <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, <a href="/areas/normanton" class="text-oak underline">Normanton</a>, and <a href="/areas/leeds" class="text-oak underline">Leeds</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need a second-fix joiner?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos of the rooms and a list of the remaining items so Rob can advise on scope and timing.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
