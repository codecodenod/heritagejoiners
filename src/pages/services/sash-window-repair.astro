---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import FAQPageSchema from '../../components/schema/FAQPage.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Sash Window Repair', url: `${url}/services/sash-window-repair` }];
const schemaProps = {
  description: 'Repair-first sash window specialists for listed and period properties across Pontefract, Wakefield, and Yorkshire.',
  url: `${url}/services/sash-window-repair`,
  priceRange: '££',
};

const repairItems = [
  'Broken or perished sash cords',
  'Sticking, jamming, or painted-shut sashes',
  'Rotten cills, bottom rails, and meeting rails',
  'Failed putty and loose glazing',
  'Damaged or worn parting beads and staff beads',
  'Pulley wheels and weight pockets',
  'Draught-proofing in original frames',
  'Sash hardware — catches, lifts, restrictors',
  'Splice repair to decayed timber sections',
  'Easing and rebalancing for smooth operation',
  'Period-accurate selective replacement when timber retention is too low',
];

const problems = [
  {
    title: 'Sash that will not open or close',
    body: 'Usually a combination of paint build-up, perished cords, or a swollen frame. We free the sash, break the paint seal, replace cords where needed, and ease the box so it runs cleanly again.',
  },
  {
    title: 'Broken sash cord',
    body: 'A common fault and a clean repair. We remove the staff beads, take out the sash, replace the cord and weights, and refit — often achievable in a single visit on a straightforward window.',
  },
  {
    title: 'Rotten cill or bottom rail',
    body: 'Splice repair retains the original window. We cut back to sound timber, scarf in profile-matched new timber, blend the finish, and address the water path that caused the decay in the first place.',
  },
  {
    title: 'Draughty sash window',
    body: 'Discreet brush-pile draught seals fitted into rebates on the meeting rail and jambs. Not visible from outside, does not alter the appearance, and can meaningfully reduce heat loss without touching the glazing.',
  },
  {
    title: 'Failed putty or loose glass',
    body: 'Careful removal of failed putty, cleaning of the rebate, re-bedding and pointing in linseed putty, and repainting the sill and bead once cured. Glazing bar refurbishment included where the bar itself is damaged.',
  },
  {
    title: 'Painted-shut sashes',
    body: 'Multiple coats of paint over decades can seal sashes solid. We score the paint line, free the sash without damage, strip the rebates of build-up, and ease both sashes for free movement before refinishing.',
  },
];

const faqs = [
  {
    question: 'Can old sash windows always be repaired?',
    answer: 'Not always. Where the remaining sound timber is too low to support a durable repair — typically when load-bearing zones have failed or previous repairs have already been tried — we will say so plainly and advise on sympathetic replacement options. Our four-stage framework on the repair-or-replace page sets out the thresholds we use.',
  },
  {
    question: 'Do I need listed building consent to repair my sash windows?',
    answer: 'Repair work to original fabric typically does not require listed building consent, whereas replacement often does. This is one of the practical advantages of repair-first on listed properties. If the scope involves any like-for-like replacement, we advise checking with the local conservation officer before proceeding.',
  },
  {
    question: 'How long does a sash window repair last?',
    answer: 'A sound splice repair with the moisture cause addressed and the finish maintained should give another 20-40 years of service on the repaired section. Cord replacement is a maintenance item — cords last 15-25 years depending on use and cord quality. We use solid-braid cotton or waxed polyester cord, not cheap twisted cord.',
  },
  {
    question: 'Can you draught-proof original sash windows without changing how they look?',
    answer: 'Yes. Brush-pile seals are fitted into routed slots in the frame and meeting rail — invisible once fitted. Staff and parting beads are fitted close to the sash edge. From the outside the window looks exactly as it did. The improvement in air infiltration is real and measurable.',
  },
  {
    question: 'Is repair really cheaper than replacement?',
    answer: 'For most period sash windows, yes. Standard repair work including cord replacement and splice repair typically runs £350-£900 per window. National replacement routes for a sash equivalent start at £2,500-£4,000 per window — and trigger listed building consent in many cases. Where repair genuinely is not viable, we say so rather than repair at any cost.',
  },
];
---

<ServiceLayout
  title="Sash Window Repair in Pontefract & Across Yorkshire"
  description="Repair-first sash window specialists: cords, splice repairs, draught-proofing, painted-shut releases. Pontefract base, Yorkshire-wide for listed and period work."
  serviceName="Sash Window Repair"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
>
  <FAQPageSchema slot="schema" faqs={faqs} />

  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Repair-first sash specialists</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          Sash Window Repair in Pontefract &amp; Across Yorkshire
        </h1>
        <p class="text-lg text-ink/70 mb-8">
          Sash windows in listed and period properties almost always have more life left in them than they appear to. Most problems — broken cords, stuck sashes, rotten cills, draughts, failed putty — are repairable. Heritage Joiners specialises in sash window repair for period properties across Yorkshire, working from a Pontefract base. We retain original timber wherever the condition allows it.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">What we repair</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {repairItems.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Common problems we fix</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {problems.map((p) => (
          <div>
            <h3 class="font-display text-xl text-ink mb-2">{p.title}</h3>
            <p class="text-ink/70">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">How we decide repair or replace</h2>
        <p class="text-ink/70 mb-4">
          We work through a four-stage assessment on every window: retain intact timber, selective splice of localised decay, partial replacement of a failed section, then full replacement only where structural retention is too low for durable work.
        </p>
        <a href="/repair-or-replace" class="text-oak underline font-display">Read the full framework &rarr;</a>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Timber matching and finishing</h2>
        <p class="text-ink/70">
          Where new timber is spliced in, we profile-match to the original section and blend the finish — stain, oil, or paint — so the repair sits naturally in the existing window. On painted sashes we prime and undercoat; finish coats are the owner's choice of colour. On unpainted hardwood sashes we use compatible oil or wax systems. <a href="/services/timber-colour-matching-and-finishing" class="text-oak underline">Read about our colour matching and finishing work</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Listed building practicalities</h2>
      <p class="text-ink/70 mb-4">
        Repair to original fabric generally does not require listed building consent, whereas replacement often does. That consent route adds time and cost before any work begins. Repair-first is not just better for the building — it is usually the simpler planning path on Grade I, Grade II*, and Grade II properties.
      </p>
      <p class="text-ink/70">
        Where draught-proofing involves any modification to profiles or beads, we advise owners to check with the local conservation officer. In most cases discreet brush-seal installations are considered repair rather than alteration.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Typical cost bands</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£80–£150</p><p class="text-sm text-ink/70">Site assessment</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£180–£350</p><p class="text-sm text-ink/70">Small localised repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£350–£900</p><p class="text-sm text-ink/70">Standard sash repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£900+</p><p class="text-sm text-ink/70">Complex multi-section</p></div>
      </div>
      <p class="text-ink/70 text-sm">Standard sash repair covers cord replacement, splice repair, draught-proofing, and easing per window. Full replacement from a national firm typically runs £2,500–£4,000 per sash-window equivalent — a sympathetic repair often saves the majority of that cost while keeping the original timber.</p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Frequently asked questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-ink/10 pb-6">
            <h3 class="font-display text-xl text-ink mb-2">{faq.question}</h3>
            <p class="text-ink/70">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-4">
        The Counting House in Pontefract includes sash window restoration work across multiple openings — cords, splice repairs, draught-proofing, and easing on original frames.
      </p>
      <a href="/case-studies/counting-house/sash-windows" class="text-oak font-display">View sash window case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Coverage</h2>
      <p class="text-ink/70">
        Pontefract-based, working first across WF postcodes: <a href="/areas/pontefract" class="text-oak underline">Pontefract</a> (WF7, WF8, WF9), <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, <a href="/areas/knottingley" class="text-oak underline">Knottingley</a>, and <a href="/areas/normanton" class="text-oak underline">Normanton</a>. We travel further across Yorkshire for listed and period work — <a href="/areas/leeds" class="text-oak underline">Leeds</a>, York, and selected projects across <a href="/areas/yorkshire" class="text-oak underline">the wider county</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Related services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/services/timber-window-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Window Repair (casements &amp; period windows)</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/services/timber-colour-matching-and-finishing" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Timber Colour Matching &amp; Finishing</a>
        <a href="/services/listed-and-period-property-repairs" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Listed &amp; Period Property Repairs</a>
        <a href="/repair-or-replace" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Repair or Replace? Framework</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Send photos for a repair view</h2>
      <p class="text-ink/70 mb-8 max-w-2xl mx-auto">Clear photos of the affected windows — inside and outside, close-up of any rot or damage — give a good first view of repair viability before a site visit is needed.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
