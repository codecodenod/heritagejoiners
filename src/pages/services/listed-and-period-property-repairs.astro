---
/**
 * Listed and Period Property Repairs service page
 */
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [{ name: 'Listed & Period Property Repairs', url: `${url}/services/listed-and-period-property-repairs` }];
const schemaProps = {
  description: 'Whole-property timber repair for listed and period homes across Pontefract, Wakefield, and Yorkshire.',
  url: `${url}/services/listed-and-period-property-repairs`,
  priceRange: '££',
};

const included = [
  'Sash window repair — cords, splice, draught-proofing',
  'Casement and period timber window repair',
  'Door and frame repair',
  'Rot cut-out and splice repairs',
  'Sills, rails, stiles, linings, and thresholds',
  'Structural timber — beams, joists, roof timbers',
  'Heritage wall panelling repair',
  'Timber matching, colour matching, and period finishing',
  'Hardware, ironmongery, beads, and glazing-bed work',
  'Repair viability advice before replacement',
  'Coordinated work across several openings',
];

const audiences = [
  'Listed building owners',
  'Period property owners',
  'Conservation area homeowners',
  'Architects',
  'Surveyors',
  'Landlords and commercial owners of historic buildings',
];
---

<ServiceLayout
  title="Listed & Period Property Repairs in Pontefract & Wakefield"
  description="Whole-property timber repair for listed and period homes across Pontefract, Wakefield, and Yorkshire. Windows, doors, frames, rot, and splice repairs by one specialist."
  serviceName="Listed & Period Property Repairs"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Whole-property repair</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          Whole-property timber repair for listed and period homes
        </h1>
        <p class="text-lg text-ink/70 mb-8">
          For listed and period buildings with several timber issues, we bring windows, doors, frames, rot repairs, splice work, and timber matching under one repair-first specialist.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">What is included</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {included.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Why one specialist matters</h2>
        <p class="text-ink/70">
          Mixing separate trades on a listed building can create visible mismatches in timber, profiles, ironmongery, finish, and repair judgement. One specialist keeps the repair logic consistent across the property.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Repair-first decision logic</h2>
        <p class="text-ink/70">
          We assess each opening or timber element using the same staged approach: retain, selective splice, partial replacement, then full replacement only where necessary. <a href="/repair-or-replace" class="text-oak underline">Read the full framework</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Who carries out the work</h2>
      <p class="text-ink/70 mb-4">
        Heritage Joiners is led by Rob, a fully qualified, time served, bench hand joiner and site carpenter with more than 35 years of hands-on experience across new builds and refurbishments.
      </p>
      <p class="text-ink/70">
        That career has run from new-build site carpentry through to specialist work on listed buildings, oak-framed buildings, and barn conversions. The current focus is firmly on listed and period property renovation. <a href="/about" class="text-oak underline">Read more on the About page</a>.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Typical cost bands</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£80-£150</p><p class="text-sm text-ink/70">Assessment</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£180-£350</p><p class="text-sm text-ink/70">Small local repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£350-£900</p><p class="text-sm text-ink/70">Standard opening repair</p></div>
        <div class="p-5 bg-bone rounded-lg"><p class="font-display text-xl text-ink">£900+</p><p class="text-sm text-ink/70">Complex or multiple sections</p></div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-ink text-bone">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl mb-4">Whole-property replacement is expensive</h2>
      <p class="text-bone/70 mx-auto">
        Six listed sashes through a national replacement route can reach £15,000-£24,000. Where viable, a staged repair programme might sit nearer £3,000-£5,400 and keep more original fabric.
      </p>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Counting House proof</h2>
      <p class="text-ink/70 mb-6">The Counting House is the current anchor project for whole-building period timber restoration.</p>
      <a href="/case-studies/counting-house" class="text-oak font-display">View Counting House case study &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">Who this is for</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {audiences.map((item) => (
          <div class="p-4 bg-paper rounded-lg border border-ink/10 text-ink/80">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Coverage</h2>
      <p class="text-ink/70">
        Pontefract-based, working first across WF postcodes: <a href="/areas/pontefract" class="text-oak underline">Pontefract</a>, <a href="/areas/wakefield" class="text-oak underline">Wakefield</a>, <a href="/areas/castleford" class="text-oak underline">Castleford</a>, <a href="/areas/featherstone" class="text-oak underline">Featherstone</a>, Knottingley, and Normanton. We also travel further across Yorkshire for Leeds, York, and selected listed or period projects.
      </p>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Need several areas assessed?</h2>
      <p class="text-ink/70 mb-8 mx-auto">Send photos of the windows, doors, and frames causing concern and we will advise where repair is likely to make sense.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
