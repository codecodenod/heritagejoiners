---
/**
 * Services overview page
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  {
    href: '/services/listed-and-period-property-repairs/',
    title: 'Listed & Period Property Repairs',
    description: 'Whole-property timber repair for listed and period buildings: windows, doors, frames, rot, splice work, and timber matching by one specialist.',
  },
  {
    href: '/services/timber-window-repair/',
    title: 'Timber Window Repair',
    description: 'Sash windows, casements, hung lights, and period windows repaired before replacement is considered.',
  },
  {
    href: '/services/doors-and-frames/',
    title: 'Doors & Frames',
    description: 'Period timber doors, external doors, frames, linings, thresholds, and ironmongery repaired wherever sound.',
  },
  {
    href: '/services/rot-and-splice/',
    title: 'Rot & Splice Repair',
    description: 'Targeted rot cut-out and splice repairs that replace only failed timber sections where the surrounding fabric is sound.',
  },
];
---

<BaseLayout title="Our Services" description="Specialist timber window and door services across Yorkshire - repair-first restoration for listed and period properties.">
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Our services</h1>
      <p class="text-lg text-ink/70 mb-12 max-w-2xl">
        We specialise in repair-first timber work for listed and period properties. We assess whether original fabric can be retained before recommending selective or full replacement. <a href="/repair-or-replace/" class="text-oak underline">Read the repair-or-replace framework</a>.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service) => (
          <a
            href={service.href}
            class="group block p-6 bg-bone rounded-lg border border-ink/10 hover:border-oak transition-colors"
          >
            <h2 class="font-display text-xl text-ink mb-2 group-hover:text-oak transition-colors">
              {service.title}
            </h2>
            <p class="text-ink/70">{service.description}</p>
            <span class="inline-block mt-4 text-oak font-display text-sm">
              Learn more &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
