---
/**
 * Services overview page
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import { siteConfig } from '../../config/site';

const { url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Services', url: `${url}/services` },
];

// `image` / `alt` are optional — a card renders without a picture until one is set.
const serviceCards: {
  href: string;
  title: string;
  description: string;
  image?: string;
  alt?: string;
}[] = [
  { href: '/services/doors', title: 'Doors', description: 'Door hanging, door frame repair, internal and external door fitting, fire doors, and timber door work set up to swing and close properly.', image: '/images/homepage/oak-ledged-and-braced-front-door.webp', alt: 'Oak front door with a small glazed panel in a stone opening' },
  { href: '/services/windows', title: 'Windows', description: 'Sash window repair, timber windows, draught-proofing, restoration, and new timber window work assessed with repair-first judgement.', image: '/images/homepage/timber-sash-window-stone-surround.webp', alt: 'White-painted timber sash window set in a stone surround' },
  { href: '/services/first-fix-carpentry', title: 'First Fix Carpentry', description: 'Floor joists, stud partition walls, door linings, structural timber, and first-fix joiner work with proper setting out before boarding.', image: '/images/blog/stud-partition/stud-wall-frame-with-door-opening-doncaster.webp', alt: 'Timber stud partition frame with a door opening in a stripped-back room' },
  { href: '/services/second-fix-carpentry', title: 'Second Fix Carpentry', description: 'Door hanging, trims, window boards, boxing-in, ironmongery, and finishing joinery where margins and scribes matter.', image: '/images/blog/stud-partition/finished-internal-door-in-stud-partition-wall-doncaster.webp', alt: 'Timber door lining fitted in a plasterboarded stud partition wall' },
  { href: '/services/staircases', title: 'Staircases', description: 'New staircases, loft stairs, renovations, repairs, handrails, spindles, and under-stair storage set out to fit the building.', image: '/images/homepage/oak-staircase-handrails-spindles.webp', alt: 'Oak staircase with square spindles and newel posts' },
  { href: '/services/kitchens', title: 'Kitchens', description: 'Kitchen fitting, timber worktops, cabinetry, pantry joinery, repairs, and refresh work with clean scribes and practical site fitting.', image: '/images/homepage/fitted-oak-kitchen-pontefract.webp', alt: 'Oak kitchen cabinets and worktops with a Belfast sink' },
  { href: '/services/skirting-architrave', title: 'Skirting, Architrave & Trim', description: 'Skirting board fitting, architrave, picture rails, dado rails, and profile-matched mouldings for rooms that are rarely square.', image: '/images/case-studies/counting-house/the-counting-house-oak-interior-boxing-in-window.webp', alt: 'Timber boxing-in and panelling beneath a window in a period interior' },
  { href: '/services/flooring', title: 'Flooring', description: 'Floor sanding, wood floor repair, parquet, floorboard replacement, and timber floor refinishing after the boards are checked properly.', image: '/images/gallery/engineered-oak-wood-flooring.webp', alt: 'Engineered oak flooring part-laid over underlay in a room being fitted out' },
  { href: '/services/bespoke-joinery', title: 'Built-in & Bespoke Joinery', description: 'Fitted wardrobes, alcove units, shelving, media units, window seats, and custom storage made around the room.', image: '/images/homepage/workshop.webp', alt: 'Carved timber panel laid on a workshop bench with hand tools' },
  { href: '/services/roofing-carpentry', title: 'Roofing & Roof Carpentry', description: 'Cut roofs, rafters, roof trusses, dormer construction, soffits, and roof timber repair with accurate roof set-out.', image: '/images/homepage/oak-roof-trusses-timber-rafters.webp', alt: 'Oak roof frame with trusses and exposed rafters' },
  { href: '/services/extensions-conversions', title: 'Extensions, Conversions & Structural', description: 'Attic conversions, lofts, garage conversions, timber frames, joists, openings, and structural carpentry.', image: '/images/about/heritage-joiners-hipped-roof-extension.webp', alt: 'Hipped roof timbers going up on a scaffolded house extension' },
  { href: '/services/outdoor-carpentry', title: 'Outdoor & Landscape Carpentry', description: 'Wooden garden gates, fences, decking, pergolas, screening, and outdoor timber structures planned for weather and use.', image: '/images/blog/garden-gate/made-to-measure-wooden-garden-gate-fitted.webp', alt: 'Arched-top timber garden gate hung between brick walls' },
  { href: '/services/cladding-panelling', title: 'Cladding & Panelling', description: 'Wall panelling, tongue and groove panelling, feature walls, and external timber cladding with careful proportions.', image: '/images/case-studies/counting-house/the-counting-house-rustic-sawn-oak-boarding.webp', alt: 'Rustic sawn oak boarding fixed as vertical cladding' },
  { href: '/services/timber-repair', title: 'Timber Repair & Restoration', description: 'Wet rot, dry rot, splice repair, timber restoration, and heritage repair-first carpentry based on sound timber.', image: '/images/homepage/service-rot.webp', alt: 'Fresh timber splice fitted into a decayed window frame' },
  { href: '/services/woodworm-treatment', title: 'Woodworm & Treatment', description: 'Woodworm treatment, timber treatment, replacement of damaged timber, and related repair work after proper assessment.', image: '/images/blog/flat-roof-wakefield/06-treating-retained-roof-timbers-for-wet-rot.webp', alt: 'Timber treatment being applied to retained roof joists' },
  { href: '/services/finishing', title: 'Finishing & Specialist', description: 'Wood staining, oiling, waxing, French polishing, colour matching, and refinishing with test boards and careful prep.', image: '/images/gallery/workshop-bench-hand-joinery.webp', alt: 'Oak framed and boarded door on the workshop bench with tools to hand' },
  { href: '/services/timber-hardwoods', title: 'Timber & Hardwoods', description: 'Oak joinery, reclaimed timber, Accoya, iroko, hardwoods, softwoods, and practical material advice.', image: '/images/about/heritage-joiners-oak-specialists.webp', alt: 'Oak boards and sections stacked in the workshop' },
  { href: '/services/maintenance-repairs', title: 'Maintenance & Repairs', description: 'General carpentry repairs, lock and hinge replacement, shelving, snagging, and small joinery jobs handled properly.', image: '/images/homepage/carpentry-maintenance-repairs-yorkshire.webp', alt: 'Timber roof frame under repair on a scaffolded house extension' },
];

const serviceItems = serviceCards.map((service) => ({
  name: service.title,
  url: new URL(service.href, url).toString(),
}));

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: serviceItems.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.name,
    item: service.url,
  })),
};
---

<BaseLayout
  title="Carpentry & Joinery Services in Yorkshire"
  description="Explore carpentry and joinery services across West Yorkshire, from doors, kitchens, staircases, and roofing to heritage timber repair and specialist finishing."
>
  <BreadcrumbSchema items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- Hero: sawn oak stack with fade for text legibility -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/sawn-oak-planks-carpentry-and-joinery-yorkshire.webp"
      alt="Sawn oak boards stacked for air drying, with a wide live-edge oak slab in the foreground"
      width="1600"
      height="850"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Carpentry &amp; Joinery Services Across West Yorkshire</h1>
        <p class="text-lg text-ink/80">
          Heritage Joiners covers general carpentry and joinery across West Yorkshire, with heritage timber repair kept as a strong specialism rather than the whole identity. Rob is a fully qualified apprentice trained bench hand joiner, time served, with over 35 years' experience across workshop joinery, site carpentry, refurbishments, and old buildings.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-ink/70 mb-12 max-w-3xl">
        Good joinery is problem-solving. If the job involves timber, awkward walls, weak framing, old repairs, uneven floors, or decayed sections, there is a good chance Rob can point you to the right service. <a href="/repair-or-replace" class="text-oak underline">Read the repair-or-replace framework</a> if your enquiry involves older or decayed timber.
      </p>

      <h2 class="font-display text-2xl text-ink mb-4 mt-8 pb-2 border-b border-ink/10">Core Joinery &amp; Carpentry</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        {serviceCards.slice(0, 4).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Interiors</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        {serviceCards.slice(4, 9).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Structural, Roofing &amp; Exterior</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        {serviceCards.slice(9, 13).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Heritage Repair &amp; Specialist Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {serviceCards.slice(13).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
