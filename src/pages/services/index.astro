---
/**
 * Services overview page
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/schema/Breadcrumb.astro';
import { siteConfig } from '../../config/site';

const { url } = siteConfig;
const breadcrumbs = [
  { name: 'Home', url: `${url}/` },
  { name: 'Services', url: `${url}/services` },
];

// `image` / `alt` are optional — a card renders without a picture until one is set.
const serviceCards: {
  href: string;
  title: string;
  description: string;
  image?: string;
  alt?: string;
}[] = [
  { href: '/services/doors', title: 'Doors', description: 'Door hanging, internal and external door fitting, fire doors and door frame repair. Old openings are rarely square, so doors get hung to the opening they are going in.', image: '/images/homepage/oak-ledged-and-braced-front-door.webp', alt: 'Oak front door with a small glazed panel in a stone opening' },
  { href: '/services/windows', title: 'Windows', description: 'Sash window repair, timber window repairs, draught-proofing and new timber windows. Rot gets cut back to sound timber and spliced, not filled over.', image: '/images/homepage/timber-sash-window-stone-surround.webp', alt: 'White-painted timber sash window set in a stone surround' },
  { href: '/services/first-fix-carpentry', title: 'First Fix Carpentry', description: 'First fix joiner work: floor joists, stud partition walls, door linings and structural timber. Extra noggins go in to stiffen the frame before it is boarded.', image: '/images/blog/stud-partition/stud-partition-wall-frame-with-double-door-studs-doncaster.webp', alt: 'Timber stud partition frame with door studs and noggins in a stripped-back room' },
  { href: '/services/second-fix-carpentry', title: 'Second Fix Carpentry', description: 'Second fix carpenter work: hanging doors, skirting, architrave, window boards, boxing-in and ironmongery. The stage where margins and scribes show.', image: '/images/blog/stud-partition/finished-internal-door-in-stud-partition-wall-doncaster.webp', alt: 'Timber door lining fitted in a plasterboarded stud partition wall' },
  { href: '/services/staircases', title: 'Staircases', description: 'Staircase fitter for new staircases, loft stairs, handrails, spindles and under-stair storage. Set out to the building rather than to a standard rise and going.', image: '/images/homepage/oak-staircase-handrails-spindles.webp', alt: 'Oak staircase with square spindles and newel posts' },
  { href: '/services/kitchens', title: 'Kitchens', description: 'Kitchen fitter work: units, timber worktops, cabinetry and pantry joinery, scribed into walls that are rarely straight.', image: '/images/homepage/fitted-oak-kitchen-pontefract.webp', alt: 'Oak kitchen cabinets and worktops with a Belfast sink' },
  { href: '/services/skirting-architrave', title: 'Skirting, Architrave & Trim', description: 'Skirting board fitting, architrave, picture rails, dado rails and profile-matched mouldings, cut to rooms that are rarely square.', image: '/images/case-studies/counting-house/the-counting-house-oak-interior-boxing-in-window.webp', alt: 'Timber boxing-in and panelling beneath a window in a period interior' },
  { href: '/services/flooring', title: 'Flooring', description: 'Floor sanding, parquet, floorboard replacement and timber floor refinishing. Boards get checked for movement and fixings before the sander comes out.', image: '/images/gallery/engineered-oak-wood-flooring.webp', alt: 'Engineered oak flooring part-laid over underlay in a room being fitted out' },
  { href: '/services/bespoke-joinery', title: 'Built-in & Bespoke Joinery', description: 'Fitted wardrobes, alcove units, shelving, media units and window seats, made to the room rather than bought in a size that nearly fits.', image: '/images/homepage/workshop.webp', alt: 'Carved timber panel laid on a workshop bench with hand tools' },
  { href: '/services/roofing-carpentry', title: 'Roofing & Roof Carpentry', description: 'Roof carpenter work: cut roofs, rafters, trusses, dormers and soffits. Ridge, purlins and rafter centres are set out before anything is cut.', image: '/images/homepage/oak-roof-trusses-timber-rafters.webp', alt: 'Oak roof frame with trusses and exposed rafters' },
  { href: '/services/extensions-conversions', title: 'Extensions, Conversions & Structural', description: 'Attic conversions, loft and garage conversions, timber frames, joists and structural openings. Rooflights get planned into the roof set-out, not cut in after tiling.', image: '/images/about/heritage-joiners-hipped-roof-extension.webp', alt: 'Hipped roof timbers going up on a scaffolded house extension' },
  { href: '/services/outdoor-carpentry', title: 'Outdoor & Landscape Carpentry', description: 'Wooden garden gates, fences, decking, pergolas and screening, built from timber chosen to stand out in Yorkshire weather.', image: '/images/blog/garden-gate/made-to-measure-wooden-garden-gate-fitted.webp', alt: 'Arched-top timber garden gate hung between brick walls' },
  { href: '/services/cladding-panelling', title: 'Cladding & Panelling', description: 'Wall panelling, tongue and groove panelling, feature walls and external timber cladding. Board widths are set out so the panel lands right at both ends.', image: '/images/case-studies/counting-house/the-counting-house-rustic-sawn-oak-boarding.webp', alt: 'Rustic sawn oak boarding fixed as vertical cladding' },
  { href: '/services/timber-repair', title: 'Timber Repair & Restoration', description: 'Timber repair for wet rot, dry rot and splice repairs. Decayed sections are cut back to sound timber and matched, keeping the original that is still good.', image: '/images/homepage/service-rot.webp', alt: 'Fresh timber splice fitted into a decayed window frame' },
  { href: '/services/woodworm-treatment', title: 'Woodworm & Treatment', description: 'Woodworm treatment and timber treatment, with damaged sections replaced where the strength has gone. Assessed first, before anything is sprayed.', image: '/images/blog/flat-roof-wakefield/06-treating-retained-roof-timbers-for-wet-rot.webp', alt: 'Timber treatment being applied to retained roof joists' },
  { href: '/services/finishing', title: 'Finishing & Specialist', description: 'Wood staining, oiling, waxing, French polishing and colour matching. Test boards first, because stain reads differently on every piece of timber.', image: '/images/gallery/workshop-bench-hand-joinery.webp', alt: 'Oak framed and boarded door on the workshop bench with tools to hand' },
  { href: '/services/timber-hardwoods', title: 'Timber & Hardwoods', description: 'Oak joinery, reclaimed timber, Accoya, iroko and other hardwoods and softwoods, with straight advice on what actually suits the job.', image: '/images/about/heritage-joiners-oak-specialists.webp', alt: 'Oak boards and sections stacked in the workshop' },
  { href: '/services/maintenance-repairs', title: 'Maintenance & Repairs', description: 'Carpentry repairs, lock and hinge replacement, shelving, snagging and the small joinery jobs that keep getting put off.', image: '/images/homepage/carpentry-maintenance-repairs-yorkshire.webp', alt: 'Timber roof frame under repair on a scaffolded house extension' },
];

const serviceItems = serviceCards.map((service) => ({
  name: service.title,
  url: new URL(service.href, url).toString(),
}));

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: serviceItems.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.name,
    item: service.url,
  })),
};
---

<BaseLayout
  title="Carpentry & Joinery Services in Yorkshire"
  description="Explore carpentry and joinery services across West Yorkshire, from doors, kitchens, staircases, and roofing to heritage timber repair and specialist finishing."
>
  <BreadcrumbSchema items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- Hero: sawn oak stack with fade for text legibility -->
  <section class="relative overflow-hidden bg-bone min-h-[380px] lg:min-h-[480px] flex items-center">
    <img
      src="/images/sawn-oak-planks-carpentry-and-joinery-yorkshire.webp"
      alt="Sawn oak boards stacked for air drying, with a wide live-edge oak slab in the foreground"
      width="1600"
      height="850"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bone/95 via-bone/75 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">
      <div class="max-w-2xl">
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">Carpentry &amp; Joinery Services Across West Yorkshire</h1>
        <p class="text-lg text-ink/80">
          Kitchens, doors, staircases, floors, roofs and fitted joinery, across Pontefract, Wakefield and West Yorkshire. Rob is a fully qualified apprentice trained bench hand joiner, time served, with over 35 years' experience on the bench and on site — including heritage and period timber work.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-ink/70 mb-12 max-w-3xl">
        Good joinery is problem-solving. Walls out of plumb, openings out of square, floors that are not level, awkward angles, or timber that has gone — the skill is finding the way that works. If your job involves older or decayed timber, <a href="/repair-or-replace" class="text-oak underline">read the repair-or-replace framework</a> first.
      </p>

      <h2 class="font-display text-2xl text-ink mb-4 mt-8 pb-2 border-b border-ink/10">Core Joinery &amp; Carpentry</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        {serviceCards.slice(0, 4).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Interiors</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        {serviceCards.slice(4, 9).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Structural, Roofing &amp; Exterior</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        {serviceCards.slice(9, 13).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="font-display text-2xl text-ink mb-4 pb-2 border-b border-ink/10">Heritage Repair &amp; Specialist Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {serviceCards.slice(13).map((s) => (
          <a href={s.href} class="service-card group relative">
            {s.image && (
              <img src={s.image} alt={s.alt} loading="lazy" width="600" height="192" class="service-card-image w-full object-cover" />
            )}
            <div class="service-card-content">
              <h3 class="font-display text-xl text-ink mb-3 group-hover:text-oak transition-colors">{s.title}</h3>
              <p class="text-ink/70 text-sm mb-4 leading-relaxed">{s.description}</p>
              <span class="mt-auto text-oak font-display text-xs">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
