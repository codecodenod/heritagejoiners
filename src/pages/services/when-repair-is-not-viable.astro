---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PhoneLink from '../../components/ui/PhoneLink.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { phone, url } = siteConfig;

const breadcrumbs = [
  { name: 'When Repair Is Not Viable', url: `${url}/services/when-repair-is-not-viable` },
];

const schemaProps = {
  description: 'Honest guidance on when original timber should be replaced rather than repaired, and how replacement is approached on listed and period buildings.',
  url: `${url}/services/when-repair-is-not-viable`,
  priceRange: '£££',
  serviceType: 'Timber replacement viability guidance',
  category: 'Heritage timber repair',
};

const replacementTriggers = [
  { title: 'Sound timber below threshold', body: 'Where the remaining sound timber is too low to support a load-bearing repair — typically under 50% of the original cross-section in a critical zone — a splice or scarf will not deliver durable structural function. Repair at any cost is not honest practice.' },
  { title: 'Failed previous repairs', body: 'Where epoxy consolidants or previous splices have already been attempted and failed, the underlying cause has not been resolved or the base timber was already too far gone. A second repair on the same element rarely gives better results.' },
  { title: 'Active moisture not controllable', body: 'Where the moisture source cannot be permanently resolved — a fundamentally damp site condition, a building detail that cannot be changed — the long-term outlook for any timber repair is poor. Replacement with more moisture-resistant materials may be the honest answer.' },
  { title: 'Profile loss too great to match', body: 'On carved, moulded, or highly detailed historic joinery, where the original profile is largely destroyed, accurate reproduction may serve the building better than a heavily compromised repair. Reproduction is not automatically wrong — it is wrong only when repair would have been viable.' },
  { title: 'Structural geometry compromised', body: 'Where a load-bearing member has deflected significantly, where joints have lost their seating, or where the geometry of a frame has shifted, repair to individual members may be insufficient. The structural engineer\'s view is required before timber-only repair proceeds.' },
];
---

<ServiceLayout
  title="When Timber Should Be Replaced, Not Repaired"
  description="Honest guidance on when original timber cannot be retained safely or economically, and what sympathetic replacement should look like."
  serviceName="When Repair Is Not Viable — Replacement Guidance"
  breadcrumbs={breadcrumbs}
  schemaProps={schemaProps}
>
  <section class="py-16 lg:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-oak uppercase tracking-wide mb-4">Honest replacement advice</p>
        <h1 class="font-display text-4xl lg:text-5xl text-ink mb-4">
          When We Recommend Replacement Instead of Repair
        </h1>
        <p class="text-lg text-ink/70 mb-8">
          Repair-first does not mean repair-at-any-cost. There are situations where the right advice for the building and the owner is replacement — and where recommending repair would be dishonest. This page sets out the thresholds we use and how we approach replacement when it is the correct answer.
        </p>
        <div class="flex flex-wrap gap-4">
          <WhatsAppCTA client:load />
          <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-8">When replacement is the right answer</h2>
      <div class="space-y-6">
        {replacementTriggers.map((trigger) => (
          <div class="p-6 bg-paper rounded-lg border border-ink/10">
            <h3 class="font-display text-xl text-ink mb-2">{trigger.title}</h3>
            <p class="text-ink/70">{trigger.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">How we approach replacement on listed buildings</h2>
        <p class="text-ink/70 mb-3">
          When replacement is the right answer, it needs to be done sympathetically. On listed and period properties this means: matching the original species where possible, matching section dimensions and profile exactly, using traditional jointing methods where structural, and finishing to complement the surrounding fabric rather than contrast with it.
        </p>
        <p class="text-ink/70">
          We do not default to standard off-the-shelf sections on listed buildings. If the original window cill was a particular moulded profile in pitch pine, the replacement should match it — not approximate it with a modern ogee section in imported softwood.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Consent before replacement work</h2>
        <p class="text-ink/70 mb-3">
          Replacement of original fabric in a listed building typically requires listed building consent. Carrying out replacement without consent is a criminal offence under the Planning (Listed Buildings and Conservation Areas) Act 1990. We will not proceed with replacement work on a listed building without confirming the consent position with the owner first.
        </p>
        <p class="text-ink/70">
          The consent process takes time — typically 8 weeks for a listed building consent application. Factoring this in before the project starts avoids delays once the work is ready to proceed.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Why we say this plainly</h2>
      <p class="text-ink/70 mb-4">
        A specialist who only ever recommends repair is not giving you an honest assessment — they are giving you the assessment that keeps them in work. Our framework identifies the point at which repair is no longer the right answer and we say so plainly when that point is reached.
      </p>
      <p class="text-ink/70 mb-6">
        Paradoxically, the willingness to recommend replacement when it is right is what makes every repair recommendation on this site credible. We recommend repair because it is genuinely viable, not because we always recommend repair.
      </p>
      <a href="/repair-or-replace" class="text-oak underline font-display">Read the full four-stage repair-or-replace framework &rarr;</a>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl lg:text-3xl text-ink mb-4">Related services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/repair-or-replace" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Repair or Replace? Framework</a>
        <a href="/services/structural-timber-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Structural Timber Repair</a>
        <a href="/services/oak-beam-repair" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Oak Beam Repair</a>
        <a href="/services/rot-and-splice" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Rot &amp; Splice Repair</a>
        <a href="/areas/yorkshire" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Yorkshire Coverage</a>
        <a href="/contact" class="p-5 bg-paper rounded-lg border border-ink/10 text-ink hover:border-oak transition-colors">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Unsure whether repair is viable?</h2>
      <p class="text-ink/70 mb-8 max-w-2xl mx-auto">Send photos. We will give you an honest first view. If repair is not viable, we will say so — along with what replacement should look like on that specific building.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <WhatsAppCTA client:load />
        <PhoneLink phone={phone.tel} display={phone.display} variant="secondary" />
      </div>
    </div>
  </section>
</ServiceLayout>
