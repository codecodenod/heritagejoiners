---
/**
 * Service schema
 */
import { siteConfig } from '../../config/site';

interface Props {
  name: string;
  description: string;
  url: string;
  image?: string;
  priceRange?: string;
  provider?: {
    name: string;
    url: string;
  };
  serviceType?: string;
  category?: string;
  areaServed?: Array<string | { '@type': string; name: string }>;
}

const props = Astro.props;
const { url, name: siteName } = siteConfig;

const providerName = props.provider?.name || siteName;
const providerUrl = props.provider?.url || url;
const areaServed = props.areaServed || siteConfig.serviceArea;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: props.name,
  description: props.description,
  url: props.url,
  image: props.image || `${url}/images/homepage/hero.webp`,
  serviceType: props.serviceType || props.name,
  ...(props.category ? { category: props.category } : {}),
  provider: {
    '@id': `${providerUrl}/#localbusiness`,
    '@type': 'LocalBusiness',
    name: providerName,
    url: providerUrl,
  },
  areaServed: areaServed.map((area) => (
    typeof area === 'string'
      ? {
          '@type': area === 'Yorkshire' || area === 'West Yorkshire' ? 'AdministrativeArea' : 'City',
          name: area,
        }
      : area
  )),
  priceRange: props.priceRange || '££',
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
