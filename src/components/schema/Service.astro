---
/**
 * Service schema
 */
import { siteConfig } from '../../config/site';

interface Props {
  name: string;
  description: string;
  url: string;
  image?: string;
  priceRange?: string;
  provider?: {
    name: string;
    url: string;
  };
}

const props = Astro.props;
const { url, name: siteName } = siteConfig;

const providerName = props.provider?.name || siteName;
const providerUrl = props.provider?.url || url;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: props.name,
  description: props.description,
  url: props.url,
  image: props.image || `${url}/images/services/default.jpg`,
  provider: {
    '@type': 'Organization',
    name: providerName,
    url: providerUrl,
  },
  areaServed: siteConfig.serviceArea,
  priceRange: props.priceRange || '££',
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />