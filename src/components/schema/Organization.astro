---
/**
 * Organization schema
 */
import { siteConfig } from '../../config/site';

interface Props {
  name?: string;
}

const { name: configName, url, telephone, social } = siteConfig;
const props = Astro.props;
const orgName = props.name || configName;

const sameAs = [social.facebook, social.linkedin, social.instagram].filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${url}/#organization`,
  name: orgName,
  url: url,
  logo: `${url}/heritage-joiners-hj-logo-180.webp`,
  telephone,
  ...(sameAs.length ? { sameAs } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
