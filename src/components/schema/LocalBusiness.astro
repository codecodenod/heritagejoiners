---
/**
 * LocalBusiness schema
 */
import { siteConfig } from '../../config/site';

interface Props {
  name?: string;
}

const { name, telephone, email, address, url, serviceArea, hours } = siteConfig;

const props = Astro.props;
const bizName = props.name || name;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${url}/#localbusiness`,
  name: bizName,
  telephone: telephone,
  email: email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: address.street,
    addressLocality: address.city,
    postalCode: address.postcode,
    addressRegion: 'England',
    addressCountry: 'GB',
  },
  areaServed: serviceArea,
  openingHoursSpecification: Object.entries(hours)
    .filter(([, value]) => value !== 'Closed')
    .map(([day, value]) => {
      const [opens, closes] = value.split(' - ');
      return {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: day.charAt(0).toUpperCase() + day.slice(1),
        opens,
        closes,
      };
    }),
  priceRange: '££',
  image: `${url}/images/homepage/hero.webp`,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
