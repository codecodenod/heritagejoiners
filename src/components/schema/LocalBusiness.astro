---
/**
 * LocalBusiness schema
 */
import { siteConfig } from '../../config/site';

interface Props {
  name?: string;
}

const { name, telephone, address, geo, url, serviceArea, hours, social } = siteConfig;

const props = Astro.props;
const bizName = props.name || name;
const sameAs = [social.facebook, social.linkedin, social.instagram].filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${url}/#localbusiness`,
  name: bizName,
  url,
  telephone: telephone,
  ...(sameAs.length ? { sameAs } : {}),
  logo: `${url}/heritage-joiners-hj-logo-180.webp`,
  address: {
    '@type': 'PostalAddress',
    ...(address.street ? { streetAddress: address.street } : {}),
    addressLocality: address.locality,
    addressRegion: address.region,
    addressCountry: 'GB',
    postalCode: address.postcode,
  },
  ...(geo.latitude && geo.longitude
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: geo.latitude,
          longitude: geo.longitude,
        },
      }
    : {}),
  areaServed: serviceArea.map((area) => ({
    '@type': area === 'Yorkshire' || area === 'West Yorkshire' ? 'AdministrativeArea' : 'City',
    name: area,
  })),
  openingHoursSpecification: Object.entries(hours)
    .filter(([, value]) => value !== 'Closed')
    .map(([day, value]) => {
      const [opens, closes] = value.split(' - ');
      return {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: day.charAt(0).toUpperCase() + day.slice(1),
        opens,
        closes,
      };
  }),
  priceRange: '££',
  image: `${url}/images/case-studies/counting-house-hero.webp`,
  parentOrganization: {
    '@id': `${url}/#organization`,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
