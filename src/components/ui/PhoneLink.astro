---
/**
 * PhoneLink - tel: link with click tracking
 */
import { siteConfig } from '../../config/site';

interface Props {
  phone: string;
  display?: string;
  variant?: 'default' | 'primary' | 'secondary';
  class?: string;
}

const { phone, display, variant = 'default', class: className } = Astro.props;

// Variant styles
const variantStyles = {
  default: 'text-ink hover:text-oak transition-colors',
  primary: 'inline-flex items-center justify-center px-6 py-3 bg-ink text-bone font-display rounded-md hover:bg-oak transition-colors',
  secondary: 'inline-flex items-center justify-center px-6 py-3 bg-bone text-ink font-display border border-ink rounded-md hover:bg-paper transition-colors',
};

const combinedStyles = variantStyles[variant];

// Format display phone
const displayPhone = display || (phone ? phone.replace('+44', '0').replace(/^44/, '0') : 'Phone pending');
const href = phone ? `tel:${phone}` : '/contact';
---

<a
  href={href}
  class:list={[combinedStyles, className]}
  data-plausible-event="phone-click"
>
  <slot>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 mr-2"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.776 21 3 14.224 3 7V5z"
      />
    </svg>
    <span>{displayPhone}</span>
  </slot>
</a>
