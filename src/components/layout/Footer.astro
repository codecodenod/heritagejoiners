---
/**
 * Footer - site footer
 */
import PhoneLink from '../ui/PhoneLink.astro';
import WhatsAppCTA from '../ui/WhatsAppCTA';
import { siteConfig } from '../../config/site';

const { name, phone, whatsapp, address, email, serviceArea, hours, social } = siteConfig;
const currentYear = new Date().getFullYear();

const primaryLinks = [
  { href: '/services', label: 'Services' },
  { href: '/repair-or-replace', label: 'Repair or Replace?' },
  { href: '/about', label: 'About' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/contact', label: 'Contact' },
];

const serviceLinks = [
  { href: '/services/sash-window-repair', label: 'Sash Window Repair' },
  { href: '/services/timber-window-repair', label: 'Timber Window Repair' },
  { href: '/services/doors-and-frames', label: 'Doors & Frames' },
  { href: '/services/rot-and-splice', label: 'Rot & Splice Repair' },
  { href: '/services/structural-timber-repair', label: 'Structural Timber Repair' },
  { href: '/services/oak-beam-repair', label: 'Oak Beam Repair' },
  { href: '/services/roof-timber-repair', label: 'Roof Timber Repair' },
  { href: '/services/floor-joist-and-floorboard-repair', label: 'Floor Joist Repair' },
  { href: '/services/timber-frame-repair', label: 'Timber Frame Repair' },
  { href: '/services/heritage-wall-panelling-repair', label: 'Wall Panelling Repair' },
  { href: '/services/timber-colour-matching-and-finishing', label: 'Colour Matching & Finishing' },
  { href: '/services/listed-and-period-property-repairs', label: 'Listed & Period Repairs' },
  { href: '/services/when-repair-is-not-viable', label: 'When Repair Is Not Viable' },
];

const areaLinks = [
  { href: '/areas/pontefract', label: 'Pontefract' },
  { href: '/areas/wakefield', label: 'Wakefield' },
  { href: '/areas/castleford', label: 'Castleford' },
  { href: '/areas/featherstone', label: 'Featherstone' },
  { href: '/areas/knottingley', label: 'Knottingley' },
  { href: '/areas/normanton', label: 'Normanton' },
  { href: '/areas/leeds', label: 'Leeds' },
  { href: '/areas/yorkshire', label: 'Yorkshire' },
];
---

<footer class="bg-ink text-bone mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <!-- Main footer grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand + contact -->
      <div class="lg:col-span-1">
        <p class="font-display text-2xl text-bone mb-4">{name}</p>

        <p class="text-bone/70 mb-6 text-sm">
          Repair-first timber specialists for listed and period buildings across Pontefract, Wakefield, and Yorkshire.
        </p>

        <div class="space-y-2 text-bone/80 text-sm">
          <p>{address.full || 'Address pending'}</p>
          <p>
            <PhoneLink
              phone={phone.tel}
              display={phone.display}
              class="text-brass hover:text-bone"
            />
          </p>
          <p>
            {email ? (
              <a href={`mailto:${email}`} class="text-brass hover:text-bone transition-colors">
                {email}
              </a>
            ) : (
              <span>Email pending</span>
            )}
          </p>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-display text-lg text-bone mb-4">Navigation</h3>
        <ul class="space-y-2">
          {primaryLinks.map((link) => (
            <li>
              <a href={link.href} class="text-bone/70 hover:text-brass transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <h3 class="font-display text-lg text-bone mt-8 mb-4">Areas</h3>
        <ul class="space-y-2">
          {areaLinks.map((link) => (
            <li>
              <a href={link.href} class="text-bone/70 hover:text-brass transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services (split into two columns) -->
      <div class="lg:col-span-2">
        <h3 class="font-display text-lg text-bone mb-4">Services</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-bone/70 hover:text-brass transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-bone/20">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="text-bone/50 text-sm">
          <p>&copy; {currentYear} {name}. All rights reserved.</p>
          <p class="mt-1">
            Registered in England. VAT {siteConfig.company.vatNumber || 'pending'}.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
