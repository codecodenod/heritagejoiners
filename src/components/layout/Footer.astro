---
/**
 * Footer - site footer
 */
import PhoneLink from '../ui/PhoneLink.astro';
import WhatsAppCTA from '../ui/WhatsAppCTA.astro';
import EmailLink from '../ui/EmailLink.astro';
import { siteConfig } from '../../config/site';

const { name, phone, whatsapp, address, serviceArea, hours, social } = siteConfig;
const currentYear = new Date().getFullYear();

const primaryLinks = [
  { href: '/services', label: 'Services' },
  { href: '/guides', label: 'Guides' },
  { href: '/repair-or-replace', label: 'Repair or Replace?' },
  { href: '/about', label: 'About' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/contact', label: 'Contact' },
  { href: '/sitemap', label: 'Site Map' },
];

const serviceLinks = [
  { href: '/services/doors', label: 'Doors' },
  { href: '/services/windows', label: 'Windows' },
  { href: '/services/staircases', label: 'Staircases' },
  { href: '/services/kitchens', label: 'Kitchens' },
  { href: '/services/skirting-architrave', label: 'Skirting & Architrave' },
  { href: '/services/flooring', label: 'Flooring' },
  { href: '/services/first-fix-carpentry', label: 'First Fix Carpentry' },
  { href: '/services/second-fix-carpentry', label: 'Second Fix Carpentry' },
  { href: '/services/roofing-carpentry', label: 'Roofing & Roof Carpentry' },
  { href: '/services/extensions-conversions', label: 'Extensions & Conversions' },
  { href: '/services/bespoke-joinery', label: 'Bespoke Joinery' },
  { href: '/services/outdoor-carpentry', label: 'Outdoor Carpentry' },
  { href: '/services/cladding-panelling', label: 'Cladding & Panelling' },
  { href: '/services/timber-repair', label: 'Timber Repair & Restoration' },
  { href: '/services/woodworm-treatment', label: 'Woodworm Treatment' },
  { href: '/services/finishing', label: 'Finishing' },
  { href: '/services/timber-hardwoods', label: 'Timber & Hardwoods' },
  { href: '/services/maintenance-repairs', label: 'Maintenance & Repairs' },
];

const areaLinks = [
  { href: '/areas/pontefract', label: 'Pontefract' },
  { href: '/areas/wakefield', label: 'Wakefield' },
  { href: '/areas/castleford', label: 'Castleford' },
  { href: '/areas/featherstone', label: 'Featherstone' },
  { href: '/areas/knottingley', label: 'Knottingley' },
  { href: '/areas/normanton', label: 'Normanton' },
  { href: '/areas/leeds', label: 'Leeds' },
  { href: '/areas/yorkshire', label: 'Yorkshire' },
];
---

<footer class="bg-ink text-bone mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <!-- Main footer grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand + contact -->
      <div class="lg:col-span-1">
        <p class="font-display text-2xl text-bone mb-4">{name}</p>

        <p class="text-bone/70 mb-6 text-sm">
          Carpentry & joinery across Pontefract, Wakefield, and Yorkshire - from kitchens, stairs and doors to period timber repair.
        </p>

        <div class="space-y-2 text-bone/80 text-sm">
          <p>{address.full || 'Address pending'}</p>
          <p>
            <PhoneLink
              phone={phone.tel}
              display={phone.display}
              class="text-brass hover:text-bone"
            />
          </p>
          <p>
            <EmailLink label="Email Rob" class="text-brass hover:text-bone transition-colors" />
          </p>
          {social.facebook && (
            <p>
              <a
                href={social.facebook}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center text-brass hover:text-bone transition-colors"
                aria-label="Heritage Joiners on Facebook"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
                Facebook
              </a>
            </p>
          )}
        </div>
      </div>

      <!-- Navigation + Areas.
           `sm:contents` dissolves this wrapper from 640px up, so Navigation and
           Areas become their own grid columns instead of stacking 15 links deep.
           Below 640px the wrapper behaves normally and they stay stacked. -->
      <div class="sm:contents">
        <div>
          <h3 class="font-display text-lg text-bone mb-4">Navigation</h3>
          <ul class="space-y-2">
            {primaryLinks.map((link) => (
              <li>
                <a href={link.href} class="text-bone/70 hover:text-brass transition-colors text-sm">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="font-display text-lg text-bone mt-8 sm:mt-0 mb-4">Areas</h3>
          <ul class="space-y-2">
            {areaLinks.map((link) => (
              <li>
                <a href={link.href} class="text-bone/70 hover:text-brass transition-colors text-sm">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Services (split into two columns) -->
      <div class="md:col-span-3 lg:col-span-2">
        <h3 class="font-display text-lg text-bone mb-4">Services</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-2 gap-x-6 gap-y-2">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-bone/70 hover:text-brass transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-bone/20">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="text-bone/50 text-sm">
          <p>&copy; {currentYear} {name}. All rights reserved.</p>
        </div>
      </div>
    </div>
  </div>
</footer>
