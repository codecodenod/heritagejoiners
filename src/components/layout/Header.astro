---
/**
 * Header - site header with logo and nav
 */
import Nav from './Nav.astro';
import PhoneLink from '../ui/PhoneLink.astro';
import { siteConfig } from '../../config/site';

const { phone } = siteConfig;
---

<header class="sticky top-0 z-50 bg-bone/95 backdrop-blur-sm border-b border-ink/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-1 sm:py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 sm:gap-3" aria-label="Heritage Joiners - Home">
        <img
          src="/heritage-joiners-hj-logo-180.webp"
          alt="HJ emblem"
          width="180"
          height="177"
          class="h-10 sm:h-16 lg:h-20 w-auto"
        />
        <div class="flex flex-col">
          <span style="font-family: 'Libre Baskerville', Georgia, serif; font-weight: 400;" class="text-xs sm:text-xl lg:text-2xl text-ink tracking-wider uppercase whitespace-nowrap">Heritage Joiners</span>
          <span style="font-family: 'Libre Baskerville', Georgia, serif; font-weight: 400;" class="text-[10px] tracking-widest text-oak uppercase whitespace-nowrap hidden sm:block">Specialist Joinery &middot; Period Restoration &middot; Fine Craftsmanship</span>
        </div>
      </a>

      <!-- Desktop nav + phone -->
      <div class="hidden xl:flex items-center gap-4 xl:gap-6">
        <Nav />
        <PhoneLink
          phone={phone.tel}
          display={phone.display}
          variant="secondary"
        />
      </div>

      <!-- Mobile menu button -->
      <button
        class="xl:hidden p-2 text-ink -mr-5"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-open"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav panel — MUST be outside <header> so backdrop-filter doesn't trap fixed positioning -->
<div
  id="mobile-menu"
  class="xl:hidden hidden fixed inset-0 z-[9999] mobile-nav-panel"
>
  <div class="flex flex-col h-full p-6 relative" style="z-index:1">
    <div class="flex items-center justify-between mb-6">
      <a href="/">
        <img
          src="/heritage-joiners-hj-logo-180.webp"
          alt="Heritage Joiners"
          width="180"
          height="177"
          loading="lazy"
          class="h-16 w-auto"
        />
      </a>
      <button
        class="p-2 text-ink"
        aria-label="Close menu"
        id="mobile-menu-close"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>
    <div class="h-px bg-gradient-to-r from-transparent via-oak/40 to-transparent mb-6"></div>
    <Nav mobile />
    <div class="mt-auto pb-8">
      <PhoneLink
        phone={phone.tel}
        display={phone.display}
        variant="primary"
        class="w-full justify-center"
      />
    </div>
  </div>
</div>

<script>
  const mobileMenuOpen = document.getElementById('mobile-menu-open');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    mobileMenuOpen?.setAttribute('aria-expanded', 'true');
    mobileMenuClose?.focus();
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
    mobileMenuOpen?.setAttribute('aria-expanded', 'false');
    mobileMenuOpen?.focus();
  }

  mobileMenuOpen?.addEventListener('click', openMenu);
  mobileMenuClose?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      closeMenu();
    }
  });

  window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
    if (event.matches && !mobileMenu?.classList.contains('hidden')) {
      closeMenu();
    }
  });
</script>
