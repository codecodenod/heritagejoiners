# Cloudflare Cache Rules

/images/*:
  Cache-Control: public, max-age=31536000, immutable

/fonts/*:
  Cache-Control: public, max-age=31536000, immutable

/_astro/*:
  Cache-Control: public, max-age=31536000, immutable

/*.html:
  Cache-Control: no-store, no-cache

/:
  Cache-Control: no-store, no-cache

/sitemap*.xml:
  Cache-Control: public, max-age=3600