# Cloudflare Cache Rules
# Cache static assets for 1 year

/images/*:
  Cache-Tag: images
  Cache-Control: public, max-age=31536000

/fonts/*:
  Cache-Tag: fonts
  Cache-Control: public, max-age=31536000

/_astro/*:
  Cache-Tag: astro
  Cache-Control: public, max-age=31536000

# HTML - no cache (always fresh)
*.html:
  Cache-Control: no-cache

# JSON/XML - short cache
/sitemap*.xml:
  Cache-Control: public, max-age=3600